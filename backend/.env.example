# Server Configuration
PORT=4000
NODE_ENV=development

# Database Configuration (PostgreSQL Development DB)
DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/footballtray?schema=public

# Dedicated Test Database (Automated tests strictly use this; isolated from development)
DATABASE_URL_TEST=postgresql://postgres:your_password_here@localhost:5432/footballtray_test?schema=public

# External Football Data Provider (API-Football)
API_FOOTBALL_KEY=your_api_key_here
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io

# Polling & Rate Limiting
POLLING_INTERVAL_LIVE_SECONDS=60
POLLING_INTERVAL_SCHEDULED_HOURS=6
