# Server Configuration
PORT=4000
NODE_ENV=development

# Database Configuration (PostgreSQL Development DB)
DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/footballtray?schema=public

# Dedicated Test Database (Automated tests strictly use this; isolated from development)
DATABASE_URL_TEST=postgresql://postgres:your_password_here@localhost:5432/footballtray_test?schema=public

# Provider Selection
# Controls which football data provider is used by the sync pipeline.
# Supported values: mock | api_football
# Default: mock (safe for development and CI — no network requests, no API key needed)
ACTIVE_PROVIDER=mock

# Target Competition IDs (provider-level numeric IDs, NOT internal comp_* identifiers)
# Comma-separated list of API-Football league IDs to synchronize.
# Used when ACTIVE_PROVIDER=api_football to restrict which leagues are fetched.
# Leave empty or absent to fetch all competitions available from the provider
# (WARNING: this will consume quota rapidly — always set this in production).
# Example (Premier League, La Liga, Bundesliga, UEFA CL, UEFA EL, World Cup):
TARGET_COMPETITION_IDS=39,140,233,2,6,1

# External Football Data Provider (API-Football)
# Obtain a key at: https://www.api-football.com/
API_FOOTBALL_KEY=
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
# Safety gate: must be explicitly set to "true" before any real API-Football requests are made.
# Keep this "false" in development to prevent accidental quota consumption.
ALLOW_LIVE_PROVIDER_REQUESTS=false

# Polling & Rate Limiting
POLLING_INTERVAL_LIVE_SECONDS=60
POLLING_INTERVAL_SCHEDULED_HOURS=6
