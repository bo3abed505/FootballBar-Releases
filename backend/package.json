{
  "name": "footballtray-backend",
  "version": "1.1.0",
  "description": "FootballTray backend data ingestion and normalized API service",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "test": "vitest run --fileParallelism=false",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:prod": "node dist/db/migrate-prod.js",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx src/db/seed.ts",
    "db:test:setup": "tsx src/db/setup-test-db.ts",
    "dev:sync": "tsx src/acquisition/cli-sync.ts",
    "dev:sync:goal": "tsx src/acquisition/cli-sync.ts --simulate-goal",
    "dev:sync:reset": "tsx src/acquisition/cli-sync.ts --reset",
    "provider:check": "tsx src/acquisition/cli-provider-check.ts",
    "simulate:match": "tsx scripts/simulate-match.ts",
    "sync:live": "tsx src/acquisition/cli-sync.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/etag": "^6.0.2",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.39.3",
    "fastify": "^5.2.1",
    "pg": "^8.13.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.13.8",
    "@types/pg": "^8.11.11",
    "drizzle-kit": "^0.30.5",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  },
  "keywords": [
    "football",
    "taskbar",
    "api-football",
    "fastify",
    "drizzle"
  ],
  "author": "",
  "license": "MIT"
}
