# ==============================================================================
# FootballTray Backend — Production Environment Configuration Template
# ==============================================================================
# Copy this file to .env on the production backend host and populate the values.
# NEVER commit the actual .env file or production credentials to source control.
# ==============================================================================

# Server Configuration
PORT=4000
NODE_ENV=production

# Database Configuration (Production PostgreSQL)
# Replace placeholders with your production database credentials.
DATABASE_URL=postgresql://footballtray_user:SECURE_DB_PASSWORD@localhost:5432/footballtray?schema=public

# Provider Selection
# Supported values: mock | api_football
# For production live data, set to "api_football".
ACTIVE_PROVIDER=api_football

# Target Competition IDs (provider-level numeric IDs for API-Football)
# Restricts data synchronization to specific competitions to preserve API quota.
# Canonical competitions:
#   39  = Premier League
#   140 = La Liga
#   233 = Egyptian Premier League
#   2   = UEFA Champions League
#   6   = CAF Africa Cup of Nations
#   1   = FIFA World Cup
TARGET_COMPETITION_IDS=39,140,233,2,6,1

# External Football Data Provider (API-Football)
# Obtain your production API key from: https://www.api-football.com/
API_FOOTBALL_KEY=YOUR_PRODUCTION_API_FOOTBALL_KEY_HERE
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io

# Live Provider Safety Gate
# In production, set to "true" ONLY after valid API key and DB credentials are configured.
# If "false", the server runs in safe offline/mock mode without making external requests.
ALLOW_LIVE_PROVIDER_REQUESTS=false

# Acquisition Scheduler Polling Intervals
# Polling interval in seconds when at least one followed fixture is currently LIVE.
POLLING_INTERVAL_LIVE_SECONDS=60
# Polling interval in hours for scheduled/prematch fixture discovery.
POLLING_INTERVAL_SCHEDULED_HOURS=6
