<Page
    x:Class="FootballTray.Client.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:FootballTray.Client.ViewModels"
    mc:Ignorable="d">

    <Page.Resources>
        <DataTemplate x:Key="MatchCardTemplate" x:DataType="vm:MatchItemViewModel">
            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14"
                Margin="0,0,0,8"
                Tag="{x:Bind}"
                Tapped="OnMatchCardTapped"
                IsHitTestVisible="True">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Top Row: Competition, Follow Competition Star, State Badge, Taskbar Indicator -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <!-- Competition Follow Star Toggle Button -->
                            <Button
                                x:Name="FollowCompetitionButton"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="2"
                                MinHeight="0"
                                MinWidth="0"
                                Tag="{x:Bind}"
                                Click="OnToggleFollowCompetitionClicked"
                                ToolTipService.ToolTip="Toggle follow competition">
                                <FontIcon
                                    Glyph="{x:Bind CompetitionStarGlyph, Mode=OneWay}"
                                    FontSize="12"
                                    Foreground="{ThemeResource SystemFillColorAttentionBrush}"
                                    Opacity="{x:Bind CompetitionStarOpacity, Mode=OneWay}" />
                            </Button>
                            <TextBlock
                                Text="{x:Bind CompetitionName}"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                VerticalAlignment="Center" />
                            <TextBlock
                                Text="•"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                VerticalAlignment="Center" />
                            <TextBlock
                                Text="{x:Bind KickoffDisplay}"
                                FontSize="11"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                            <!-- Universal Persistent Taskbar Pin Toggle Button -->
                            <Button
                                x:Name="PinMatchButton"
                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="6,2,6,2"
                                MinHeight="0"
                                MinWidth="0"
                                Tag="{x:Bind}"
                                Click="OnTogglePinClicked"
                                Opacity="{x:Bind PinButtonOpacity, Mode=OneWay}"
                                ToolTipService.ToolTip="{x:Bind PinToolTipText, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <FontIcon
                                        Glyph="{x:Bind PinGlyph, Mode=OneWay}"
                                        FontSize="11"
                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock
                                        Text="{x:Bind PinText, Mode=OneWay}"
                                        FontSize="10"
                                        FontWeight="Bold"
                                        Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                </StackPanel>
                            </Button>

                            <!-- State Badge: Red LIVE Badge -->
                            <Border
                                Background="#D13438"
                                CornerRadius="4"
                                Padding="6,2,6,2"
                                Visibility="{x:Bind IsLiveBadgeVisible, Mode=OneWay}">
                                <TextBlock
                                    Text="{x:Bind StateDisplay}"
                                    FontSize="11"
                                    FontWeight="Bold"
                                    Foreground="White" />
                            </Border>

                            <!-- State Badge: Standard / Prematch / Finished Badge -->
                            <Border
                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                CornerRadius="4"
                                Padding="6,2,6,2"
                                Visibility="{x:Bind IsNormalBadgeVisible, Mode=OneWay}">
                                <TextBlock
                                    Text="{x:Bind StateDisplay}"
                                    FontSize="11"
                                    FontWeight="Bold"
                                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Scoreboard Grid -->
                    <Grid Grid.Row="1" ColumnSpacing="12" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Home Team with Follow Star -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button
                                x:Name="FollowHomeTeamButton"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="2"
                                MinHeight="0"
                                MinWidth="0"
                                Tag="{x:Bind}"
                                Click="OnToggleFollowHomeTeamClicked"
                                ToolTipService.ToolTip="Toggle follow home team">
                                <FontIcon
                                    Glyph="{x:Bind HomeStarGlyph, Mode=OneWay}"
                                    FontSize="12"
                                    Foreground="{ThemeResource SystemFillColorAttentionBrush}"
                                    Opacity="{x:Bind HomeStarOpacity, Mode=OneWay}" />
                            </Button>
                            <TextBlock
                                Text="{x:Bind HomeTeamName}"
                                FontSize="15"
                                FontWeight="Bold"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <!-- Score -->
                        <Border
                            Grid.Column="1"
                            Background="{ThemeResource SystemFillColorNeutralBackgroundBrush}"
                            CornerRadius="6"
                            Padding="12,4,12,4"
                            HorizontalAlignment="Center">
                            <TextBlock
                                Text="{x:Bind ScoreDisplay}"
                                FontSize="18"
                                FontWeight="Bold"
                                HorizontalAlignment="Center" />
                        </Border>

                        <!-- Away Team with Follow Star -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <TextBlock
                                Text="{x:Bind AwayTeamName}"
                                FontSize="15"
                                FontWeight="Bold"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                TextTrimming="CharacterEllipsis" />
                            <Button
                                x:Name="FollowAwayTeamButton"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="2"
                                MinHeight="0"
                                MinWidth="0"
                                Tag="{x:Bind}"
                                Click="OnToggleFollowAwayTeamClicked"
                                ToolTipService.ToolTip="Toggle follow away team">
                                <FontIcon
                                    Glyph="{x:Bind AwayStarGlyph, Mode=OneWay}"
                                    FontSize="12"
                                    Foreground="{ThemeResource SystemFillColorAttentionBrush}"
                                    Opacity="{x:Bind AwayStarOpacity, Mode=OneWay}" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Bottom Row: Relevance Reasoning (if relevant) -->
                    <StackPanel
                        Grid.Row="2"
                        Orientation="Horizontal"
                        Spacing="6"
                        Visibility="{x:Bind IsRelevant, Mode=OneWay}">
                        <Border
                            Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}"
                            CornerRadius="4"
                            Padding="6,2,6,2">
                            <TextBlock
                                Text="⭐ Followed"
                                FontSize="10"
                                FontWeight="Bold"
                                Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        </Border>
                        <TextBlock
                            Text="{x:Bind RelevanceDisplay, Mode=OneWay}"
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            VerticalAlignment="Center"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="20" RowSpacing="12">
        <Grid.RowDefinitions>
            <!-- Top Header & Status Bar -->
            <RowDefinition Height="Auto" />
            <!-- Main Content Area: Matches (Left) + Preferences (Right) -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Header & Status Bar -->
        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- App Title & Ticker Summary -->
            <StackPanel Grid.Column="0" Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock
                        Text="FootballTray"
                        Style="{ThemeResource TitleTextBlockStyle}"
                        FontSize="22"
                        FontWeight="Bold" />
                    <!-- Connection / Freshness Badge -->
                    <Border
                        x:Name="ConnectionBadge"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="10,3,10,3"
                        VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Ellipse
                                x:Name="ConnectionDot"
                                Width="8"
                                Height="8"
                                Fill="{ThemeResource SystemFillColorSuccessBrush}" />
                            <TextBlock
                                x:Name="ConnectionStatusText"
                                Text="Online (Live)"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                
                <!-- Active Taskbar Summary -->
                <TextBlock
                    x:Name="ActiveTickerSummaryText"
                    Text="📌 Taskbar Active: Loading..."
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- Status / Error InfoBar & Settings Button -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <InfoBar
                    x:Name="StatusInfoBar"
                    IsOpen="False"
                    Severity="Warning"
                    IsClosable="True"
                    VerticalAlignment="Center" />

                <Button
                    x:Name="OpenSettingsButton"
                    Content="&#xE713;"
                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                    FontSize="16"
                    Padding="8"
                    ToolTipService.ToolTip="Settings &amp; Preferences"
                    Click="OnOpenSettingsClicked" />
            </StackPanel>
        </Grid>

        <!-- Main Content Area -->
        <Grid Grid.Row="1" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <!-- Left: Match Discovery (60%) -->
                <ColumnDefinition Width="3*" MinWidth="340" />
                <!-- Right: Preferences & Settings (40%) -->
                <ColumnDefinition Width="2*" MinWidth="320" MaxWidth="440" />
            </Grid.ColumnDefinitions>

            <!-- ======================================================== -->
            <!-- SECTION A: MATCH DISCOVERY                               -->
            <!-- ======================================================== -->
            <Border
                Grid.Column="0"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <!-- Row 0: Filter Bar -->
                        <RowDefinition Height="Auto" />
                        <!-- Row 1: 7-Day Calendar Navigation Bar -->
                        <RowDefinition Height="Auto" />
                        <!-- Row 2: Match List / Empty State -->
                        <RowDefinition Height="*" />
                        <!-- Row 3: Footer Schedule Sync Info -->
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Filter Bar -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            Text="Matches"
                            Style="{ThemeResource SubtitleTextBlockStyle}"
                            FontWeight="SemiBold"
                            VerticalAlignment="Center"
                            Margin="0,0,16,0" />

                        <!-- Filter Segmented Chips -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                            <Button x:Name="FilterAllButton" Content="All" Click="OnFilterAllClick" Style="{ThemeResource AccentButtonStyle}" Padding="12,4,12,4" />
                            <Button x:Name="FilterFollowingButton" Content="⭐ Following" Click="OnFilterFollowingClick" Padding="12,4,12,4" />
                            <Button x:Name="FilterLiveButton" Content="🔴 Live" Click="OnFilterLiveClick" Padding="12,4,12,4" />
                            <Button x:Name="FilterUpcomingButton" Content="Upcoming" Click="OnFilterUpcomingClick" Padding="12,4,12,4" />
                            <Button x:Name="FilterFinishedButton" Content="Finished" Click="OnFilterFinishedClick" Padding="12,4,12,4" />
                        </StackPanel>
                    </Grid>

                    <!-- 7-Day Calendar Navigation Bar -->
                    <ScrollViewer
                        x:Name="CalendarScrollViewer"
                        Grid.Row="1"
                        Visibility="{x:Bind ViewModel.IsCalendarVisible, Mode=OneWay}"
                        HorizontalAlignment="Center"
                        HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Disabled"
                        HorizontalScrollMode="Enabled"
                        VerticalScrollMode="Disabled">
                        <ItemsControl x:Name="CalendarDaysList" HorizontalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:CalendarDayItemViewModel">
                                    <Button
                                        Click="OnCalendarDayClicked"
                                        Tag="{x:Bind}"
                                        Style="{x:Bind ButtonStyle, Mode=OneWay}"
                                        Padding="8,6,8,6"
                                        Margin="0,0,4,0"
                                        CornerRadius="8"
                                        MinWidth="68"
                                        HorizontalAlignment="Center"
                                        HorizontalContentAlignment="Center">
                                        <StackPanel Spacing="2" HorizontalAlignment="Center">
                                            <!-- Today Pill Badge -->
                                            <Border
                                                Visibility="{x:Bind IsToday, Mode=OneWay}"
                                                Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}"
                                                CornerRadius="4"
                                                Padding="4,1,4,1"
                                                HorizontalAlignment="Center">
                                                <TextBlock
                                                    Text="TODAY"
                                                    FontSize="9"
                                                    FontWeight="Bold"
                                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                    HorizontalAlignment="Center" />
                                            </Border>

                                            <!-- Relative Day Label (Yesterday, Tomorrow, Wed, etc.) -->
                                            <TextBlock
                                                Visibility="{x:Bind IsNotToday, Mode=OneWay}"
                                                Text="{x:Bind RelativeLabel, Mode=OneWay}"
                                                FontSize="11"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                HorizontalAlignment="Center" />

                                            <!-- Date Display (Sep 29) -->
                                            <TextBlock
                                                Text="{x:Bind DateDisplay, Mode=OneWay}"
                                                FontSize="13"
                                                FontWeight="Bold"
                                                HorizontalAlignment="Center" />

                                            <!-- Match Count Text -->
                                            <TextBlock
                                                Visibility="{x:Bind HasMatches, Mode=OneWay}"
                                                Text="{x:Bind MatchCountText, Mode=OneWay}"
                                                FontSize="10"
                                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Match Cards List View -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="10">
                            <!-- Followed Matches Container -->
                            <ItemsControl
                                x:Name="FollowedMatchesList"
                                ItemTemplate="{StaticResource MatchCardTemplate}" />

                            <!-- Collapsible Other Matches Section -->
                            <Expander
                                x:Name="OtherMatchesExpander"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Header="{x:Bind ViewModel.OtherMatchesHeader, Mode=OneWay}"
                                IsExpanded="{x:Bind ViewModel.IsOtherMatchesExpanded, Mode=TwoWay}"
                                Visibility="{x:Bind ViewModel.IsOtherMatchesVisible, Mode=OneWay}">
                                <Expander.Content>
                                    <ItemsControl
                                        x:Name="OtherMatchesList"
                                        ItemTemplate="{StaticResource MatchCardTemplate}"
                                        Margin="0,8,0,0" />
                                </Expander.Content>
                            </Expander>

                            <!-- Empty State Card -->
                            <Border
                                x:Name="EmptyStateBorder"
                                Visibility="Collapsed"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="32"
                                HorizontalAlignment="Stretch">
                                <StackPanel Spacing="10" HorizontalAlignment="Center">
                                    <FontIcon
                                        Glyph="&#xE9CE;"
                                        FontSize="36"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        HorizontalAlignment="Center" />
                                    <TextBlock
                                        x:Name="EmptyStateTitleText"
                                        Text="No Matches Available"
                                        FontSize="16"
                                        FontWeight="SemiBold"
                                        HorizontalAlignment="Center" />
                                    <TextBlock
                                        x:Name="EmptyStateSubtitleText"
                                        Text="Waiting for synchronized match data..."
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        HorizontalAlignment="Center"
                                        TextAlignment="Center"
                                        MaxWidth="340"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Footer Info Text: Dynamic Synchronization Status -->
                    <Border
                        Grid.Row="3"
                        Margin="0,4,0,0"
                        Padding="4,8,4,0"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="0,1,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" Opacity="0.75">
                            <FontIcon
                                x:Name="SyncStatusIcon"
                                Glyph="{x:Bind ViewModel.SyncIconGlyph, Mode=OneWay}"
                                FontSize="11"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                VerticalAlignment="Center" />
                            <TextBlock
                                x:Name="SyncStatusTextBlock"
                                Text="{x:Bind ViewModel.SyncStatusText, Mode=OneWay}"
                                FontSize="11"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ======================================================== -->
            <!-- SECTION B, C, D: PREFERENCES & NOTIFICATION CONTROLS      -->
            <!-- ======================================================== -->
            <Border
                Grid.Column="1"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="18">

                        <!-- Search Header -->
                        <TextBlock
                            Text="Search &amp; Follow"
                            Style="{ThemeResource SubtitleTextBlockStyle}"
                            FontWeight="SemiBold" />

                        <!-- ======================================================== -->
                        <!-- SECTION B: CATALOG SEARCH & DISCOVERY                    -->
                        <!-- ======================================================== -->
                        <Border
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12">
                            <StackPanel Spacing="10">
                                <TextBlock
                                    Text="Search Catalog"
                                    FontWeight="SemiBold"
                                    FontSize="14" />
                                <TextBlock
                                    Text="Search the local database to follow clubs and competitions."
                                    FontSize="11"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap" />

                                <TextBox
                                    x:Name="CatalogSearchTextBox"
                                    PlaceholderText="Search clubs or leagues..."
                                    TextChanged="OnCatalogSearchTextChanged" />

                                <StackPanel Orientation="Horizontal" Spacing="16">
                                    <RadioButton
                                        x:Name="ScopeClubsRadio"
                                        Content="Clubs"
                                        IsChecked="True"
                                        Checked="OnSearchScopeChanged" />
                                    <RadioButton
                                        x:Name="ScopeLeaguesRadio"
                                        Content="Leagues &amp; Cups"
                                        Checked="OnSearchScopeChanged" />
                                </StackPanel>

                                <ProgressBar
                                    x:Name="CatalogSearchProgressBar"
                                    IsIndeterminate="True"
                                    Visibility="Collapsed"
                                    Height="2" />

                                <TextBlock
                                    x:Name="CatalogSearchStatusText"
                                    FontSize="11"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Visibility="Collapsed"
                                    TextWrapping="Wrap" />

                                <!-- Team Search Results -->
                                <ListView
                                    x:Name="TeamSearchResultsList"
                                    SelectionMode="None"
                                    MaxHeight="200"
                                    Visibility="Collapsed">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="vm:FollowedTeamItemViewModel">
                                            <Grid Padding="4,4,4,4" ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Image
                                                    Grid.Column="0"
                                                    Width="24"
                                                    Height="24"
                                                    VerticalAlignment="Center">
                                                    <Image.Source>
                                                        <BitmapImage UriSource="{x:Bind CachedLogoUri, Mode=OneWay}" />
                                                    </Image.Source>
                                                </Image>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock
                                                        Text="{x:Bind Name}"
                                                        FontWeight="SemiBold"
                                                        FontSize="13" />
                                                    <TextBlock
                                                        Text="{x:Bind Country}"
                                                        FontSize="11"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                                <Button
                                                    Grid.Column="2"
                                                    Content="{x:Bind FollowButtonText, Mode=OneWay}"
                                                    IsEnabled="{x:Bind CanFollow, Mode=OneWay}"
                                                    Tag="{x:Bind}"
                                                    Click="OnAddTeamClicked"
                                                    MinWidth="0"
                                                    Padding="8,4" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>

                                <!-- Competition Search Results -->
                                <ListView
                                    x:Name="CompetitionSearchResultsList"
                                    SelectionMode="None"
                                    MaxHeight="200"
                                    Visibility="Collapsed">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="vm:FollowedCompetitionItemViewModel">
                                            <Grid Padding="4,4,4,4" ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Image
                                                    Grid.Column="0"
                                                    Width="24"
                                                    Height="24"
                                                    VerticalAlignment="Center">
                                                    <Image.Source>
                                                        <BitmapImage UriSource="{x:Bind CachedLogoUri, Mode=OneWay}" />
                                                    </Image.Source>
                                                </Image>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock
                                                        Text="{x:Bind Name}"
                                                        FontWeight="SemiBold"
                                                        FontSize="13" />
                                                    <TextBlock
                                                        Text="{x:Bind Country}"
                                                        FontSize="11"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                                <Button
                                                    Grid.Column="2"
                                                    Content="{x:Bind FollowButtonText, Mode=OneWay}"
                                                    IsEnabled="{x:Bind CanFollow, Mode=OneWay}"
                                                    Tag="{x:Bind}"
                                                    Click="OnAddCompetitionClicked"
                                                    MinWidth="0"
                                                    Padding="8,4" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Border>

                        <!-- ======================================================== -->
                        <!-- SECTION C: FOLLOWED CLUBS                                -->
                        <!-- ======================================================== -->
                        <Border
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12">
                            <StackPanel Spacing="10">
                                <TextBlock
                                    Text="Followed Clubs"
                                    FontWeight="SemiBold"
                                    FontSize="14" />
                                <TextBlock
                                    Text="Live matches of followed teams take highest priority on the taskbar."
                                    FontSize="11"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap" />

                                <TextBlock
                                    x:Name="NoFollowedTeamsText"
                                    Text="No clubs followed yet. Search above to add clubs."
                                    FontSize="11"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Visibility="Collapsed" />

                                <ListView
                                    x:Name="TeamsList"
                                    SelectionMode="None"
                                    MaxHeight="240">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="vm:FollowedTeamItemViewModel">
                                            <Grid Padding="4,4,4,4" ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Image
                                                    Grid.Column="0"
                                                    Width="24"
                                                    Height="24"
                                                    VerticalAlignment="Center">
                                                    <Image.Source>
                                                        <BitmapImage UriSource="{x:Bind CachedLogoUri, Mode=OneWay}" />
                                                    </Image.Source>
                                                </Image>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock
                                                        Text="{x:Bind Name}"
                                                        FontWeight="SemiBold"
                                                        FontSize="13" />
                                                    <TextBlock
                                                        Text="{x:Bind Country}"
                                                        FontSize="11"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                                <Button
                                                    Grid.Column="2"
                                                    Content="Remove"
                                                    Tag="{x:Bind Id}"
                                                    Click="OnRemoveTeamClicked"
                                                    MinWidth="0"
                                                    Padding="8,4" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Border>

                        <!-- ======================================================== -->
                        <!-- SECTION D: FOLLOWED COMPETITIONS                         -->
                        <!-- ======================================================== -->
                        <Border
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12">
                            <StackPanel Spacing="10">
                                <TextBlock
                                    Text="Followed Competitions"
                                    FontWeight="SemiBold"
                                    FontSize="14" />
                                <TextBlock
                                    Text="Matches from followed competitions appear under Following and trigger match alerts."
                                    FontSize="11"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap" />

                                <TextBlock
                                    x:Name="NoFollowedCompetitionsText"
                                    Text="No competitions followed yet. Search above to add leagues."
                                    FontSize="11"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Visibility="Collapsed" />

                                <ListView
                                    x:Name="CompetitionsList"
                                    SelectionMode="None"
                                    MaxHeight="240">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="vm:FollowedCompetitionItemViewModel">
                                            <Grid Padding="4,4,4,4" ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Image
                                                    Grid.Column="0"
                                                    Width="24"
                                                    Height="24"
                                                    VerticalAlignment="Center">
                                                    <Image.Source>
                                                        <BitmapImage UriSource="{x:Bind CachedLogoUri, Mode=OneWay}" />
                                                    </Image.Source>
                                                </Image>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock
                                                        Text="{x:Bind Name}"
                                                        FontWeight="SemiBold"
                                                        FontSize="13" />
                                                    <TextBlock
                                                        Text="{x:Bind Country}"
                                                        FontSize="11"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                                <Button
                                                    Grid.Column="2"
                                                    Content="Remove"
                                                    Tag="{x:Bind Id}"
                                                    Click="OnRemoveCompetitionClicked"
                                                    MinWidth="0"
                                                    Padding="8,4" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>
