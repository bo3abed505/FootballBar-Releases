<Page
    x:Class="FootballTray.Client.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:FootballTray.Client.ViewModels"
    mc:Ignorable="d">

    <Grid Padding="20" RowSpacing="12">
        <Grid.RowDefinitions>
            <!-- Top Header & Status Bar -->
            <RowDefinition Height="Auto" />
            <!-- Main Content Area: Matches (Left) + Preferences (Right) -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Header & Status Bar -->
        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- App Title & Ticker Summary -->
            <StackPanel Grid.Column="0" Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock
                        Text="FootballTray"
                        Style="{ThemeResource TitleTextBlockStyle}"
                        FontSize="22"
                        FontWeight="Bold" />
                    <!-- Connection / Freshness Badge -->
                    <Border
                        x:Name="ConnectionBadge"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="10,3,10,3"
                        VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Ellipse
                                x:Name="ConnectionDot"
                                Width="8"
                                Height="8"
                                Fill="{ThemeResource SystemFillColorSuccessBrush}" />
                            <TextBlock
                                x:Name="ConnectionStatusText"
                                Text="Online (Live)"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                
                <!-- Active Taskbar Summary -->
                <TextBlock
                    x:Name="ActiveTickerSummaryText"
                    Text="📌 Taskbar Active: Loading..."
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- Status / Error InfoBar -->
            <InfoBar
                Grid.Column="1"
                x:Name="StatusInfoBar"
                IsOpen="False"
                Severity="Warning"
                IsClosable="True"
                VerticalAlignment="Center" />
        </Grid>

        <!-- Main Content Area -->
        <Grid Grid.Row="1" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <!-- Left: Match Discovery (60%) -->
                <ColumnDefinition Width="3*" MinWidth="340" />
                <!-- Right: Preferences & Settings (40%) -->
                <ColumnDefinition Width="2*" MinWidth="320" MaxWidth="440" />
            </Grid.ColumnDefinitions>

            <!-- ======================================================== -->
            <!-- SECTION A: MATCH DISCOVERY                               -->
            <!-- ======================================================== -->
            <Border
                Grid.Column="0"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <!-- Filter Bar -->
                        <RowDefinition Height="Auto" />
                        <!-- Match List / Empty State -->
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Filter Bar -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            Text="Matches"
                            Style="{ThemeResource SubtitleTextBlockStyle}"
                            FontWeight="SemiBold"
                            VerticalAlignment="Center"
                            Margin="0,0,16,0" />

                        <!-- Filter Segmented Chips -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                            <Button x:Name="FilterAllButton" Content="All" Click="OnFilterAllClick" Style="{ThemeResource AccentButtonStyle}" Padding="12,4,12,4" />
                            <Button x:Name="FilterFollowingButton" Content="⭐ Following" Click="OnFilterFollowingClick" Padding="12,4,12,4" />
                            <Button x:Name="FilterLiveButton" Content="🔴 Live" Click="OnFilterLiveClick" Padding="12,4,12,4" />
                            <Button x:Name="FilterUpcomingButton" Content="Upcoming" Click="OnFilterUpcomingClick" Padding="12,4,12,4" />
                            <Button x:Name="FilterFinishedButton" Content="Finished" Click="OnFilterFinishedClick" Padding="12,4,12,4" />
                        </StackPanel>
                    </Grid>

                    <!-- Match Cards List View -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="10">
                            <!-- Match Items Container -->
                            <ItemsControl x:Name="MatchItemsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:MatchItemViewModel">
                                        <Border
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="14"
                                            Margin="0,0,0,8">
                                            <Grid RowSpacing="8">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <!-- Top Row: Competition, State Badge, Taskbar Indicator -->
                                                <Grid Grid.Row="0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                        <TextBlock
                                                            Text="{x:Bind CompetitionName}"
                                                            FontSize="12"
                                                            FontWeight="SemiBold"
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        <TextBlock
                                                            Text="•"
                                                            FontSize="12"
                                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                        <TextBlock
                                                            Text="{x:Bind KickoffDisplay}"
                                                            FontSize="11"
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                                        <!-- Active Taskbar Badge / Unpin Action -->
                                                        <Button
                                                            x:Name="UnpinMatchButton"
                                                            Visibility="{x:Bind IsActiveTaskbarMatch, Mode=OneWay}"
                                                            Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}"
                                                            BorderThickness="0"
                                                            CornerRadius="4"
                                                            Padding="6,2,6,2"
                                                            MinHeight="0"
                                                            MinWidth="0"
                                                            Tag="{x:Bind}"
                                                            Click="OnUnpinMatchClicked"
                                                            ToolTipService.ToolTip="Pinned to taskbar. Click to unpin and resume match rotation.">
                                                            <TextBlock
                                                                Text="📌 On Taskbar ✕"
                                                                FontSize="10"
                                                                FontWeight="Bold"
                                                                Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                                        </Button>

                                                        <!-- State Badge -->
                                                        <Border
                                                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                            CornerRadius="4"
                                                            Padding="6,2,6,2">
                                                            <TextBlock
                                                                Text="{x:Bind StateDisplay}"
                                                                FontSize="11"
                                                                FontWeight="Bold"
                                                                Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                                        </Border>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Scoreboard Grid -->
                                                <Grid Grid.Row="1" ColumnSpacing="12" VerticalAlignment="Center">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Home Team -->
                                                    <TextBlock
                                                        Grid.Column="0"
                                                        Text="{x:Bind HomeTeamName}"
                                                        FontSize="15"
                                                        FontWeight="Bold"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Center"
                                                        TextTrimming="CharacterEllipsis" />

                                                    <!-- Score -->
                                                    <Border
                                                        Grid.Column="1"
                                                        Background="{ThemeResource SystemFillColorNeutralBackgroundBrush}"
                                                        CornerRadius="6"
                                                        Padding="12,4,12,4"
                                                        HorizontalAlignment="Center">
                                                        <TextBlock
                                                            Text="{x:Bind ScoreDisplay}"
                                                            FontSize="18"
                                                            FontWeight="Bold"
                                                            HorizontalAlignment="Center" />
                                                    </Border>

                                                    <!-- Away Team -->
                                                    <TextBlock
                                                        Grid.Column="2"
                                                        Text="{x:Bind AwayTeamName}"
                                                        FontSize="15"
                                                        FontWeight="Bold"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center"
                                                        TextTrimming="CharacterEllipsis" />
                                                </Grid>

                                                <!-- Bottom Row: Relevance Reasoning (if relevant) -->
                                                <StackPanel
                                                    Grid.Row="2"
                                                    Orientation="Horizontal"
                                                    Spacing="6"
                                                    Visibility="{x:Bind IsRelevant, Mode=OneWay}">
                                                    <Border
                                                        Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}"
                                                        CornerRadius="4"
                                                        Padding="6,2,6,2">
                                                        <TextBlock
                                                            Text="⭐ Followed"
                                                            FontSize="10"
                                                            FontWeight="Bold"
                                                            Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                                    </Border>
                                                    <TextBlock
                                                        Text="{x:Bind RelevanceDisplay, Mode=OneWay}"
                                                        FontSize="11"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        VerticalAlignment="Center"
                                                        TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Empty State Card -->
                            <Border
                                x:Name="EmptyStateBorder"
                                Visibility="Collapsed"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="32"
                                HorizontalAlignment="Stretch">
                                <StackPanel Spacing="10" HorizontalAlignment="Center">
                                    <FontIcon
                                        Glyph="&#xE9CE;"
                                        FontSize="36"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        HorizontalAlignment="Center" />
                                    <TextBlock
                                        x:Name="EmptyStateTitleText"
                                        Text="No Matches Available"
                                        FontSize="16"
                                        FontWeight="SemiBold"
                                        HorizontalAlignment="Center" />
                                    <TextBlock
                                        x:Name="EmptyStateSubtitleText"
                                        Text="Waiting for synchronized match data..."
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        HorizontalAlignment="Center"
                                        TextAlignment="Center"
                                        MaxWidth="340"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ======================================================== -->
            <!-- SECTION B, C, D: PREFERENCES & NOTIFICATION CONTROLS      -->
            <!-- ======================================================== -->
            <Border
                Grid.Column="1"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="18">

                        <!-- Preferences Header -->
                        <TextBlock
                            Text="Preferences &amp; Alerts"
                            Style="{ThemeResource SubtitleTextBlockStyle}"
                            FontWeight="SemiBold" />

                        <!-- ======================================================== -->
                        <!-- SECTION B: CATALOG SEARCH & DISCOVERY                    -->
                        <!-- ======================================================== -->
                        <Border
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12">
                            <StackPanel Spacing="10">
                                <TextBlock
                                    Text="Search Catalog"
                                    FontWeight="SemiBold"
                                    FontSize="14" />
                                <TextBlock
                                    Text="Search the local database to follow clubs and competitions."
                                    FontSize="11"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap" />

                                <TextBox
                                    x:Name="CatalogSearchTextBox"
                                    PlaceholderText="Search clubs or leagues..."
                                    TextChanged="OnCatalogSearchTextChanged" />

                                <StackPanel Orientation="Horizontal" Spacing="16">
                                    <RadioButton
                                        x:Name="ScopeClubsRadio"
                                        Content="Clubs"
                                        IsChecked="True"
                                        Checked="OnSearchScopeChanged" />
                                    <RadioButton
                                        x:Name="ScopeLeaguesRadio"
                                        Content="Leagues &amp; Cups"
                                        Checked="OnSearchScopeChanged" />
                                </StackPanel>

                                <ProgressBar
                                    x:Name="CatalogSearchProgressBar"
                                    IsIndeterminate="True"
                                    Visibility="Collapsed"
                                    Height="2" />

                                <TextBlock
                                    x:Name="CatalogSearchStatusText"
                                    FontSize="11"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Visibility="Collapsed"
                                    TextWrapping="Wrap" />

                                <!-- Team Search Results -->
                                <ListView
                                    x:Name="TeamSearchResultsList"
                                    SelectionMode="None"
                                    MaxHeight="200"
                                    Visibility="Collapsed">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="vm:FollowedTeamItemViewModel">
                                            <Grid Padding="4,4,4,4" ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Image
                                                    Grid.Column="0"
                                                    Width="24"
                                                    Height="24"
                                                    VerticalAlignment="Center">
                                                    <Image.Source>
                                                        <BitmapImage UriSource="{x:Bind CachedLogoUri, Mode=OneWay}" />
                                                    </Image.Source>
                                                </Image>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock
                                                        Text="{x:Bind Name}"
                                                        FontWeight="SemiBold"
                                                        FontSize="13" />
                                                    <TextBlock
                                                        Text="{x:Bind Country}"
                                                        FontSize="11"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                                <Button
                                                    Grid.Column="2"
                                                    Content="{x:Bind FollowButtonText, Mode=OneWay}"
                                                    IsEnabled="{x:Bind CanFollow, Mode=OneWay}"
                                                    Tag="{x:Bind}"
                                                    Click="OnAddTeamClicked"
                                                    MinWidth="0"
                                                    Padding="8,4" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>

                                <!-- Competition Search Results -->
                                <ListView
                                    x:Name="CompetitionSearchResultsList"
                                    SelectionMode="None"
                                    MaxHeight="200"
                                    Visibility="Collapsed">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="vm:FollowedCompetitionItemViewModel">
                                            <Grid Padding="4,4,4,4" ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Image
                                                    Grid.Column="0"
                                                    Width="24"
                                                    Height="24"
                                                    VerticalAlignment="Center">
                                                    <Image.Source>
                                                        <BitmapImage UriSource="{x:Bind CachedLogoUri, Mode=OneWay}" />
                                                    </Image.Source>
                                                </Image>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock
                                                        Text="{x:Bind Name}"
                                                        FontWeight="SemiBold"
                                                        FontSize="13" />
                                                    <TextBlock
                                                        Text="{x:Bind Country}"
                                                        FontSize="11"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                                <Button
                                                    Grid.Column="2"
                                                    Content="{x:Bind FollowButtonText, Mode=OneWay}"
                                                    IsEnabled="{x:Bind CanFollow, Mode=OneWay}"
                                                    Tag="{x:Bind}"
                                                    Click="OnAddCompetitionClicked"
                                                    MinWidth="0"
                                                    Padding="8,4" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Border>

                        <!-- ======================================================== -->
                        <!-- SECTION C: FOLLOWED CLUBS                                -->
                        <!-- ======================================================== -->
                        <Border
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12">
                            <StackPanel Spacing="10">
                                <TextBlock
                                    Text="Followed Clubs"
                                    FontWeight="SemiBold"
                                    FontSize="14" />
                                <TextBlock
                                    Text="Live matches of followed teams take highest priority on the taskbar."
                                    FontSize="11"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap" />

                                <TextBlock
                                    x:Name="NoFollowedTeamsText"
                                    Text="No clubs followed yet. Search above to add clubs."
                                    FontSize="11"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Visibility="Collapsed" />

                                <ListView
                                    x:Name="TeamsList"
                                    SelectionMode="None"
                                    MaxHeight="240">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="vm:FollowedTeamItemViewModel">
                                            <Grid Padding="4,4,4,4" ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Image
                                                    Grid.Column="0"
                                                    Width="24"
                                                    Height="24"
                                                    VerticalAlignment="Center">
                                                    <Image.Source>
                                                        <BitmapImage UriSource="{x:Bind CachedLogoUri, Mode=OneWay}" />
                                                    </Image.Source>
                                                </Image>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock
                                                        Text="{x:Bind Name}"
                                                        FontWeight="SemiBold"
                                                        FontSize="13" />
                                                    <TextBlock
                                                        Text="{x:Bind Country}"
                                                        FontSize="11"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                                <Button
                                                    Grid.Column="2"
                                                    Content="Remove"
                                                    Tag="{x:Bind Id}"
                                                    Click="OnRemoveTeamClicked"
                                                    MinWidth="0"
                                                    Padding="8,4" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Border>

                        <!-- ======================================================== -->
                        <!-- SECTION D: FOLLOWED COMPETITIONS                         -->
                        <!-- ======================================================== -->
                        <Border
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12">
                            <StackPanel Spacing="10">
                                <TextBlock
                                    Text="Followed Competitions"
                                    FontWeight="SemiBold"
                                    FontSize="14" />
                                <TextBlock
                                    Text="Matches from followed competitions appear under Following and trigger match alerts."
                                    FontSize="11"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap" />

                                <TextBlock
                                    x:Name="NoFollowedCompetitionsText"
                                    Text="No competitions followed yet. Search above to add leagues."
                                    FontSize="11"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Visibility="Collapsed" />

                                <ListView
                                    x:Name="CompetitionsList"
                                    SelectionMode="None"
                                    MaxHeight="240">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="vm:FollowedCompetitionItemViewModel">
                                            <Grid Padding="4,4,4,4" ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Image
                                                    Grid.Column="0"
                                                    Width="24"
                                                    Height="24"
                                                    VerticalAlignment="Center">
                                                    <Image.Source>
                                                        <BitmapImage UriSource="{x:Bind CachedLogoUri, Mode=OneWay}" />
                                                    </Image.Source>
                                                </Image>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock
                                                        Text="{x:Bind Name}"
                                                        FontWeight="SemiBold"
                                                        FontSize="13" />
                                                    <TextBlock
                                                        Text="{x:Bind Country}"
                                                        FontSize="11"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                                <Button
                                                    Grid.Column="2"
                                                    Content="Remove"
                                                    Tag="{x:Bind Id}"
                                                    Click="OnRemoveCompetitionClicked"
                                                    MinWidth="0"
                                                    Padding="8,4" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Border>

                        <!-- ======================================================== -->
                        <!-- SECTION D: NOTIFICATIONS                                 -->
                        <!-- ======================================================== -->
                        <Border
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12">
                            <StackPanel Spacing="12">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch">
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock
                                            Text="Windows Match Notifications"
                                            FontWeight="SemiBold"
                                            FontSize="14" />
                                        <TextBlock
                                            Text="Receive native Windows toast alerts for confirmed match events."
                                            FontSize="11"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- Global Notifications Toggle -->
                                <ToggleSwitch
                                    x:Name="GlobalNotificationsSwitch"
                                    Header="Global Notifications Enabled"
                                    IsOn="True"
                                    Toggled="OnGlobalNotificationsToggled" />

                                <!-- Notification Sound Mode Selector & Test Button -->
                                <StackPanel Spacing="4">
                                    <TextBlock
                                        Text="Notification Sound"
                                        FontWeight="SemiBold"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox
                                            Grid.Column="0"
                                            x:Name="SoundModeComboBox"
                                            HorizontalAlignment="Stretch"
                                            SelectionChanged="OnSoundModeSelectionChanged">
                                            <ComboBoxItem Content="Custom (Authentic Stadium Sounds)" Tag="Custom" />
                                            <ComboBoxItem Content="System Default (Windows Chime)" Tag="SystemDefault" />
                                            <ComboBoxItem Content="Off (Muted)" Tag="Off" />
                                        </ComboBox>
                                        <Button
                                            Grid.Column="1"
                                            x:Name="TestSoundButton"
                                            Content="🔊 Test Sound"
                                            Click="OnTestSoundClicked"
                                            VerticalAlignment="Center" />
                                    </Grid>
                                </StackPanel>

                                <MenuFlyoutSeparator />

                                <TextBlock
                                    Text="Event Categories"
                                    FontWeight="SemiBold"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                <!-- Per Category List -->
                                <ItemsControl x:Name="NotificationCategoriesList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:NotificationCategoryItemViewModel">
                                            <Grid Padding="4,2,4,2" ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock
                                                        Text="{x:Bind DisplayName}"
                                                        FontWeight="SemiBold"
                                                        FontSize="12" />
                                                    <TextBlock
                                                        Text="{x:Bind Description}"
                                                        FontSize="11"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                                <ToggleSwitch
                                                    Grid.Column="1"
                                                    IsOn="{x:Bind IsEnabled, Mode=TwoWay}"
                                                    Tag="{x:Bind Type}"
                                                    Toggled="OnNotificationCategoryToggled"
                                                    MinWidth="0" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- ======================================================== -->
                        <!-- SECTION E: TASKBAR & DISPLAY SETTINGS                    -->
                        <!-- ======================================================== -->
                        <Border
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12">
                            <StackPanel Spacing="12">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch">
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock
                                            Text="Taskbar &amp; Display"
                                            FontWeight="SemiBold"
                                            FontSize="14" />
                                        <TextBlock
                                            Text="Configure carousel rotation and global time display format."
                                            FontSize="11"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- Ticker Carousel Toggle -->
                                <ToggleSwitch
                                    x:Name="TickerCarouselSwitch"
                                    Header="Auto-Rotate Ticker (Carousel Mode)"
                                    IsOn="True"
                                    Toggled="OnTickerCarouselToggled" />

                                <!-- 24-Hour Time Format Toggle -->
                                <ToggleSwitch
                                    x:Name="TimeFormat24HourSwitch"
                                    Header="24-Hour Time Format (e.g. 18:30 vs 6:30 PM)"
                                    IsOn="True"
                                    Toggled="OnTimeFormat24HourToggled" />
                            </StackPanel>
                        </Border>

                        <!-- Software Updates Card -->
                        <Border
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16">
                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE895;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <StackPanel>
                                        <TextBlock
                                            Text="Software Updates"
                                            FontWeight="SemiBold"
                                            FontSize="14" />
                                        <TextBlock
                                            x:Name="UpdateCurrentVersionText"
                                            Text="Current: Loading..."
                                            FontSize="11"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- Persistent Update Available Section -->
                                <Border
                                    x:Name="UpdateAvailablePanel"
                                    Visibility="Collapsed"
                                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="12">
                                    <StackPanel Spacing="6">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE73E;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                            <TextBlock Text="Update available" FontWeight="Bold" FontSize="12" />
                                        </StackPanel>
                                        <TextBlock
                                            x:Name="UpdateTargetVersionText"
                                            Text="Version v1.1.0"
                                            FontWeight="SemiBold"
                                            FontSize="12" />
                                        <TextBlock
                                            x:Name="UpdateReleaseNotesHeader"
                                            Text="Release Notes:"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto">
                                            <TextBlock
                                                x:Name="UpdateReleaseNotesText"
                                                TextWrapping="Wrap"
                                                FontSize="11"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </ScrollViewer>

                                        <!-- Download Update Action & Progress -->
                                        <StackPanel Spacing="6" Margin="0,6,0,0">
                                            <ProgressBar
                                                x:Name="UpdateDownloadProgressBar"
                                                Visibility="Collapsed"
                                                Minimum="0"
                                                Maximum="100"
                                                Value="0"
                                                HorizontalAlignment="Stretch" />

                                            <TextBlock
                                                x:Name="UpdateDownloadStatusText"
                                                Visibility="Collapsed"
                                                FontSize="11"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                TextWrapping="Wrap" />

                                            <Button
                                                x:Name="DownloadUpdateButton"
                                                Content="Download update"
                                                Style="{ThemeResource AccentButtonStyle}"
                                                HorizontalAlignment="Stretch"
                                                Click="OnDownloadUpdateClick" />

                                            <Button
                                                x:Name="InstallUpdateButton"
                                                Content="Install update"
                                                Style="{ThemeResource AccentButtonStyle}"
                                                HorizontalAlignment="Stretch"
                                                Visibility="Collapsed"
                                                Click="OnInstallUpdateClick" />

                                            <TextBlock
                                                x:Name="UpdateInstallStatusText"
                                                Visibility="Collapsed"
                                                FontSize="11"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Manual Update Status Message -->
                                <TextBlock
                                    x:Name="UpdateStatusText"
                                    Visibility="Collapsed"
                                    FontSize="11"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap" />

                                <!-- Manual Check for Updates Button -->
                                <Button
                                    x:Name="CheckForUpdatesButton"
                                    Content="Check for updates"
                                    HorizontalAlignment="Stretch"
                                    Click="OnCheckForUpdatesClick" />
                            </StackPanel>
                        </Border>

                        <!-- Diagnostics & Troubleshooting Card -->
                        <Border
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16">
                            <StackPanel Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE9D9;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <StackPanel>
                                        <TextBlock
                                            Text="System Diagnostics"
                                            FontWeight="SemiBold"
                                            FontSize="14" />
                                        <TextBlock
                                            x:Name="DiagnosticsVersionText"
                                            Text="Version 1.0.0 (x64)"
                                            FontSize="11"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </StackPanel>

                                <Grid ColumnSpacing="8" RowSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Health:" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="DiagnosticsHealthText" Text="Healthy" FontWeight="SemiBold" FontSize="11" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Last Sync:" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="DiagnosticsLastSyncText" Text="None" FontSize="11" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Taskbar:" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="DiagnosticsTaskbarText" Text="Attached" FontSize="11" />
                                </Grid>

                                <Button
                                    x:Name="CopyDiagnosticsButton"
                                    Content="Copy Diagnostics"
                                    HorizontalAlignment="Stretch"
                                    Click="OnCopyDiagnosticsClick" />
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>
