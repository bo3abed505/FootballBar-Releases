<Page
    x:Class="FootballTray.Client.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:FootballTray.Client.ViewModels"
    xmlns:dto="using:FootballTray.Core.Dto"
    mc:Ignorable="d">

    <Page.Resources>
        <DataTemplate x:Key="MatchCardTemplate" x:DataType="vm:MatchItemViewModel">
            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14"
                Margin="0,0,0,8"
                Tag="{x:Bind}"
                Tapped="OnMatchCardTapped"
                IsHitTestVisible="True">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Top Row: Competition, Follow Competition Star, State Badge, Taskbar Indicator -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <!-- Competition Follow Star Toggle Button -->
                            <Button
                                x:Name="FollowCompetitionButton"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="2"
                                MinHeight="0"
                                MinWidth="0"
                                Tag="{x:Bind}"
                                Click="OnToggleFollowCompetitionClicked"
                                ToolTipService.ToolTip="Toggle follow competition">
                                <FontIcon
                                    Glyph="{x:Bind CompetitionStarGlyph, Mode=OneWay}"
                                    FontSize="12"
                                    Foreground="{ThemeResource SystemFillColorAttentionBrush}"
                                    Opacity="{x:Bind CompetitionStarOpacity, Mode=OneWay}" />
                            </Button>
                            <TextBlock
                                Text="{x:Bind CompetitionName}"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                VerticalAlignment="Center" />
                            <TextBlock
                                Text="•"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                VerticalAlignment="Center" />
                            <TextBlock
                                Text="{x:Bind KickoffDisplay}"
                                FontSize="11"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                            <!-- Universal Persistent Taskbar Pin Toggle Button -->
                            <Button
                                x:Name="PinMatchButton"
                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="6,2,6,2"
                                MinHeight="0"
                                MinWidth="0"
                                Tag="{x:Bind}"
                                Click="OnTogglePinClicked"
                                Opacity="{x:Bind PinButtonOpacity, Mode=OneWay}"
                                ToolTipService.ToolTip="{x:Bind PinToolTipText, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <FontIcon
                                        Glyph="{x:Bind PinGlyph, Mode=OneWay}"
                                        FontSize="11"
                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock
                                        Text="{x:Bind PinText, Mode=OneWay}"
                                        FontSize="10"
                                        FontWeight="Bold"
                                        Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                </StackPanel>
                            </Button>

                            <!-- State Badge: Red LIVE Badge -->
                            <Border
                                Background="#D13438"
                                CornerRadius="4"
                                Padding="6,2,6,2"
                                Visibility="{x:Bind IsLiveBadgeVisible, Mode=OneWay}">
                                <TextBlock
                                    Text="{x:Bind StateDisplay}"
                                    FontSize="11"
                                    FontWeight="Bold"
                                    Foreground="White" />
                            </Border>

                            <!-- State Badge: Standard / Prematch / Finished Badge -->
                            <Border
                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                CornerRadius="4"
                                Padding="6,2,6,2"
                                Visibility="{x:Bind IsNormalBadgeVisible, Mode=OneWay}">
                                <TextBlock
                                    Text="{x:Bind StateDisplay}"
                                    FontSize="11"
                                    FontWeight="Bold"
                                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Scoreboard Grid -->
                    <Grid Grid.Row="1" ColumnSpacing="12" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Home Team with Follow Star -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button
                                x:Name="FollowHomeTeamButton"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="2"
                                MinHeight="0"
                                MinWidth="0"
                                Tag="{x:Bind}"
                                Click="OnToggleFollowHomeTeamClicked"
                                ToolTipService.ToolTip="Toggle follow home team">
                                <FontIcon
                                    Glyph="{x:Bind HomeStarGlyph, Mode=OneWay}"
                                    FontSize="12"
                                    Foreground="{ThemeResource SystemFillColorAttentionBrush}"
                                    Opacity="{x:Bind HomeStarOpacity, Mode=OneWay}" />
                            </Button>
                            <Button
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="4,2"
                                CornerRadius="4"
                                Tag="{x:Bind}"
                                Click="OnScheduleHomeTeamClicked"
                                ToolTipService.ToolTip="Open Team Hub">
                                <TextBlock
                                    Text="{x:Bind HomeTeamName}"
                                    FontSize="15"
                                    FontWeight="Bold"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    TextTrimming="CharacterEllipsis" />
                            </Button>
                        </StackPanel>

                        <!-- Score -->
                        <Border
                            Grid.Column="1"
                            Background="{ThemeResource SystemFillColorNeutralBackgroundBrush}"
                            CornerRadius="6"
                            Padding="12,4,12,4"
                            HorizontalAlignment="Center">
                            <TextBlock
                                Text="{x:Bind ScoreDisplay}"
                                FontSize="18"
                                FontWeight="Bold"
                                HorizontalAlignment="Center" />
                        </Border>

                        <!-- Away Team with Follow Star -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <Button
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="4,2"
                                CornerRadius="4"
                                Tag="{x:Bind}"
                                Click="OnScheduleAwayTeamClicked"
                                ToolTipService.ToolTip="Open Team Hub">
                                <TextBlock
                                    Text="{x:Bind AwayTeamName}"
                                    FontSize="15"
                                    FontWeight="Bold"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    TextTrimming="CharacterEllipsis" />
                            </Button>
                            <Button
                                x:Name="FollowAwayTeamButton"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="2"
                                MinHeight="0"
                                MinWidth="0"
                                Tag="{x:Bind}"
                                Click="OnToggleFollowAwayTeamClicked"
                                ToolTipService.ToolTip="Toggle follow away team">
                                <FontIcon
                                    Glyph="{x:Bind AwayStarGlyph, Mode=OneWay}"
                                    FontSize="12"
                                    Foreground="{ThemeResource SystemFillColorAttentionBrush}"
                                    Opacity="{x:Bind AwayStarOpacity, Mode=OneWay}" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Bottom Row: Relevance Reasoning (if relevant) -->
                    <StackPanel
                        Grid.Row="2"
                        Orientation="Horizontal"
                        Spacing="6"
                        Visibility="{x:Bind IsRelevant, Mode=OneWay}">
                        <Border
                            Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}"
                            CornerRadius="4"
                            Padding="6,2,6,2">
                            <TextBlock
                                Text="⭐ Followed"
                                FontSize="10"
                                FontWeight="Bold"
                                Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        </Border>
                        <TextBlock
                            Text="{x:Bind RelevanceDisplay, Mode=OneWay}"
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            VerticalAlignment="Center"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Expandable / Collapsible Competition Accordion Card Template -->
        <DataTemplate x:Key="CompetitionAccordionTemplate" x:DataType="vm:CompetitionGroupViewModel">
            <Expander
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}"
                Margin="0,0,0,10">
                <Expander.Header>
                    <Grid ColumnSpacing="12" HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: Competition Logo + Followed Star Indicator + Competition Name + Country (Click opens Standings & Leaders) -->
                        <Button
                            x:Name="CompetitionHeaderButton"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="2,2"
                            CornerRadius="4"
                            Tag="{x:Bind}"
                            Click="OnCompetitionTitleClicked"
                            ToolTipService.ToolTip="Open Standings &amp; Leaders"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Border
                                    Width="20"
                                    Height="20"
                                    CornerRadius="4"
                                    Background="Transparent"
                                    Visibility="{x:Bind LogoVisibility, Mode=OneWay}"
                                    VerticalAlignment="Center">
                                    <Image
                                        Source="{x:Bind LogoSource, Mode=OneWay}"
                                        Width="20"
                                        Height="20"
                                        Stretch="Uniform" />
                                </Border>
                                <FontIcon
                                    Glyph="&#xE734;"
                                    FontSize="14"
                                    Foreground="{ThemeResource SystemFillColorAttentionBrush}"
                                    Visibility="{x:Bind FollowedStarVisibility, Mode=OneWay}"
                                    VerticalAlignment="Center" />
                                <TextBlock
                                    Text="{x:Bind CompetitionName, Mode=OneWay}"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                    VerticalAlignment="Center"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Text="{x:Bind CountryDisplay, Mode=OneWay}"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Right: Match Count Badge -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,8,0">
                            <Border
                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="8,2"
                                VerticalAlignment="Center">
                                <TextBlock
                                    Text="{x:Bind MatchCountText, Mode=OneWay}"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Border>
                        </StackPanel>
                    </Grid>
                </Expander.Header>

                <Expander.Content>
                    <ItemsControl
                        ItemsSource="{x:Bind Matches}"
                        ItemTemplate="{StaticResource MatchCardTemplate}"
                        Padding="10,0,10,6" />
                </Expander.Content>
            </Expander>
        </DataTemplate>

        <!-- Multi-Day Following Day Accordion Card Template -->
        <DataTemplate x:Key="FollowingDayAccordionTemplate" x:DataType="vm:FollowingDayGroupViewModel">
            <Expander
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}"
                Margin="0,0,0,10">
                <Expander.Header>
                    <Grid ColumnSpacing="12" HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Day Title & Indicator -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock
                                Text="📅"
                                FontSize="14"
                                VerticalAlignment="Center" />
                            <TextBlock
                                Text="{x:Bind HeaderTitle, Mode=OneWay}"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Match Count Badge -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,8,0">
                            <Border
                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="8,2"
                                VerticalAlignment="Center">
                                <TextBlock
                                    Text="{x:Bind MatchCountBadge, Mode=OneWay}"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Border>
                        </StackPanel>
                    </Grid>
                </Expander.Header>

                <Expander.Content>
                    <StackPanel Spacing="8" Padding="10,8,10,6">
                        <ItemsControl
                            ItemsSource="{x:Bind CompetitionGroups}"
                            ItemTemplate="{StaticResource CompetitionAccordionTemplate}" />
                        <TextBlock
                            Text="No followed matches on this date"
                            FontSize="12"
                            FontStyle="Italic"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            HorizontalAlignment="Center"
                            Margin="0,6,0,6"
                            Visibility="{x:Bind EmptyDayVisibility, Mode=OneWay}" />
                    </StackPanel>
                </Expander.Content>
            </Expander>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="20" RowSpacing="12">
        <Grid.RowDefinitions>
            <!-- Top Header & Status Bar -->
            <RowDefinition Height="Auto" />
            <!-- Main Content Area: Matches (Left) + Preferences (Right) -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Header & Status Bar -->
        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- App Title, Mode Switcher & Ticker Summary -->
            <StackPanel Grid.Column="0" Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                    <TextBlock
                        Text="FootballBar"
                        Style="{ThemeResource TitleTextBlockStyle}"
                        FontSize="22"
                        FontWeight="Bold"
                        VerticalAlignment="Center" />

                    <!-- Mode Switcher: ⚽ Matches | 🏆 Standings & Leaders -->
                    <Border
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="3"
                        VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Button
                                x:Name="ModeMatchesButton"
                                Content="⚽ Matches"
                                Click="OnMatchesModeClicked"
                                Padding="12,4"
                                CornerRadius="6"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Style="{ThemeResource AccentButtonStyle}" />
                            <Button
                                x:Name="ModeStandingsButton"
                                Content="🏆 Standings &amp; Leaders"
                                Click="OnStandingsModeClicked"
                                Padding="12,4"
                                CornerRadius="6"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Style="{ThemeResource DefaultButtonStyle}" />
                        </StackPanel>
                    </Border>

                    <!-- Connection / Freshness Badge -->
                    <Border
                        x:Name="ConnectionBadge"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="10,3,10,3"
                        VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Ellipse
                                x:Name="ConnectionDot"
                                Width="8"
                                Height="8"
                                Fill="{ThemeResource SystemFillColorSuccessBrush}" />
                            <TextBlock
                                x:Name="ConnectionStatusText"
                                Text="Online (Live)"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                
                <!-- Active Taskbar Summary -->
                <TextBlock
                    x:Name="ActiveTickerSummaryText"
                    Text="{x:Bind ViewModel.TickerMatchDisplay, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.HasActiveTicker, Mode=OneWay}"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- Status / Error InfoBar & Settings Button -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <InfoBar
                    x:Name="StatusInfoBar"
                    IsOpen="False"
                    Severity="Warning"
                    IsClosable="True"
                    VerticalAlignment="Center" />

                <Button
                    x:Name="OpenSettingsButton"
                    Content="&#xE713;"
                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                    FontSize="16"
                    Padding="8"
                    ToolTipService.ToolTip="Settings &amp; Preferences"
                    Click="OnOpenSettingsClicked" />
            </StackPanel>
        </Grid>

        <!-- Main Content Area -->
        <Grid Grid.Row="1" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <!-- Left: Match Discovery (60%) -->
                <ColumnDefinition Width="3*" MinWidth="340" />
                <!-- Right: Preferences & Settings (40%) -->
                <ColumnDefinition Width="2*" MinWidth="320" MaxWidth="440" />
            </Grid.ColumnDefinitions>

            <!-- ======================================================== -->
            <!-- SECTION A: MATCH DISCOVERY                               -->
            <!-- ======================================================== -->
            <Border
                Grid.Column="0"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
                <Grid>
                    <!-- ======================================================== -->
                    <!-- VIEW 1: MATCH DISCOVERY                                  -->
                    <!-- ======================================================== -->
                    <Grid x:Name="MatchDiscoveryPanel" RowSpacing="12" Visibility="Visible">
                        <Grid.RowDefinitions>
                        <!-- Row 0: Filter Bar -->
                        <RowDefinition Height="Auto" />
                        <!-- Row 1: 7-Day Calendar Navigation Bar -->
                        <RowDefinition Height="Auto" />
                        <!-- Row 2: Match List / Empty State -->
                        <RowDefinition Height="*" />
                        <!-- Row 3: Footer Schedule Sync Info -->
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Filter Bar -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            Text="Matches"
                            Style="{ThemeResource SubtitleTextBlockStyle}"
                            FontWeight="SemiBold"
                            VerticalAlignment="Center"
                            Margin="0,0,16,0" />

                        <!-- Filter Segmented Chips -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                            <Button x:Name="FilterAllButton" Content="All" Click="OnFilterAllClick" Style="{ThemeResource AccentButtonStyle}" Padding="12,4,12,4" />
                            <Button x:Name="FilterFollowingButton" Content="⭐ Following" Click="OnFilterFollowingClick" Padding="12,4,12,4" />
                            <Button x:Name="FilterLiveButton" Content="🔴 Live" Click="OnFilterLiveClick" Padding="12,4,12,4" />
                            <Button x:Name="FilterUpcomingButton" Content="Upcoming" Click="OnFilterUpcomingClick" Padding="12,4,12,4" />
                            <Button x:Name="FilterFinishedButton" Content="Finished" Click="OnFilterFinishedClick" Padding="12,4,12,4" />
                        </StackPanel>
                    </Grid>

                    <!-- 7-Day Calendar Navigation Bar with Date Picker -->
                    <Grid
                        Grid.Row="1"
                        Visibility="{x:Bind ViewModel.IsCalendarVisible, Mode=OneWay}"
                        HorizontalAlignment="Center"
                        ColumnSpacing="8"
                        Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ScrollViewer
                            x:Name="CalendarScrollViewer"
                            Grid.Column="0"
                            Visibility="{x:Bind ViewModel.IsCalendarStripVisible, Mode=OneWay}"
                            HorizontalAlignment="Center"
                            HorizontalScrollBarVisibility="Auto"
                            VerticalScrollBarVisibility="Disabled"
                            HorizontalScrollMode="Enabled"
                            VerticalScrollMode="Disabled">
                            <ItemsControl x:Name="CalendarDaysList" HorizontalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:CalendarDayItemViewModel">
                                        <Button
                                            Click="OnCalendarDayClicked"
                                            Tag="{x:Bind}"
                                            Style="{x:Bind ButtonStyle, Mode=OneWay}"
                                            Padding="8,5,8,5"
                                            Margin="0,0,2,0"
                                            CornerRadius="8"
                                            MinWidth="48"
                                            HorizontalAlignment="Center"
                                            HorizontalContentAlignment="Center">
                                            <StackPanel Spacing="1" HorizontalAlignment="Center">
                                                <!-- Day Pill Label: Yesterday / Today / Tomorrow / Thu 22 / etc. -->
                                                <TextBlock
                                                    Text="{x:Bind RelativeLabel, Mode=OneWay}"
                                                    FontSize="12"
                                                    FontWeight="SemiBold"
                                                    HorizontalAlignment="Center" />

                                                <!-- Match Count Text -->
                                                <TextBlock
                                                    Visibility="{x:Bind HasMatches, Mode=OneWay}"
                                                    Text="{x:Bind MatchCountText, Mode=OneWay}"
                                                    FontSize="9"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <CalendarDatePicker
                            x:Name="MatchCalendarDatePicker"
                            Grid.Column="1"
                            Visibility="{x:Bind ViewModel.IsDatePickerVisible, Mode=OneWay}"
                            VerticalAlignment="Center"
                            Date="{x:Bind ViewModel.SelectedCalendarDateOffset, Mode=TwoWay}"
                            DateFormat="{}{month.abbreviated} {day.integer}"
                            PlaceholderText="📅 Jump to date"
                            CornerRadius="8"
                            ToolTipService.ToolTip="Select any past or future date">
                            <CalendarDatePicker.Resources>
                                <SolidColorBrush x:Key="CalendarDatePickerBorderBrushFocused" Color="{ThemeResource SystemAccentColor}" />
                                <SolidColorBrush x:Key="CalendarDatePickerBorderBrushPointerOver" Color="{ThemeResource SystemAccentColor}" />
                                <SolidColorBrush x:Key="CalendarViewSelectedDayBackground" Color="{ThemeResource SystemAccentColor}" />
                                <SolidColorBrush x:Key="CalendarViewSelectedDayBackgroundFocused" Color="{ThemeResource SystemAccentColor}" />
                                <SolidColorBrush x:Key="CalendarViewSelectedDayBackgroundPointerOver" Color="{ThemeResource SystemAccentColor}" />
                                <SolidColorBrush x:Key="CalendarViewTodayBackground" Color="{ThemeResource SystemAccentColor}" />
                                <SolidColorBrush x:Key="CalendarViewDayItemSelectionIndicatorBackground" Color="{ThemeResource SystemAccentColor}" />
                            </CalendarDatePicker.Resources>
                        </CalendarDatePicker>
                    </Grid>

                    <!-- Match Cards List View -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="10">
                            <!-- Expandable Competition Accordion Groups -->
                            <ItemsControl
                                x:Name="CompetitionGroupsList"
                                Visibility="{x:Bind ViewModel.StandardScheduleVisibility, Mode=OneWay}"
                                ItemTemplate="{StaticResource CompetitionAccordionTemplate}" />

                            <!-- Multi-Day Following Accordion Groups (Following Tab) -->
                            <ItemsControl
                                x:Name="FollowingDayGroupsList"
                                ItemsSource="{x:Bind ViewModel.FollowingDayGroups, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.FollowingScheduleVisibility, Mode=OneWay}"
                                ItemTemplate="{StaticResource FollowingDayAccordionTemplate}" />

                            <!-- Empty State Card -->
                            <Border
                                x:Name="EmptyStateBorder"
                                Visibility="Collapsed"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="32"
                                HorizontalAlignment="Stretch">
                                <StackPanel Spacing="10" HorizontalAlignment="Center">
                                    <ProgressRing
                                        x:Name="EmptyStateProgressRing"
                                        IsActive="True"
                                        Width="32"
                                        Height="32"
                                        Visibility="Collapsed"
                                        HorizontalAlignment="Center" />
                                    <FontIcon
                                        x:Name="EmptyStateIcon"
                                        Glyph="&#xE9CE;"
                                        FontSize="36"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        HorizontalAlignment="Center" />
                                    <TextBlock
                                        x:Name="EmptyStateTitleText"
                                        Text="No Matches Available"
                                        FontSize="16"
                                        FontWeight="SemiBold"
                                        HorizontalAlignment="Center" />
                                    <TextBlock
                                        x:Name="EmptyStateSubtitleText"
                                        Text="Waiting for synchronized match data..."
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        HorizontalAlignment="Center"
                                        TextAlignment="Center"
                                        MaxWidth="340"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Footer Info Text: Dynamic Synchronization Status -->
                    <Border
                        Grid.Row="3"
                        Margin="0,4,0,0"
                        Padding="4,8,4,0"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="0,1,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" Opacity="0.75">
                            <FontIcon
                                x:Name="SyncStatusIcon"
                                Glyph="{x:Bind ViewModel.SyncIconGlyph, Mode=OneWay}"
                                FontSize="11"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                VerticalAlignment="Center" />
                            <TextBlock
                                x:Name="SyncStatusTextBlock"
                                Text="{x:Bind ViewModel.SyncStatusText, Mode=OneWay}"
                                FontSize="11"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>

                    <!-- ======================================================== -->
                    <!-- VIEW 2: STANDINGS & LEADERS HUB                          -->
                    <!-- ======================================================== -->
                    <Grid
                        x:Name="StandingsAndLeadersPanel"
                        RowSpacing="12"
                        Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <!-- Row 0: Competition Selector Header & Horizontal Chips -->
                            <RowDefinition Height="Auto" />
                            <!-- Row 1: Sub-Tabs Switcher (📊 League Table | 🥅 Top Scorers | 🎯 Top Assists) -->
                            <RowDefinition Height="Auto" />
                            <!-- Row 2: Content Area (Standings / Leaders / Loading / Error) -->
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Row 0: Competition Header & Horizontal Selector Chips -->
                        <Grid Grid.Row="0" RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Competition Title & Season Info -->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Border
                                        Width="24"
                                        Height="24"
                                        CornerRadius="4"
                                        Background="Transparent"
                                        VerticalAlignment="Center">
                                        <Grid>
                                            <Image
                                                Source="{x:Bind ViewModel.CurrentCompetitionLogoSource, Mode=OneWay}"
                                                Width="24"
                                                Height="24"
                                                Stretch="Uniform"
                                                Visibility="{x:Bind ViewModel.CurrentCompetitionLogoVisibility, Mode=OneWay}" />
                                            <TextBlock
                                                Text="🏆"
                                                FontSize="16"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Visibility="{x:Bind ViewModel.CurrentCompetitionFallbackVisibility, Mode=OneWay}" />
                                        </Grid>
                                    </Border>
                                    <TextBlock
                                        Text="{x:Bind ViewModel.CurrentCompetitionName, Mode=OneWay}"
                                        Style="{ThemeResource SubtitleTextBlockStyle}"
                                        FontWeight="Bold"
                                        VerticalAlignment="Center"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Text="{x:Bind ViewModel.CurrentSeasonDisplay, Mode=OneWay}"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>

                            <!-- Horizontal Scrollable Competition Selector Chips -->
                            <ScrollViewer
                                Grid.Row="1"
                                Height="Auto"
                                HorizontalScrollBarVisibility="Auto"
                                VerticalScrollBarVisibility="Disabled"
                                HorizontalScrollMode="Enabled"
                                VerticalScrollMode="Disabled">
                                <ItemsControl
                                    x:Name="HubCompetitionsList"
                                    ItemsSource="{x:Bind ViewModel.HubCompetitions, Mode=OneWay}"
                                    Padding="0,2,0,24">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="6" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:HubCompetitionItemViewModel">
                                            <Button
                                                Click="OnHubCompetitionChipClicked"
                                                Tag="{x:Bind}"
                                                Padding="10,4"
                                                CornerRadius="14"
                                                BorderThickness="1"
                                                Background="{x:Bind BackgroundBrush, Mode=OneWay}"
                                                BorderBrush="{x:Bind BorderBrush, Mode=OneWay}">
                                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <Border
                                                        Width="16"
                                                        Height="16"
                                                        VerticalAlignment="Center">
                                                        <Grid>
                                                            <Image
                                                                Source="{x:Bind LogoSource, Mode=OneWay}"
                                                                Width="16"
                                                                Height="16"
                                                                Stretch="Uniform"
                                                                Visibility="{x:Bind LogoVisibility, Mode=OneWay}" />
                                                            <TextBlock
                                                                Text="🏆"
                                                                FontSize="11"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                Visibility="{x:Bind FallbackVisibility, Mode=OneWay}" />
                                                        </Grid>
                                                    </Border>
                                                    <TextBlock
                                                        Text="{x:Bind Name, Mode=OneWay}"
                                                        FontSize="12"
                                                        FontWeight="SemiBold"
                                                        Foreground="{x:Bind ForegroundBrush, Mode=OneWay}"
                                                        VerticalAlignment="Center" />
                                                    <TextBlock
                                                        Text="⭐"
                                                        FontSize="10"
                                                        Visibility="{x:Bind IsFollowed, Mode=OneWay}"
                                                        VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>

                        <!-- Row 1: Sub-Tabs Switcher (📊 League Table | 🥅 Top Scorers | 🎯 Top Assists) -->
                        <Border
                            Grid.Row="1"
                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="3">
                            <Grid ColumnSpacing="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Button
                                    x:Name="LeagueTableTabButton"
                                    Grid.Column="0"
                                    Content="📊 Table"
                                    HorizontalAlignment="Stretch"
                                    Click="OnLeagueTableTabClicked"
                                    Padding="6,4"
                                    CornerRadius="6"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Style="{ThemeResource AccentButtonStyle}" />

                                <Button
                                    x:Name="FixturesTabButton"
                                    Grid.Column="1"
                                    Content="📅 Fixtures"
                                    HorizontalAlignment="Stretch"
                                    Click="OnFixturesTabClicked"
                                    Padding="6,4"
                                    CornerRadius="6"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Style="{ThemeResource DefaultButtonStyle}" />

                                <Button
                                    x:Name="KnockoutBracketTabButton"
                                    Grid.Column="2"
                                    Content="🏆 Brackets"
                                    HorizontalAlignment="Stretch"
                                    Click="OnKnockoutBracketTabClicked"
                                    Padding="6,4"
                                    CornerRadius="6"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Style="{ThemeResource DefaultButtonStyle}" />

                                <Button
                                    x:Name="TopScorersTabButton"
                                    Grid.Column="3"
                                    Content="🥅 Scorers"
                                    HorizontalAlignment="Stretch"
                                    Click="OnTopScorersTabClicked"
                                    Padding="6,4"
                                    CornerRadius="6"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Style="{ThemeResource DefaultButtonStyle}" />

                                <Button
                                    x:Name="TopAssistsTabButton"
                                    Grid.Column="4"
                                    Content="🎯 Assists"
                                    HorizontalAlignment="Stretch"
                                    Click="OnTopAssistsTabClicked"
                                    Padding="6,4"
                                    CornerRadius="6"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Style="{ThemeResource DefaultButtonStyle}" />
                            </Grid>
                        </Border>

                        <!-- Row 2: Content Area (Standings / Top Scorers / Top Assists / Loading / Error) -->
                        <Grid Grid.Row="2">
                            <!-- Loading State -->
                            <StackPanel
                                x:Name="HubLoadingContainer"
                                Spacing="10"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="{x:Bind ViewModel.HubLoadingVisibility, Mode=OneWay}">
                                <ProgressRing IsActive="True" Width="36" Height="36" HorizontalAlignment="Center" />
                                <TextBlock
                                    Text="Loading standings &amp; leaders..."
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    HorizontalAlignment="Center" />
                            </StackPanel>

                            <!-- Error InfoBar -->
                            <InfoBar
                                IsOpen="{x:Bind ViewModel.HasHubError, Mode=OneWay}"
                                Severity="Error"
                                Message="{x:Bind ViewModel.HubErrorMessage, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.HubErrorVisibility, Mode=OneWay}"
                                IsClosable="False"
                                VerticalAlignment="Top"
                                Margin="0,8,0,0" />

                            <!-- SUB-TAB 0: LEAGUE TABLE -->
                            <Grid
                                x:Name="LeagueTableContainer"
                                Visibility="{x:Bind ViewModel.HubTableSubTabVisibility, Mode=OneWay}">
                                <Grid.RowDefinitions>
                                    <!-- Table Header Row -->
                                    <RowDefinition Height="Auto" />
                                    <!-- Scrollable Rows -->
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- Table Header -->
                                <Border
                                    Grid.Row="0"
                                    Background="#0F172A"
                                    BorderBrush="#334155"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="8,6"
                                    Margin="0,0,0,4">
                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="32" />
                                            <ColumnDefinition Width="30" />
                                            <ColumnDefinition Width="30" />
                                            <ColumnDefinition Width="30" />
                                            <ColumnDefinition Width="38" />
                                            <ColumnDefinition Width="38" />
                                            <ColumnDefinition Width="105" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="#" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" HorizontalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="TEAM" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" />
                                        <TextBlock Grid.Column="2" Text="P" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" HorizontalAlignment="Center" />
                                        <TextBlock Grid.Column="3" Text="W" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" HorizontalAlignment="Center" />
                                        <TextBlock Grid.Column="4" Text="D" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" HorizontalAlignment="Center" />
                                        <TextBlock Grid.Column="5" Text="L" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" HorizontalAlignment="Center" />
                                        <TextBlock Grid.Column="6" Text="GD" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" HorizontalAlignment="Center" />
                                        <TextBlock Grid.Column="7" Text="PTS" FontSize="10" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Center" />
                                        <TextBlock Grid.Column="8" Text="FORM" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" HorizontalAlignment="Center" />
                                    </Grid>
                                </Border>

                                <!-- Standings Rows List -->
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{x:Bind ViewModel.CurrentStandings, Mode=OneWay}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:StandingRowItemViewModel">
                                                <Border
                                                    Background="{x:Bind RowBackgroundBrush, Mode=OneTime}"
                                                    BorderBrush="{x:Bind RowBorderBrush, Mode=OneTime}"
                                                    BorderThickness="{x:Bind RowBorderThickness, Mode=OneTime}"
                                                    CornerRadius="6"
                                                    Padding="8,5"
                                                    Margin="0,1">
                                                    <Grid ColumnSpacing="6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="28" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="32" />
                                                            <ColumnDefinition Width="30" />
                                                            <ColumnDefinition Width="30" />
                                                            <ColumnDefinition Width="30" />
                                                            <ColumnDefinition Width="38" />
                                                            <ColumnDefinition Width="38" />
                                                            <ColumnDefinition Width="105" />
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Rank -->
                                                        <TextBlock
                                                            Grid.Column="0"
                                                            Text="{x:Bind Rank}"
                                                            FontSize="11"
                                                            FontWeight="SemiBold"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center" />

                                                        <!-- Team Logo + Name + Badges (Clickable to open Team Hub) -->
                                                        <Button
                                                            Grid.Column="1"
                                                            Click="OnStandingTeamClicked"
                                                            Tag="{x:Bind}"
                                                            Style="{ThemeResource SubtleButtonStyle}"
                                                            Padding="4,2"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                                <Border
                                                                    Width="18"
                                                                    Height="18"
                                                                    Visibility="{x:Bind LogoVisibility, Mode=OneWay}"
                                                                    VerticalAlignment="Center">
                                                                    <Image Source="{x:Bind TeamLogoSource, Mode=OneWay}" Width="18" Height="18" Stretch="Uniform" />
                                                                </Border>
                                                                <TextBlock
                                                                    Text="{x:Bind DisplayName}"
                                                                    FontSize="12"
                                                                    FontWeight="SemiBold"
                                                                    TextTrimming="CharacterEllipsis"
                                                                    VerticalAlignment="Center" />
                                                                <!-- Followed Team Star -->
                                                                <TextBlock
                                                                    Text="⭐"
                                                                    FontSize="10"
                                                                    Visibility="{x:Bind FollowedStarVisibility, Mode=OneWay}"
                                                                    VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </Button>

                                                        <!-- P, W, D, L -->
                                                        <TextBlock Grid.Column="2" Text="{x:Bind Played}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="3" Text="{x:Bind Wins}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="4" Text="{x:Bind Draws}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="5" Text="{x:Bind Losses}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />

                                                        <!-- GD -->
                                                        <TextBlock Grid.Column="6" Text="{x:Bind GoalDiffDisplay}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />

                                                        <!-- PTS -->
                                                        <TextBlock Grid.Column="7" Text="{x:Bind Points}" FontSize="12" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Center" VerticalAlignment="Center" />

                                                        <!-- Form Badges -->
                                                        <ItemsControl Grid.Column="8" ItemsSource="{x:Bind FormBadges}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <StackPanel Orientation="Horizontal" Spacing="3" />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="vm:FormBadgeItemViewModel">
                                                                    <Border
                                                                        Width="16"
                                                                        Height="16"
                                                                        CornerRadius="3"
                                                                        Background="{x:Bind BackgroundBrush}"
                                                                        ToolTipService.ToolTip="{x:Bind TooltipText}">
                                                                        <TextBlock
                                                                            Text="{x:Bind Text}"
                                                                            FontSize="9"
                                                                            FontWeight="Bold"
                                                                            Foreground="{x:Bind ForegroundBrush}"
                                                                            HorizontalAlignment="Center"
                                                                            VerticalAlignment="Center" />
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>

                            <!-- SUB-TAB 1: FIXTURES -->
                            <Grid
                                x:Name="FixturesContainer"
                                Visibility="{x:Bind ViewModel.HubFixturesSubTabVisibility, Mode=OneWay}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Spacing="6" Margin="0,0,0,10">
                                        <ItemsControl ItemsSource="{x:Bind ViewModel.CurrentFixtures, Mode=OneWay}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:CompetitionFixtureViewModel">
                                                    <Border
                                                        HorizontalAlignment="Stretch"
                                                        Background="{x:Bind RowBackgroundBrush}"
                                                        BorderBrush="{x:Bind RowBorderBrush}"
                                                        BorderThickness="{x:Bind RowBorderThickness}"
                                                        Padding="8,6"
                                                        Margin="0,0,0,3"
                                                        CornerRadius="6"
                                                        Tag="{x:Bind}"
                                                        Tapped="OnFixtureCardTapped">
                                                        <Grid ColumnSpacing="8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="65" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>

                                                            <Border
                                                                Grid.Column="0"
                                                                Background="#1E293B"
                                                                BorderBrush="#334155"
                                                                BorderThickness="1"
                                                                CornerRadius="4"
                                                                Padding="4,2"
                                                                VerticalAlignment="Center">
                                                                <TextBlock
                                                                    Text="{x:Bind RoundName}"
                                                                    FontSize="9"
                                                                    FontWeight="SemiBold"
                                                                    Foreground="#94A3B8"
                                                                    TextTrimming="CharacterEllipsis"
                                                                    HorizontalAlignment="Center" />
                                                            </Border>

                                                            <Button
                                                                Grid.Column="1"
                                                                Background="Transparent"
                                                                BorderThickness="0"
                                                                Padding="0"
                                                                Tag="{x:Bind}"
                                                                Click="OnFixtureHomeTeamClicked"
                                                                HorizontalAlignment="Right"
                                                                VerticalAlignment="Center"
                                                                ToolTipService.ToolTip="Open Team Hub">
                                                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                                    <TextBlock Text="{x:Bind HomeTeamName}" FontSize="11" FontWeight="SemiBold" Foreground="{x:Bind HomeTeamForegroundBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                                    <Border Width="16" Height="16" VerticalAlignment="Center">
                                                                        <Image Source="{x:Bind HomeTeamLogo}" Width="16" Height="16" Stretch="Uniform" />
                                                                    </Border>
                                                                </StackPanel>
                                                            </Button>

                                                            <Button
                                                                Grid.Column="2"
                                                                Background="Transparent"
                                                                BorderThickness="0"
                                                                Padding="0"
                                                                Tag="{x:Bind}"
                                                                Click="OnFixtureItemClicked"
                                                                VerticalAlignment="Center"
                                                                ToolTipService.ToolTip="Open Match Center">
                                                                <Border
                                                                    Background="#0F172A"
                                                                    BorderBrush="#1E293B"
                                                                    BorderThickness="1"
                                                                    CornerRadius="4"
                                                                    Padding="6,2"
                                                                    MinWidth="55"
                                                                    VerticalAlignment="Center">
                                                                    <TextBlock Text="{x:Bind ScoreOrTimeDisplay}" FontSize="10" FontWeight="Bold" Foreground="{x:Bind StatusBrush}" HorizontalAlignment="Center" />
                                                                </Border>
                                                            </Button>

                                                            <Button
                                                                Grid.Column="3"
                                                                Background="Transparent"
                                                                BorderThickness="0"
                                                                Padding="0"
                                                                Tag="{x:Bind}"
                                                                Click="OnFixtureAwayTeamClicked"
                                                                HorizontalAlignment="Left"
                                                                VerticalAlignment="Center"
                                                                ToolTipService.ToolTip="Open Team Hub">
                                                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                                    <Border Width="16" Height="16" VerticalAlignment="Center">
                                                                        <Image Source="{x:Bind AwayTeamLogo}" Width="16" Height="16" Stretch="Uniform" />
                                                                    </Border>
                                                                    <TextBlock Text="{x:Bind AwayTeamName}" FontSize="11" FontWeight="SemiBold" Foreground="{x:Bind AwayTeamForegroundBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                                </StackPanel>
                                                            </Button>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <Border
                                            Visibility="{x:Bind ViewModel.HubNoFixturesVisibility, Mode=OneWay}"
                                            Background="#0F172A"
                                            CornerRadius="6"
                                            Padding="20"
                                            HorizontalAlignment="Stretch">
                                            <StackPanel Spacing="6" HorizontalAlignment="Center">
                                                <TextBlock Text="📅" FontSize="22" HorizontalAlignment="Center" />
                                                <TextBlock Text="No Fixtures Available" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" />
                                                <TextBlock Text="No upcoming or recent fixtures found for this competition." FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>

                            <!-- SUB-TAB 2: KNOCKOUT BRACKET -->
                            <Grid
                                x:Name="KnockoutBracketContainer"
                                Visibility="{x:Bind ViewModel.HubKnockoutBracketSubTabVisibility, Mode=OneWay}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Spacing="10" Margin="0,0,0,10">
                                        <ItemsControl ItemsSource="{x:Bind ViewModel.CurrentKnockoutStages, Mode=OneWay}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="dto:KnockoutStageDto">
                                                    <StackPanel Spacing="6" Margin="0,0,0,10">
                                                        <TextBlock
                                                            Text="{x:Bind StageName}"
                                                            FontSize="11"
                                                            FontWeight="Bold"
                                                            Foreground="#38BDF8"
                                                            CharacterSpacing="40" />

                                                        <ItemsControl ItemsSource="{x:Bind Ties}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="dto:KnockoutTieDto">
                                                                    <Border
                                                                        Background="#0F172A"
                                                                        BorderBrush="#1E293B"
                                                                        BorderThickness="1"
                                                                        CornerRadius="6"
                                                                        Padding="8,5"
                                                                        Margin="0,0,0,4">
                                                                        <Grid ColumnSpacing="8">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="*" />
                                                                                <ColumnDefinition Width="Auto" />
                                                                                <ColumnDefinition Width="*" />
                                                                            </Grid.ColumnDefinitions>

                                                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                                                <TextBlock Text="{x:Bind HomeTeamName}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                                                <Border Width="16" Height="16" VerticalAlignment="Center">
                                                                                    <Image Source="{x:Bind HomeTeamLogo}" Width="16" Height="16" Stretch="Uniform" />
                                                                                </Border>
                                                                            </StackPanel>

                                                                            <Border
                                                                                Grid.Column="1"
                                                                                Background="#1E293B"
                                                                                CornerRadius="4"
                                                                                Padding="8,2"
                                                                                MinWidth="48"
                                                                                VerticalAlignment="Center">
                                                                                <TextBlock Text="{x:Bind ScoreOrStatus}" FontSize="10" FontWeight="Bold" Foreground="#F8FAFC" HorizontalAlignment="Center" />
                                                                            </Border>

                                                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                                                <Border Width="16" Height="16" VerticalAlignment="Center">
                                                                                    <Image Source="{x:Bind AwayTeamLogo}" Width="16" Height="16" Stretch="Uniform" />
                                                                                </Border>
                                                                                <TextBlock Text="{x:Bind AwayTeamName}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                                            </StackPanel>
                                                                        </Grid>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <Border
                                            Visibility="{x:Bind ViewModel.HubNoKnockoutVisibility, Mode=OneWay}"
                                            Background="#0F172A"
                                            CornerRadius="6"
                                            Padding="20"
                                            HorizontalAlignment="Stretch">
                                            <StackPanel Spacing="6" HorizontalAlignment="Center">
                                                <TextBlock Text="🏆" FontSize="22" HorizontalAlignment="Center" />
                                                <TextBlock Text="No Knockout Bracket" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" />
                                                <TextBlock Text="This competition does not feature a knockout tournament bracket (standard round-robin league format)." FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>

                            <!-- SUB-TAB 3: TOP SCORERS -->
                            <Grid
                                x:Name="TopScorersContainer"
                                Visibility="{x:Bind ViewModel.HubTopScorersSubTabVisibility, Mode=OneWay}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{x:Bind ViewModel.CurrentTopScorers, Mode=OneWay}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:PlayerStatLeaderItemViewModel">
                                                <Border
                                                    Background="#1E293B"
                                                    BorderBrush="#334155"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="12,8"
                                                    Margin="0,0,0,6">
                                                    <Grid ColumnSpacing="12">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="32" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Rank -->
                                                        <Border
                                                            Grid.Column="0"
                                                            Background="#0F172A"
                                                            CornerRadius="4"
                                                            Padding="4,2"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center">
                                                            <TextBlock
                                                                Text="{x:Bind RankDisplay}"
                                                                FontSize="11"
                                                                FontWeight="Bold"
                                                                Foreground="#38BDF8"
                                                                HorizontalAlignment="Center" />
                                                        </Border>

                                                        <!-- Player & Team Info -->
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                            <TextBlock
                                                                Text="{x:Bind PlayerName}"
                                                                FontSize="13"
                                                                FontWeight="Bold"
                                                                TextTrimming="CharacterEllipsis" />
                                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                                <Border Width="14" Height="14" Visibility="{x:Bind LogoVisibility, Mode=OneWay}" VerticalAlignment="Center">
                                                                    <Image Source="{x:Bind TeamLogoSource, Mode=OneWay}" Width="14" Height="14" Stretch="Uniform" />
                                                                </Border>
                                                                <TextBlock
                                                                    Text="{x:Bind TeamName}"
                                                                    FontSize="11"
                                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                    VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </StackPanel>

                                                        <!-- Goals Stat -->
                                                        <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="1">
                                                            <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                                                                <TextBlock
                                                                    Text="{x:Bind MainStatValue}"
                                                                    FontSize="16"
                                                                    FontWeight="Bold"
                                                                    Foreground="{x:Bind StatBrush}" />
                                                                <TextBlock
                                                                    Text="{x:Bind MainStatLabel}"
                                                                    FontSize="11"
                                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                    VerticalAlignment="Bottom"
                                                                    Margin="0,0,0,2" />
                                                            </StackPanel>
                                                            <TextBlock
                                                                Text="{x:Bind SubStatDisplay}"
                                                                FontSize="10"
                                                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                                HorizontalAlignment="Right"
                                                                Visibility="{x:Bind SubStatVisibility, Mode=OneWay}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>

                            <!-- SUB-TAB 2: TOP ASSISTS -->
                            <Grid
                                x:Name="TopAssistsContainer"
                                Visibility="{x:Bind ViewModel.HubTopAssistsSubTabVisibility, Mode=OneWay}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{x:Bind ViewModel.CurrentTopAssists, Mode=OneWay}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:PlayerStatLeaderItemViewModel">
                                                <Border
                                                    Background="#1E293B"
                                                    BorderBrush="#334155"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="12,8"
                                                    Margin="0,0,0,6">
                                                    <Grid ColumnSpacing="12">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="32" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Rank -->
                                                        <Border
                                                            Grid.Column="0"
                                                            Background="#0F172A"
                                                            CornerRadius="4"
                                                            Padding="4,2"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center">
                                                            <TextBlock
                                                                Text="{x:Bind RankDisplay}"
                                                                FontSize="11"
                                                                FontWeight="Bold"
                                                                Foreground="#10B981"
                                                                HorizontalAlignment="Center" />
                                                        </Border>

                                                        <!-- Player & Team Info -->
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                            <TextBlock
                                                                Text="{x:Bind PlayerName}"
                                                                FontSize="13"
                                                                FontWeight="Bold"
                                                                TextTrimming="CharacterEllipsis" />
                                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                                <Border Width="14" Height="14" Visibility="{x:Bind LogoVisibility, Mode=OneWay}" VerticalAlignment="Center">
                                                                    <Image Source="{x:Bind TeamLogoSource, Mode=OneWay}" Width="14" Height="14" Stretch="Uniform" />
                                                                </Border>
                                                                <TextBlock
                                                                    Text="{x:Bind TeamName}"
                                                                    FontSize="11"
                                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                    VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </StackPanel>

                                                        <!-- Assists Stat -->
                                                        <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="1">
                                                            <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                                                                <TextBlock
                                                                    Text="{x:Bind MainStatValue}"
                                                                    FontSize="16"
                                                                    FontWeight="Bold"
                                                                    Foreground="{x:Bind StatBrush}" />
                                                                <TextBlock
                                                                    Text="{x:Bind MainStatLabel}"
                                                                    FontSize="11"
                                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                    VerticalAlignment="Bottom"
                                                                    Margin="0,0,0,2" />
                                                            </StackPanel>
                                                            <TextBlock
                                                                Text="{x:Bind SubStatDisplay}"
                                                                FontSize="10"
                                                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                                HorizontalAlignment="Right"
                                                                Visibility="{x:Bind SubStatVisibility, Mode=OneWay}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>

            <!-- ======================================================== -->
            <!-- SECTION B, C, D: PREFERENCES & NOTIFICATION CONTROLS      -->
            <!-- ======================================================== -->
            <Border
                Grid.Column="1"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="18">

                        <!-- Search Header -->
                        <TextBlock
                            Text="Search &amp; Follow"
                            Style="{ThemeResource SubtitleTextBlockStyle}"
                            FontWeight="SemiBold" />

                        <!-- ======================================================== -->
                        <!-- SECTION B: CATALOG SEARCH & DISCOVERY                    -->
                        <!-- ======================================================== -->
                        <Border
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12">
                            <StackPanel Spacing="10">
                                <TextBlock
                                    Text="Search Catalog"
                                    FontWeight="SemiBold"
                                    FontSize="14" />
                                <TextBlock
                                    Text="Search the local database to follow clubs and competitions."
                                    FontSize="11"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap" />

                                <TextBox
                                    x:Name="CatalogSearchTextBox"
                                    PlaceholderText="Search clubs or leagues..."
                                    TextChanged="OnCatalogSearchTextChanged" />

                                <StackPanel Orientation="Horizontal" Spacing="16">
                                    <RadioButton
                                        x:Name="ScopeClubsRadio"
                                        Content="Clubs"
                                        IsChecked="True"
                                        Checked="OnSearchScopeChanged" />
                                    <RadioButton
                                        x:Name="ScopeLeaguesRadio"
                                        Content="Leagues &amp; Cups"
                                        Checked="OnSearchScopeChanged" />
                                </StackPanel>

                                <ProgressBar
                                    x:Name="CatalogSearchProgressBar"
                                    IsIndeterminate="True"
                                    Visibility="Collapsed"
                                    Height="2" />

                                <TextBlock
                                    x:Name="CatalogSearchStatusText"
                                    FontSize="11"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Visibility="Collapsed"
                                    TextWrapping="Wrap" />

                                <!-- Team Search Results -->
                                <ListView
                                    x:Name="TeamSearchResultsList"
                                    SelectionMode="None"
                                    MaxHeight="800"
                                    ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                    ScrollViewer.VerticalScrollMode="Disabled"
                                    Visibility="Collapsed">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="vm:FollowedTeamItemViewModel">
                                            <Grid Padding="4,4,4,4" ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Button
                                                    Grid.Column="0"
                                                    Grid.ColumnSpan="2"
                                                    Click="OnSearchTeamClicked"
                                                    Tag="{x:Bind}"
                                                    Style="{ThemeResource SubtleButtonStyle}"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Left"
                                                    Padding="4,2">
                                                    <Grid ColumnSpacing="10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="24" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Grid Grid.Column="0" Width="24" Height="24" VerticalAlignment="Center">
                                                            <Image
                                                                Width="24"
                                                                Height="24"
                                                                Source="{x:Bind LogoSource, Mode=OneWay}"
                                                                Visibility="{x:Bind LogoVisibility, Mode=OneWay}"
                                                                Stretch="Uniform" />
                                                            <TextBlock
                                                                Text="🛡️"
                                                                FontSize="14"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                Visibility="{x:Bind FallbackVisibility, Mode=OneWay}" />
                                                        </Grid>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock
                                                                Text="{x:Bind Name}"
                                                                FontWeight="SemiBold"
                                                                FontSize="13" />
                                                            <TextBlock
                                                                Text="{x:Bind Country}"
                                                                FontSize="11"
                                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Button>
                                                <Button
                                                    Grid.Column="2"
                                                    Content="{x:Bind FollowButtonText, Mode=OneWay}"
                                                    IsEnabled="{x:Bind CanFollow, Mode=OneWay}"
                                                    Tag="{x:Bind}"
                                                    Click="OnAddTeamClicked"
                                                    MinWidth="0"
                                                    Padding="8,4" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>

                                <!-- Competition Search Results -->
                                <ListView
                                    x:Name="CompetitionSearchResultsList"
                                    SelectionMode="None"
                                    MaxHeight="800"
                                    ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                    ScrollViewer.VerticalScrollMode="Disabled"
                                    Visibility="Collapsed">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="vm:FollowedCompetitionItemViewModel">
                                            <Grid Padding="4,4,4,4" ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Button
                                                    Grid.Column="0"
                                                    Grid.ColumnSpan="2"
                                                    Click="OnSearchCompetitionClicked"
                                                    Tag="{x:Bind}"
                                                    Style="{ThemeResource SubtleButtonStyle}"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Left"
                                                    Padding="4,2">
                                                    <Grid ColumnSpacing="10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="24" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Grid Grid.Column="0" Width="24" Height="24" VerticalAlignment="Center">
                                                            <Image
                                                                Width="24"
                                                                Height="24"
                                                                Source="{x:Bind LogoSource, Mode=OneWay}"
                                                                Visibility="{x:Bind LogoVisibility, Mode=OneWay}"
                                                                Stretch="Uniform" />
                                                            <TextBlock
                                                                Text="🏆"
                                                                FontSize="14"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                Visibility="{x:Bind FallbackVisibility, Mode=OneWay}" />
                                                        </Grid>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock
                                                                Text="{x:Bind Name}"
                                                                FontWeight="SemiBold"
                                                                FontSize="13" />
                                                            <TextBlock
                                                                Text="{x:Bind Country}"
                                                                FontSize="11"
                                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Button>
                                                <Button
                                                    Grid.Column="2"
                                                    Content="{x:Bind FollowButtonText, Mode=OneWay}"
                                                    IsEnabled="{x:Bind CanFollow, Mode=OneWay}"
                                                    Tag="{x:Bind}"
                                                    Click="OnAddCompetitionClicked"
                                                    MinWidth="0"
                                                    Padding="8,4" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Border>

                        <!-- ======================================================== -->
                        <!-- SECTION C: FOLLOWED CLUBS                                -->
                        <!-- ======================================================== -->
                        <Border
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12">
                            <StackPanel Spacing="10">
                                <TextBlock
                                    Text="Followed Clubs"
                                    FontWeight="SemiBold"
                                    FontSize="14" />
                                <TextBlock
                                    Text="Live matches of followed teams take highest priority on the taskbar."
                                    FontSize="11"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap" />

                                <TextBlock
                                    x:Name="NoFollowedTeamsText"
                                    Text="No clubs followed yet. Search above to add clubs."
                                    FontSize="11"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Visibility="Collapsed" />

                                <ListView
                                    x:Name="TeamsList"
                                    SelectionMode="None"
                                    MaxHeight="240">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="vm:FollowedTeamItemViewModel">
                                            <Grid Padding="4,4,4,4" ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Button
                                                    Grid.Column="0"
                                                    Grid.ColumnSpan="2"
                                                    Click="OnFollowedTeamClicked"
                                                    Tag="{x:Bind}"
                                                    Style="{ThemeResource SubtleButtonStyle}"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Left"
                                                    Padding="4,2">
                                                    <Grid ColumnSpacing="10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="24" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Grid Grid.Column="0" Width="24" Height="24" VerticalAlignment="Center">
                                                            <Image
                                                                Width="24"
                                                                Height="24"
                                                                Source="{x:Bind LogoSource, Mode=OneWay}"
                                                                Visibility="{x:Bind LogoVisibility, Mode=OneWay}"
                                                                Stretch="Uniform" />
                                                            <TextBlock
                                                                Text="🛡️"
                                                                FontSize="14"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                Visibility="{x:Bind FallbackVisibility, Mode=OneWay}" />
                                                        </Grid>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock
                                                                Text="{x:Bind Name}"
                                                                FontWeight="SemiBold"
                                                                FontSize="13" />
                                                            <TextBlock
                                                                Text="{x:Bind Country}"
                                                                FontSize="11"
                                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Button>
                                                <Button
                                                    Grid.Column="2"
                                                    Content="🔔"
                                                    ToolTipService.ToolTip="Configure Alert Profile"
                                                    Tag="{x:Bind}"
                                                    Click="OnEntityAlertsClicked"
                                                    Style="{ThemeResource SubtleButtonStyle}"
                                                    Padding="6,4"
                                                    Margin="2,0" />
                                                <Button
                                                    Grid.Column="3"
                                                    Content="Remove"
                                                    Tag="{x:Bind Id}"
                                                    Click="OnRemoveTeamClicked"
                                                    MinWidth="0"
                                                    Padding="8,4" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Border>

                        <!-- ======================================================== -->
                        <!-- SECTION D: FOLLOWED COMPETITIONS                         -->
                        <!-- ======================================================== -->
                        <Border
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12">
                            <StackPanel Spacing="10">
                                <TextBlock
                                    Text="Followed Competitions"
                                    FontWeight="SemiBold"
                                    FontSize="14" />
                                <TextBlock
                                    Text="Matches from followed competitions appear under Following and trigger match alerts."
                                    FontSize="11"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap" />

                                <TextBlock
                                    x:Name="NoFollowedCompetitionsText"
                                    Text="No competitions followed yet. Search above to add leagues."
                                    FontSize="11"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Visibility="Collapsed" />

                                <ListView
                                    x:Name="CompetitionsList"
                                    SelectionMode="None"
                                    MaxHeight="240">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="vm:FollowedCompetitionItemViewModel">
                                            <Grid Padding="4,4,4,4" ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Button
                                                    Grid.Column="0"
                                                    Grid.ColumnSpan="2"
                                                    Click="OnFollowedCompetitionClicked"
                                                    Tag="{x:Bind}"
                                                    Style="{ThemeResource SubtleButtonStyle}"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Left"
                                                    Padding="4,2">
                                                    <Grid ColumnSpacing="10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="24" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Grid Grid.Column="0" Width="24" Height="24" VerticalAlignment="Center">
                                                            <Image
                                                                Width="24"
                                                                Height="24"
                                                                Source="{x:Bind LogoSource, Mode=OneWay}"
                                                                Visibility="{x:Bind LogoVisibility, Mode=OneWay}"
                                                                Stretch="Uniform" />
                                                            <TextBlock
                                                                Text="🏆"
                                                                FontSize="14"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                Visibility="{x:Bind FallbackVisibility, Mode=OneWay}" />
                                                        </Grid>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock
                                                                Text="{x:Bind Name}"
                                                                FontWeight="SemiBold"
                                                                FontSize="13" />
                                                            <TextBlock
                                                                Text="{x:Bind Country}"
                                                                FontSize="11"
                                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Button>
                                                <Button
                                                    Grid.Column="2"
                                                    Content="🔔"
                                                    ToolTipService.ToolTip="Configure Alert Profile"
                                                    Tag="{x:Bind}"
                                                    Click="OnEntityAlertsClicked"
                                                    Style="{ThemeResource SubtleButtonStyle}"
                                                    Padding="6,4"
                                                    Margin="2,0" />
                                                <Button
                                                    Grid.Column="3"
                                                    Content="Remove"
                                                    Tag="{x:Bind Id}"
                                                    Click="OnRemoveCompetitionClicked"
                                                    MinWidth="0"
                                                    Padding="8,4" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>
