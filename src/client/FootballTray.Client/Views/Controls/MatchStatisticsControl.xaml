<UserControl
    x:Class="FootballTray.Client.Views.Controls.MatchStatisticsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:FootballTray.Client.ViewModels"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Teams Legend -->
        <Grid Grid.Row="0" Margin="4,0,4,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                Text="{Binding HomeTeamName}"
                FontSize="12"
                FontWeight="Bold"
                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                HorizontalAlignment="Left" />

            <TextBlock
                Grid.Column="1"
                Text="Team Comparison"
                FontSize="11"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                HorizontalAlignment="Center" />

            <TextBlock
                Grid.Column="2"
                Text="{Binding AwayTeamName}"
                FontSize="12"
                FontWeight="Bold"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                HorizontalAlignment="Right" />
        </Grid>

        <!-- Stats List -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="10">
                <ItemsControl x:Name="StatsItemsControl" ItemsSource="{Binding MatchStats}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:StatComparisonViewModel">
                            <Border
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12,8,12,8"
                                Margin="0,0,0,6">
                                <StackPanel Spacing="4">
                                    <!-- Values and Label -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock
                                            Grid.Column="0"
                                            Text="{x:Bind HomeValue}"
                                            FontWeight="Bold"
                                            FontSize="13"
                                            HorizontalAlignment="Left" />

                                        <TextBlock
                                            Grid.Column="1"
                                            Text="{x:Bind Name}"
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            HorizontalAlignment="Center" />

                                        <TextBlock
                                            Grid.Column="2"
                                            Text="{x:Bind AwayValue}"
                                            FontWeight="Bold"
                                            FontSize="13"
                                            HorizontalAlignment="Right" />
                                    </Grid>

                                    <!-- Dual Comparative Progress Bars -->
                                    <Grid Height="6" Margin="0,2,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Home Bar (Accent Fill) -->
                                        <ProgressBar
                                            Grid.Column="0"
                                            Value="{x:Bind HomeRatio}"
                                            Maximum="100"
                                            FlowDirection="RightToLeft"
                                            Height="6"
                                            CornerRadius="3"
                                            Foreground="{ThemeResource AccentFillColorDefaultBrush}" />

                                        <!-- Away Bar (Secondary Fill) -->
                                        <ProgressBar
                                            Grid.Column="2"
                                            Value="{x:Bind AwayRatio}"
                                            Maximum="100"
                                            FlowDirection="LeftToRight"
                                            Height="6"
                                            CornerRadius="3"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Empty Stats Message -->
                <Border
                    x:Name="NoStatsBorder"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="20"
                    Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center" Spacing="6">
                        <TextBlock
                            Text="📊 Statistics Unavailable"
                            FontWeight="SemiBold"
                            FontSize="14"
                            HorizontalAlignment="Center" />
                        <TextBlock
                            Text="Detailed match statistics will be published once recorded during live play."
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            HorizontalAlignment="Center"
                            TextWrapping="Wrap"
                            TextAlignment="Center" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
