<Page
    x:Class="FootballTray.Client.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prefs="using:FootballTray.Client.Services.Preferences"
    xmlns:vm="using:FootballTray.Client.ViewModels"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Margin="24,16,24,24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button
                x:Name="BackButton"
                Click="OnBackClicked"
                Margin="0,0,16,0"
                VerticalAlignment="Center"
                ToolTipService.ToolTip="Back to matches">
                <FontIcon Glyph="&#xE72B;" FontSize="16" />
            </Button>

            <TextBlock
                Grid.Column="1"
                Text="Settings &amp; Preferences"
                FontSize="24"
                FontWeight="SemiBold"
                VerticalAlignment="Center" />
        </Grid>

        <!-- Content ScrollViewer -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="20" MaxWidth="760" HorizontalAlignment="Left">

                <!-- ======================================================== -->
                <!-- CARD 1: DISPLAY                                          -->
                <!-- ======================================================== -->
                <Border
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                    <StackPanel Spacing="14">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE790;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="Display" FontSize="16" FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock
                            Text="Configure taskbar ticker rotation and global match time representation."
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />

                        <!-- Auto-Rotate Ticker (Carousel Mode) -->
                        <ToggleSwitch
                            x:Name="TickerCarouselToggle"
                            Header="Auto-Rotate Ticker"
                            Toggled="OnTickerCarouselToggled" />

                        <!-- Auto-Rotate Mode -->
                        <StackPanel x:Name="TickerRotationScopePanel" Spacing="6" Margin="0,2,0,0">
                            <TextBlock Text="Auto-Rotate Mode" FontWeight="Medium" FontSize="13" />
                            <ComboBox x:Name="TickerRotationScopeCombo" SelectionChanged="OnTickerRotationScopeChanged" Width="260" IsEnabled="{x:Bind TickerCarouselToggle.IsOn, Mode=OneWay}">
                                <ComboBoxItem Tag="FollowedLive">⭐ Followed Live</ComboBoxItem>
                                <ComboBoxItem Tag="AllFollowed">📅 All Followed</ComboBoxItem>
                                <ComboBoxItem Tag="AllLive">🔴 All Live</ComboBoxItem>
                                <ComboBoxItem Tag="CustomQueue">📋 Custom Queue</ComboBoxItem>
                            </ComboBox>
                        </StackPanel>
                        <!-- Custom Queue Matches -->
                        <StackPanel x:Name="CustomQueueMatchesSection" Spacing="8" Margin="0,6,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="📋 Custom Queue Matches" FontWeight="Medium" FontSize="13" VerticalAlignment="Center" />
                                <Button
                                    Grid.Column="1"
                                    Content="Clear Queue"
                                    Click="OnClearCustomQueueClicked"
                                    Padding="8,3"
                                    FontSize="11"
                                    Style="{ThemeResource SubtleButtonStyle}" />
                            </Grid>
                            <TextBlock
                                Text="Matches rotate in this sequence when Custom Queue mode is active. Drag to reorder, or use the arrow buttons."
                                FontSize="11"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap" />

                            <TextBlock
                                x:Name="NoCustomQueueMatchesText"
                                Text="No matches in custom queue. Pin matches from the match cards to build your queue."
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Visibility="Collapsed"
                                FontSize="12" />

                            <ItemsControl
                                x:Name="CustomQueueMatchesItemsControl"
                                ItemsSource="{x:Bind ViewModel.CustomQueueMatches, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:CustomQueueMatchItemViewModel">
                                        <Border
                                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="8,6"
                                            Margin="0,0,0,4">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Index Badge -->
                                                <Border
                                                    Grid.Column="0"
                                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                    CornerRadius="4"
                                                    Padding="6,2"
                                                    VerticalAlignment="Center">
                                                    <TextBlock
                                                        Text="{x:Bind IndexBadge, Mode=OneWay}"
                                                        FontSize="11"
                                                        FontWeight="Bold"
                                                        Foreground="#FFFFFF" />
                                                </Border>

                                                <!-- Match Title & Competition -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock
                                                        Text="{x:Bind MatchTitle}"
                                                        FontWeight="SemiBold"
                                                        FontSize="12"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <TextBlock
                                                        Text="{x:Bind CompetitionName}"
                                                        FontSize="10"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        TextTrimming="CharacterEllipsis" />
                                                </StackPanel>

                                                <!-- Status -->
                                                <Border
                                                    Grid.Column="2"
                                                    Background="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    CornerRadius="4"
                                                    Padding="6,2"
                                                    VerticalAlignment="Center">
                                                    <TextBlock
                                                        Text="{x:Bind StatusText, Mode=OneWay}"
                                                        FontSize="10"
                                                        FontWeight="SemiBold" />
                                                </Border>

                                                <!-- Move Up / Down -->
                                                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                                    <Button
                                                        Content="↑"
                                                        Tag="{x:Bind MatchId}"
                                                        Click="OnMoveQueueMatchUpClicked"
                                                        ToolTipService.ToolTip="Move Up"
                                                        Padding="6,2"
                                                        FontSize="11"
                                                        Style="{ThemeResource SubtleButtonStyle}" />
                                                    <Button
                                                        Content="↓"
                                                        Tag="{x:Bind MatchId}"
                                                        Click="OnMoveQueueMatchDownClicked"
                                                        ToolTipService.ToolTip="Move Down"
                                                        Padding="6,2"
                                                        FontSize="11"
                                                        Style="{ThemeResource SubtleButtonStyle}" />
                                                </StackPanel>

                                                <!-- Remove / Unpin -->
                                                <Button
                                                    Grid.Column="4"
                                                    Content="✕"
                                                    Tag="{x:Bind MatchId}"
                                                    Click="OnRemoveQueueMatchClicked"
                                                    ToolTipService.ToolTip="Remove from queue"
                                                    Padding="6,2"
                                                    FontSize="11"
                                                    Style="{ThemeResource SubtleButtonStyle}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- 24-Hour Time Format -->
                        <ToggleSwitch
                            x:Name="TimeFormat24HourToggle"
                            Header="24-Hour Time Format (e.g. 18:30 vs 6:30 PM)"
                            Toggled="OnTimeFormat24HourToggled" />
                    </StackPanel>
                </Border>



                <!-- ======================================================== -->
                <!-- CARD 2: NOTIFICATIONS                                    -->
                <!-- ======================================================== -->
                <Border
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                    <StackPanel Spacing="14">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xEA8F;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="Notifications" FontSize="16" FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock
                            Text="Desktop match kickoff reminders, score toasts, and stadium alert audio."
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />

                        <!-- Match Kickoff Reminders -->
                        <ToggleSwitch
                            x:Name="KickoffReminderToggle"
                            Header="Match Kickoff Reminders"
                            Toggled="OnKickoffReminderToggled" />

                        <!-- Kickoff Reminder Lead Time Offset -->
                        <StackPanel x:Name="KickoffLeadTimePanel" Spacing="6" Margin="0,2,0,0">
                            <TextBlock Text="Kickoff Reminder Offset" FontWeight="Medium" FontSize="13" />
                            <ComboBox x:Name="KickoffLeadTimeCombo" SelectionChanged="OnKickoffLeadTimeChanged" Width="240">
                                <ComboBoxItem Tag="0">At kickoff (0 min)</ComboBoxItem>
                                <ComboBoxItem Tag="5">5 minutes before</ComboBoxItem>
                                <ComboBoxItem Tag="15">15 minutes before</ComboBoxItem>
                                <ComboBoxItem Tag="30">30 minutes before</ComboBoxItem>
                                <ComboBoxItem Tag="60">1 hour before</ComboBoxItem>
                            </ComboBox>
                        </StackPanel>

                        <MenuFlyoutSeparator Margin="0,4,0,4" />

                        <!-- Desktop Notifications Toggle -->
                        <ToggleSwitch
                            x:Name="GlobalNotificationsToggle"
                            Header="Global Desktop Toast Notifications"
                            Toggled="OnGlobalNotificationsToggled" />

                        <!-- Granular Alert Categories -->
                        <TextBlock Text="Alert Categories" FontWeight="Medium" FontSize="13" Margin="0,4,0,0" />
                        <StackPanel x:Name="NotificationCategoriesPanel" Spacing="6" Margin="4,0,0,0">
                            <ToggleSwitch
                                x:Name="GoalNotificationsToggle"
                                Header="Goal Alerts (Scores &amp; Scorers)"
                                Toggled="OnGoalNotificationsToggled" />
                            <ToggleSwitch
                                x:Name="CardNotificationsToggle"
                                Header="Red Cards &amp; Ejections"
                                Toggled="OnCardNotificationsToggled" />
                            <ToggleSwitch
                                x:Name="MatchStartNotificationsToggle"
                                Header="Match Kickoff / Start"
                                Toggled="OnMatchStartNotificationsToggled" />
                            <ToggleSwitch
                                x:Name="HalfTimeNotificationsToggle"
                                Header="Half-Time (HT)"
                                Toggled="OnHalfTimeNotificationsToggled" />
                            <ToggleSwitch
                                x:Name="FullTimeNotificationsToggle"
                                Header="Full-Time (FT)"
                                Toggled="OnFullTimeNotificationsToggled" />
                            <ToggleSwitch
                                x:Name="PostponedNotificationsToggle"
                                Header="Match Postponed / Rescheduled"
                                Toggled="OnPostponedNotificationsToggled" />
                            <ToggleSwitch
                                x:Name="CancelledNotificationsToggle"
                                Header="Match Cancelled"
                                Toggled="OnCancelledNotificationsToggled" />
                        </StackPanel>

                        <MenuFlyoutSeparator Margin="0,4,0,4" />

                        <!-- Sound Mode Selector -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="Notification Sound Alert" FontWeight="Medium" FontSize="13" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MaxWidth="280" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox
                                    Grid.Column="0"
                                    x:Name="SoundModeCombo"
                                    HorizontalAlignment="Stretch"
                                    SelectionChanged="OnSoundModeChanged">
                                    <ComboBoxItem Tag="Off">Mute (No Sound)</ComboBoxItem>
                                    <ComboBoxItem Tag="SystemDefault">Windows Default Sound</ComboBoxItem>
                                    <ComboBoxItem Tag="Custom">Authentic Stadium Sounds</ComboBoxItem>
                                </ComboBox>
                                <Button
                                    Grid.Column="1"
                                    x:Name="TestSoundButton"
                                    Content="🔊 Test Sound"
                                    Click="OnTestSoundClicked" />
                            </Grid>
                        </StackPanel>
                        <MenuFlyoutSeparator Margin="0,4,0,4" />

                        <!-- Followed Entity Alert Overrides -->
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xEA8F;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock Text="Per-Club &amp; Per-Competition 🔔 Alert Overrides" FontWeight="Medium" FontSize="13" />
                            </StackPanel>
                            <TextBlock
                                Text="Customize or mute goal, card, and kickoff alerts for individual clubs and competitions."
                                FontSize="11"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap" />

                            <TextBlock
                                x:Name="NoFollowedEntityAlertsText"
                                Text="No clubs or competitions followed yet. Follow teams or leagues from Search to set custom alert profiles."
                                FontSize="11"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Visibility="Collapsed" />

                            <ListView
                                x:Name="EntityAlertOverridesListView"
                                SelectionMode="None"
                                MaxHeight="300"
                                ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:FollowedEntityAlertItemViewModel">
                                        <Border
                                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="10,6"
                                            Margin="0,0,0,4">
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Type Badge (🛡️ Club / 🏆 Competition) -->
                                                <Border
                                                    Grid.Column="0"
                                                    Background="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    CornerRadius="4"
                                                    Padding="5,2"
                                                    VerticalAlignment="Center">
                                                    <TextBlock
                                                        Text="{x:Bind TypeBadge}"
                                                        FontSize="11"
                                                        FontWeight="SemiBold" />
                                                </Border>

                                                <!-- Name -->
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Text="{x:Bind Name}"
                                                    FontWeight="SemiBold"
                                                    FontSize="12"
                                                    VerticalAlignment="Center"
                                                    TextTrimming="CharacterEllipsis" />

                                                <!-- Status Badge -->
                                                <Border
                                                    Grid.Column="2"
                                                    Background="{ThemeResource LayerFillColorAltBrush}"
                                                    CornerRadius="4"
                                                    Padding="6,2"
                                                    VerticalAlignment="Center">
                                                    <TextBlock
                                                        Text="{x:Bind StatusBadge, Mode=OneWay}"
                                                        FontSize="11"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </Border>

                                                <!-- Configure Button -->
                                                <Button
                                                    Grid.Column="3"
                                                    Content="🔔 Configure Alerts"
                                                    Tag="{x:Bind}"
                                                    Click="OnConfigureEntityAlertsClicked"
                                                    Padding="8,4"
                                                    FontSize="11" />

                                                <!-- Reset Button -->
                                                <Button
                                                    Grid.Column="4"
                                                    Content="Reset to Global"
                                                    Tag="{x:Bind}"
                                                    Click="OnResetEntityAlertClicked"
                                                    IsEnabled="{x:Bind CanReset, Mode=OneWay}"
                                                    Padding="8,4"
                                                    FontSize="11"
                                                    Style="{ThemeResource SubtleButtonStyle}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ======================================================== -->
                <!-- CARD 3: SYSTEM                                           -->
                <!-- ======================================================== -->
                <Border
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                    <StackPanel Spacing="14">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE770;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="System" FontSize="16" FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock
                            Text="Configure Windows system integration and automated background startup."
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />

                        <!-- Run at Startup -->
                        <ToggleSwitch
                            x:Name="RunAtStartupToggle"
                            Header="Run at Startup (Start in Tray automatically on login)"
                            Toggled="OnRunAtStartupToggled" />
                    </StackPanel>
                </Border>

                <!-- ======================================================== -->
                <!-- CARD 4: UPDATES & DIAGNOSTICS                            -->
                <!-- ======================================================== -->
                <Border
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                    <StackPanel Spacing="16">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE9D9;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="Updates &amp; Diagnostics" FontSize="16" FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock
                            Text="Inspect system health telemetry, verify updates, and manage diagnostic logs."
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />

                        <!-- Software Updates Section -->
                        <Border
                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12">
                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE895;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock Text="Software Updates" FontWeight="SemiBold" FontSize="13" />
                                </StackPanel>

                                <TextBlock
                                    x:Name="UpdateCurrentVersionText"
                                    Text="Current Version: Loading..."
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                <!-- Update Available Banner -->
                                <Border
                                    x:Name="UpdateAvailablePanel"
                                    Visibility="Collapsed"
                                    Background="{ThemeResource LayerFillColorAltBrush}"
                                    BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10">
                                    <StackPanel Spacing="6">
                                        <TextBlock
                                            x:Name="UpdateTargetVersionText"
                                            Text="Version v1.1.0 available"
                                            FontWeight="Bold"
                                            FontSize="12" />
                                        <TextBlock
                                            x:Name="UpdateReleaseNotesText"
                                            TextWrapping="Wrap"
                                            FontSize="11"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <ProgressBar
                                            x:Name="UpdateDownloadProgressBar"
                                            Visibility="Collapsed"
                                            Minimum="0"
                                            Maximum="100" />
                                        <TextBlock
                                            x:Name="UpdateDownloadStatusText"
                                            Visibility="Collapsed"
                                            FontSize="11" />
                                        <Button
                                            x:Name="DownloadUpdateButton"
                                            Content="Download update"
                                            Style="{ThemeResource AccentButtonStyle}"
                                            Click="OnDownloadUpdateClicked" />
                                        <Button
                                            x:Name="InstallUpdateButton"
                                            Content="Install update"
                                            Style="{ThemeResource AccentButtonStyle}"
                                            Visibility="Collapsed"
                                            Click="OnInstallUpdateClicked" />
                                    </StackPanel>
                                </Border>

                                <TextBlock
                                    x:Name="UpdateStatusText"
                                    Visibility="Collapsed"
                                    FontSize="11"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap" />

                                <Button
                                    x:Name="CheckForUpdatesButton"
                                    Content="Check for updates"
                                    Click="OnCheckForUpdatesClicked"
                                    HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>

                        <!-- System Health Readout -->
                        <Border
                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12">
                            <StackPanel Spacing="8">
                                <TextBlock Text="System Health Readout" FontWeight="SemiBold" FontSize="13" />

                                <Grid ColumnSpacing="12" RowSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="100" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Status:" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="HealthStatusText" Text="Healthy" FontWeight="SemiBold" FontSize="12" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Last Sync:" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="LastSyncText" Text="Never" FontSize="12" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="ETag:" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="LastEtagText" Text="None" FontSize="12" TextTrimming="CharacterEllipsis" />

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Taskbar Host:" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="TaskbarStatusText" Text="Attached" FontSize="12" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Verbose Logging & Diagnostics Actions -->
                        <ToggleSwitch
                            x:Name="DebugLoggingToggle"
                            Header="Enable Verbose Debug Logging"
                            Toggled="OnDebugLoggingToggled" />

                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button
                                Content="📁 Open Logs Folder"
                                Click="OnOpenLogsClicked" />
                            <Button
                                x:Name="CopyDiagnosticsButton"
                                Content="📋 Copy Diagnostics"
                                Click="OnCopyDiagnosticsClicked" />
                        </StackPanel>

                        <TextBlock
                            x:Name="DiagnosticsCopyStatusText"
                            Visibility="Collapsed"
                            FontSize="11"
                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- ======================================================== -->
                <!-- CARD 5: FOLLOWED FAVORITES                               -->
                <!-- ======================================================== -->
                <Border
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                    <StackPanel Spacing="14">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE734;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="Followed Favorites" FontSize="16" FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock
                            Text="Manage your tracked clubs and competitions."
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />

                        <!-- Followed Teams -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="Followed Clubs" FontWeight="SemiBold" FontSize="13" />
                            <ListView
                                x:Name="FollowedTeamsListView"
                                SelectionMode="None"
                                ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                ScrollViewer.VerticalScrollMode="Disabled">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="prefs:FollowedTeam">
                                        <Grid Padding="4,4,4,4" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center" FontWeight="Medium" FontSize="13" />
                                            <Button
                                                Grid.Column="1"
                                                Content="Unfollow"
                                                Tag="{x:Bind Id}"
                                                Click="OnUnfollowTeamClicked"
                                                Padding="8,4" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <TextBlock
                                x:Name="NoFollowedTeamsText"
                                Text="No clubs followed yet. Use the Search tab on the home screen."
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Visibility="Collapsed"
                                FontSize="12" />
                        </StackPanel>

                        <!-- Followed Competitions -->
                        <StackPanel Spacing="6" Margin="0,8,0,0">
                            <TextBlock Text="Followed Competitions" FontWeight="SemiBold" FontSize="13" />
                            <ListView
                                x:Name="FollowedCompetitionsListView"
                                SelectionMode="None"
                                ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                ScrollViewer.VerticalScrollMode="Disabled">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="prefs:FollowedCompetition">
                                        <Grid Padding="4,4,4,4" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind DisplayName}" VerticalAlignment="Center" FontWeight="Medium" FontSize="13" />
                                            <Button
                                                Grid.Column="1"
                                                Content="Unfollow"
                                                Tag="{x:Bind Id}"
                                                Click="OnUnfollowCompetitionClicked"
                                                Padding="8,4" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <TextBlock
                                x:Name="NoFollowedCompetitionsText"
                                Text="No competitions followed yet. Use the Search tab on the home screen."
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Visibility="Collapsed"
                                FontSize="12" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ======================================================== -->
                <!-- CARD 6: ABOUT, PRIVACY POLICY & LEGAL DISCLAIMER         -->
                <!-- ======================================================== -->
                <Border
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                    <StackPanel Spacing="14">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE946;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="About &amp; Privacy Policy" FontSize="16" FontWeight="SemiBold" />
                            <Border
                                Background="{ThemeResource LayerFillColorAltBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="6,2"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center">
                                <TextBlock Text="v1.3.1" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            </Border>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <HyperlinkButton
                                Content="Privacy Policy"
                                NavigateUri="https://github.com/bo3abed505/FootballBar-Releases/blob/main/PRIVACY.md"
                                Padding="0"
                                FontSize="12" />
                            <HyperlinkButton
                                Content="Support &amp; Releases"
                                NavigateUri="https://github.com/bo3abed505/FootballBar-Releases"
                                Padding="0"
                                FontSize="12" />
                        </StackPanel>

                        <Border
                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12">
                            <StackPanel Spacing="8">
                                <TextBlock
                                    Text="Privacy Commitment"
                                    FontWeight="SemiBold"
                                    FontSize="12" />
                                <TextBlock
                                    Text="FootballBar collects, transmits, or sells zero personal user data or telemetry about the user. All user preferences, followed clubs, notification alert profiles, and local match caches are stored strictly locally on your device under %LOCALAPPDATA%\FootballTray. Outbound network requests are used solely to fetch public football match scores, schedules, standings, and update manifests."
                                    FontSize="11"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap" />

                                <TextBlock
                                    Text="Informational Trademark Disclaimer"
                                    FontWeight="SemiBold"
                                    FontSize="12"
                                    Margin="0,4,0,0" />
                                <TextBlock
                                    Text="All club names, competition names, crests, and brands are property of their respective owners and are used strictly for factual, informational identification purposes. FootballBar is an independent desktop utility and is not affiliated with or endorsed by FIFA, UEFA, or any football club or league."
                                    FontSize="11"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
