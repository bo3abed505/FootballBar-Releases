<Window
    x:Class="FootballTray.Client.Views.MatchCenterWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:FootballTray.Client.ViewModels"
    xmlns:controls="using:FootballTray.Client.Views.Controls"
    mc:Ignorable="d"
    Title="Match Center">

    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="20">
        <Grid.RowDefinitions>
            <!-- Row 0: Competition & Status Header -->
            <RowDefinition Height="Auto" />
            <!-- Row 1: Scoreboard Card -->
            <RowDefinition Height="Auto" />
            <!-- Row 2: Main Split Content (Timeline & Details) -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: Competition & Status -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock
                        x:Name="CompetitionText"
                        Text="{Binding CompetitionName}"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Button
                        x:Name="CompetitionStarButton"
                        Style="{ThemeResource SubtleButtonStyle}"
                        Padding="4,2"
                        MinHeight="0"
                        MinWidth="0"
                        Click="OnToggleCompetitionStarClicked"
                        ToolTipService.ToolTip="Follow Competition">
                        <FontIcon
                            x:Name="CompetitionStarIcon"
                            Glyph="{x:Bind ViewModel.CompetitionStarGlyph, Mode=OneWay}"
                            FontSize="12"
                            Opacity="{x:Bind ViewModel.CompetitionStarOpacity, Mode=OneWay}"
                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    </Button>
                </StackPanel>
                <TextBlock
                    x:Name="VenueText"
                    Text="{x:Bind ViewModel.VenueText, Mode=OneWay}"
                    FontSize="11"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Visibility="{x:Bind ViewModel.VenueVisibility, Mode=OneWay}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button
                    x:Name="PinButton"
                    Style="{ThemeResource SubtleButtonStyle}"
                    Padding="6,4"
                    Click="OnTogglePinClicked"
                    ToolTipService.ToolTip="Pin to taskbar">
                    <FontIcon
                        x:Name="PinIcon"
                        Glyph="{x:Bind ViewModel.PinGlyph, Mode=OneWay}"
                        FontSize="14"
                        Opacity="{x:Bind ViewModel.PinGlyphOpacity, Mode=OneWay}"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                </Button>

                <Border
                    x:Name="StatusBadge"
                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                    CornerRadius="6"
                    Padding="10,4,10,4"
                    VerticalAlignment="Center">
                    <TextBlock
                        x:Name="StatusText"
                        Text="{Binding StatusText}"
                        FontSize="12"
                        FontWeight="Bold"
                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                </Border>
            </StackPanel>
        </Grid>

        <!-- Score Board Card -->
        <Border
            Grid.Row="1"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="16"
            Margin="0,0,0,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- ROW 0: Team Headers & Score Row (Fixed Baseline) -->
                <!-- Home Team Header -->
                <StackPanel Grid.Row="0" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4">
                    <Image
                        x:Name="HomeTeamLogo"
                        Width="56"
                        Height="56"
                        Stretch="Uniform"
                        HorizontalAlignment="Center"
                        Visibility="Collapsed" />
                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                        <TextBlock
                            x:Name="HomeTeamName"
                            Text="{x:Bind ViewModel.HomeTeamName, Mode=OneWay}"
                            FontSize="18"
                            FontWeight="Bold"
                            HorizontalAlignment="Center"
                            TextAlignment="Center" />
                        <Button
                            x:Name="HomeStarButton"
                            Style="{ThemeResource SubtleButtonStyle}"
                            Padding="4,2"
                            MinHeight="0"
                            MinWidth="0"
                            VerticalAlignment="Center"
                            Click="OnToggleHomeStarClicked"
                            ToolTipService.ToolTip="Follow Team">
                            <FontIcon
                                x:Name="HomeStarIcon"
                                Glyph="{x:Bind ViewModel.HomeStarGlyph, Mode=OneWay}"
                                FontSize="13"
                                Opacity="{x:Bind ViewModel.HomeStarOpacity, Mode=OneWay}"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        </Button>
                    </StackPanel>
                    <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="4" Padding="6,1" HorizontalAlignment="Center" Margin="0,2,0,0">
                        <TextBlock Text="HOME" FontSize="9" FontWeight="Bold" Foreground="#38BDF8" CharacterSpacing="60" />
                    </Border>
                </StackPanel>

                <!-- Center Scoreboard -->
                <StackPanel Grid.Row="0" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24,0,24,0">
                    <TextBlock
                        x:Name="ScoreText"
                        Text="{x:Bind ViewModel.ScoreText, Mode=OneWay}"
                        FontSize="36"
                        FontWeight="Bold"
                        HorizontalAlignment="Center" />
                    <TextBlock
                        x:Name="HalfTimeText"
                        Text="{x:Bind ViewModel.HalfTimeText, Mode=OneWay}"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        HorizontalAlignment="Center"
                        Margin="0,2,0,0" />
                    <Border
                        x:Name="AggregateBadge"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="8,2,8,2"
                        Margin="0,4,0,0"
                        HorizontalAlignment="Center"
                        Visibility="Collapsed">
                        <TextBlock
                            x:Name="AggregateText"
                            Text="{x:Bind ViewModel.AggregateText, Mode=OneWay}"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Border>
                </StackPanel>

                <!-- Away Team Header -->
                <StackPanel Grid.Row="0" Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4">
                    <Image
                        x:Name="AwayTeamLogo"
                        Width="56"
                        Height="56"
                        Stretch="Uniform"
                        HorizontalAlignment="Center"
                        Visibility="Collapsed" />
                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                        <TextBlock
                            x:Name="AwayTeamName"
                            Text="{x:Bind ViewModel.AwayTeamName, Mode=OneWay}"
                            FontSize="18"
                            FontWeight="Bold"
                            HorizontalAlignment="Center"
                            TextAlignment="Center" />
                        <Button
                            x:Name="AwayStarButton"
                            Style="{ThemeResource SubtleButtonStyle}"
                            Padding="4,2"
                            MinHeight="0"
                            MinWidth="0"
                            VerticalAlignment="Center"
                            Click="OnToggleAwayStarClicked"
                            ToolTipService.ToolTip="Follow Team">
                            <FontIcon
                                x:Name="AwayStarIcon"
                                Glyph="{x:Bind ViewModel.AwayStarGlyph, Mode=OneWay}"
                                FontSize="13"
                                Opacity="{x:Bind ViewModel.AwayStarOpacity, Mode=OneWay}"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        </Button>
                    </StackPanel>
                    <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="4" Padding="6,1" HorizontalAlignment="Center" Margin="0,2,0,0">
                        <TextBlock Text="AWAY" FontSize="9" FontWeight="Bold" Foreground="#F87171" CharacterSpacing="60" />
                    </Border>
                </StackPanel>

                <!-- ROW 1: Goalscorers / Header Events Row -->
                <!-- Home Goal Scorers & Red Cards -->
                <ItemsControl
                    x:Name="HomeIncidentsList"
                    Grid.Row="1"
                    Grid.Column="0"
                    ItemsSource="{x:Bind ViewModel.HomeIncidents, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.HeaderIncidentsVisibility, Mode=OneWay}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,8,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:MatchHeaderIncidentViewModel">
                            <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center" Margin="0,1,0,1">
                                <TextBlock Text="{x:Bind Icon}" FontSize="11" VerticalAlignment="Center" />
                                <TextBlock Text="{x:Bind Text}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Away Goal Scorers & Red Cards -->
                <ItemsControl
                    x:Name="AwayIncidentsList"
                    Grid.Row="1"
                    Grid.Column="2"
                    ItemsSource="{x:Bind ViewModel.AwayIncidents, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.HeaderIncidentsVisibility, Mode=OneWay}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,8,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:MatchHeaderIncidentViewModel">
                            <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center" Margin="0,1,0,1">
                                <TextBlock Text="{x:Bind Icon}" FontSize="11" VerticalAlignment="Center" />
                                <TextBlock Text="{x:Bind Text}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>

        <!-- Main Content Area: Timeline (Left) + Interactive Draggable Splitter + Details/Lineups/Stats (Right) -->
        <Grid Grid.Row="2" x:Name="MainContentGrid">
            <Grid.ColumnDefinitions>
                <!-- Column 0: Match Events Timeline (Left) -->
                <ColumnDefinition x:Name="LeftColumnDefinition" Width="430" MinWidth="320" />
                <!-- Column 1: Interactive Draggable Splitter -->
                <ColumnDefinition Width="16" />
                <!-- Column 2: Statistics & Lineups (Right) -->
                <ColumnDefinition x:Name="RightColumnDefinition" Width="*" MinWidth="340" />
            </Grid.ColumnDefinitions>

            <!-- ========================================== -->
            <!-- SECTION LEFT: Key Events & Commentary       -->
            <!-- ========================================== -->
            <Border
                Grid.Column="0"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <!-- Row 0: Side-by-Side Segmented Toggle Switcher -->
                        <RowDefinition Height="Auto" />
                        <!-- Row 1: Exclusive Full-Height Content Area -->
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Row 0: Sleek Segmented Switcher Pill Container -->
                    <Border
                        Grid.Row="0"
                        Background="#0F172A"
                        BorderBrush="#334155"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="3">
                        <Grid ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Left Tab Button: ⏱️ Key Events -->
                            <Button
                                x:Name="KeyEventsTabButton"
                                Grid.Column="0"
                                HorizontalAlignment="Stretch"
                                Height="32"
                                CornerRadius="4"
                                Background="#1E293B"
                                BorderBrush="#334155"
                                BorderThickness="1"
                                Click="OnKeyEventsTabClicked">
                                <TextBlock
                                    x:Name="KeyEventsTabText"
                                    Text="{x:Bind ViewModel.KeyEventsTabHeader, Mode=OneWay}"
                                    FontWeight="SemiBold"
                                    FontSize="12"
                                    Foreground="#F8FAFC"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Button>

                            <!-- Right Tab Button: 📜 Commentary -->
                            <Button
                                x:Name="CommentaryTabButton"
                                Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                Height="32"
                                CornerRadius="4"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                Click="OnCommentaryTabClicked">
                                <TextBlock
                                    x:Name="CommentaryTabText"
                                    Text="{x:Bind ViewModel.CommentaryTabHeader, Mode=OneWay}"
                                    FontWeight="SemiBold"
                                    FontSize="12"
                                    Foreground="#94A3B8"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Row 1: Full-Height Content Area (Key Events or Commentary) -->
                    <Grid Grid.Row="1">
                        <!-- TAB VIEW 1: ⏱️ Key Events -->
                        <Grid
                            x:Name="KeyEventsPanel"
                            Visibility="{x:Bind ViewModel.KeyEventsTabVisibility, Mode=OneWay}">
                            <ListView
                                x:Name="KeyEventsList"
                                ItemsSource="{x:Bind ViewModel.KeyEvents, Mode=OneWay}"
                                SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:MatchTimelineItem">
                                        <Grid Padding="2,4,2,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="52" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- 1. Home Team Event (Left Side: text right-aligned + icon) -->
                                            <Grid
                                                Grid.Column="0"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Center"
                                                Visibility="{x:Bind HomeVisibility, Mode=OneTime}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel
                                                    Grid.Column="0"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Right"
                                                    Margin="0,0,6,0">
                                                    <TextBlock
                                                        Text="{x:Bind TeamName, Mode=OneTime}"
                                                        FontWeight="SemiBold"
                                                        FontSize="10"
                                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                        TextAlignment="Right"
                                                        HorizontalAlignment="Right"
                                                        Visibility="{x:Bind TeamNameVisibility, Mode=OneTime}" />
                                                    <TextBlock
                                                        Text="{x:Bind EventTitle, Mode=OneTime}"
                                                        FontWeight="SemiBold"
                                                        FontSize="12"
                                                        TextAlignment="Right"
                                                        HorizontalAlignment="Right"
                                                        TextWrapping="Wrap" />
                                                    <TextBlock
                                                        Text="{x:Bind EventSubtitle, Mode=OneTime}"
                                                        FontSize="10"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        TextAlignment="Right"
                                                        HorizontalAlignment="Right"
                                                        TextWrapping="Wrap"
                                                        Visibility="{x:Bind SubtitleVisibility, Mode=OneTime}" />
                                                </StackPanel>
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Text="{x:Bind IconGlyph, Mode=OneTime}"
                                                    FontSize="14"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Center" />
                                            </Grid>

                                            <!-- 2. Center Minute Node (Visible for all non-neutral events) -->
                                            <Border
                                                Grid.Column="1"
                                                Background="#0F172A"
                                                BorderBrush="#334155"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Padding="4,2,4,2"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Visibility="{x:Bind NonNeutralVisibility, Mode=OneTime}">
                                                <TextBlock
                                                    Text="{x:Bind MinuteDisplay, Mode=OneTime}"
                                                    FontWeight="Bold"
                                                    FontSize="11"
                                                    Foreground="#38BDF8"
                                                    HorizontalAlignment="Center" />
                                            </Border>

                                            <!-- 3. Away Team Event (Right Side: icon + text left-aligned) -->
                                            <Grid
                                                Grid.Column="2"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Center"
                                                Visibility="{x:Bind AwayVisibility, Mode=OneTime}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    Grid.Column="0"
                                                    Text="{x:Bind IconGlyph, Mode=OneTime}"
                                                    FontSize="14"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Center" />
                                                <StackPanel
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Left"
                                                    Margin="6,0,0,0">
                                                    <TextBlock
                                                        Text="{x:Bind TeamName, Mode=OneTime}"
                                                        FontWeight="SemiBold"
                                                        FontSize="10"
                                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                        TextAlignment="Left"
                                                        HorizontalAlignment="Left"
                                                        Visibility="{x:Bind TeamNameVisibility, Mode=OneTime}" />
                                                    <TextBlock
                                                        Text="{x:Bind EventTitle, Mode=OneTime}"
                                                        FontWeight="SemiBold"
                                                        FontSize="12"
                                                        TextAlignment="Left"
                                                        HorizontalAlignment="Left"
                                                        TextWrapping="Wrap" />
                                                    <TextBlock
                                                        Text="{x:Bind EventSubtitle, Mode=OneTime}"
                                                        FontSize="10"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        TextAlignment="Left"
                                                        HorizontalAlignment="Left"
                                                        TextWrapping="Wrap"
                                                        Visibility="{x:Bind SubtitleVisibility, Mode=OneTime}" />
                                                </StackPanel>
                                            </Grid>

                                            <!-- 4. Neutral Whistle Markers (Kickoff, HT, FT, etc.) -->
                                            <Border
                                                Grid.Column="0"
                                                Grid.ColumnSpan="3"
                                                Background="#1E293B"
                                                BorderBrush="#334155"
                                                BorderThickness="1"
                                                CornerRadius="12"
                                                Padding="12,3,12,3"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Visibility="{x:Bind NeutralVisibility, Mode=OneTime}">
                                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind IconGlyph, Mode=OneTime}" FontSize="12" VerticalAlignment="Center" />
                                                    <TextBlock Text="{x:Bind EventTitle, Mode=OneTime}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                                    <TextBlock Text="{x:Bind MinuteDisplay, Mode=OneTime}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <TextBlock
                                x:Name="NoKeyEventsText"
                                Text="No key events recorded yet."
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="Collapsed" />
                        </Grid>

                        <!-- TAB VIEW 2: 📜 Commentary -->
                        <Grid
                            x:Name="CommentaryPanel"
                            Visibility="{x:Bind ViewModel.CommentaryTabVisibility, Mode=OneWay}">
                            <ListView
                                x:Name="CommentaryList"
                                ItemsSource="{x:Bind ViewModel.CommentaryItems, Mode=OneWay}"
                                SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:MatchCommentaryItemViewModel">
                                        <Grid Margin="0,2,0,2">
                                            <!-- 1. WHISTLE ROW (Centered, borderless, transparent background with full-width text wrapping) -->
                                            <Border
                                                Visibility="{x:Bind WhistleVisibility, Mode=OneWay}"
                                                Background="Transparent"
                                                BorderBrush="Transparent"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="12,6"
                                                HorizontalAlignment="Stretch">
                                                <Grid HorizontalAlignment="Stretch">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <!-- Header Badge Row: ⏱️ Icon + Minute Badge -->
                                                    <StackPanel
                                                        Grid.Row="0"
                                                        Orientation="Horizontal"
                                                        Spacing="6"
                                                        HorizontalAlignment="Center"
                                                        Margin="0,0,0,4">
                                                        <TextBlock
                                                            Text="⏱️"
                                                            FontSize="12"
                                                            VerticalAlignment="Center" />
                                                        <Border
                                                            Background="#0F172A"
                                                            BorderBrush="#334155"
                                                            BorderThickness="1"
                                                            CornerRadius="4"
                                                            Padding="6,1,6,1"
                                                            VerticalAlignment="Center">
                                                            <TextBlock
                                                                Text="{x:Bind MinuteDisplay, Mode=OneTime}"
                                                                FontWeight="Bold"
                                                                FontSize="11"
                                                                Foreground="#38BDF8"
                                                                HorizontalAlignment="Center" />
                                                        </Border>
                                                    </StackPanel>

                                                    <!-- Whistle Description Text (Full width wrapping into 2+ centered lines) -->
                                                    <TextBlock
                                                        Grid.Row="1"
                                                        Text="{x:Bind Text, Mode=OneWay}"
                                                        FontSize="12"
                                                        FontWeight="SemiBold"
                                                        Foreground="#94A3B8"
                                                        TextWrapping="Wrap"
                                                        TextAlignment="Center"
                                                        HorizontalAlignment="Center" />
                                                </Grid>
                                            </Border>

                                            <!-- 2. REGULAR TEAM COMMENTARY ROW (Card style with #1E293B background, left-aligned) -->
                                            <Border
                                                Visibility="{x:Bind RegularRowVisibility, Mode=OneWay}"
                                                Padding="6,6,8,6"
                                                CornerRadius="6"
                                                Background="#1E293B"
                                                BorderBrush="#334155"
                                                BorderThickness="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <!-- Team Crest / Placeholder (Column 0) -->
                                                        <ColumnDefinition Width="Auto" />
                                                        <!-- Timestamp Minute badge (Column 1) -->
                                                        <ColumnDefinition Width="Auto" />
                                                        <!-- Commentary Text (Column 2) -->
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Team Crest/Logo (shown when logo present) -->
                                                    <Border
                                                        Grid.Column="0"
                                                        Width="18"
                                                        Height="18"
                                                        Margin="0,2,8,0"
                                                        VerticalAlignment="Top"
                                                        Visibility="{x:Bind TeamLogoVisibility, Mode=OneWay}">
                                                        <Image Width="18" Height="18" Stretch="Uniform">
                                                            <Image.Source>
                                                                <BitmapImage UriSource="{x:Bind LogoUri, Mode=OneTime}" DecodePixelWidth="18" DecodePixelHeight="18" />
                                                            </Image.Source>
                                                        </Image>
                                                    </Border>

                                                    <!-- Fallback placeholder if no team logo -->
                                                    <Border
                                                        Grid.Column="0"
                                                        Width="18"
                                                        Height="18"
                                                        Margin="0,2,8,0"
                                                        VerticalAlignment="Top"
                                                        Visibility="{x:Bind NoLogoVisibility, Mode=OneWay}">
                                                        <TextBlock Text="⚽" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>

                                                    <!-- Timestamp Minute badge -->
                                                    <Border
                                                        Grid.Column="1"
                                                        Background="#0F172A"
                                                        BorderBrush="#334155"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        Padding="5,1,5,1"
                                                        Margin="0,1,8,0"
                                                        VerticalAlignment="Top">
                                                        <TextBlock
                                                            Text="{x:Bind MinuteDisplay, Mode=OneTime}"
                                                            FontWeight="Bold"
                                                            FontSize="11"
                                                            Foreground="#38BDF8"
                                                            HorizontalAlignment="Center" />
                                                    </Border>

                                                    <!-- Commentary text -->
                                                    <TextBlock
                                                        Grid.Column="2"
                                                        Text="{x:Bind Text, Mode=OneWay}"
                                                        FontSize="12"
                                                        TextWrapping="Wrap"
                                                        VerticalAlignment="Center"
                                                        Foreground="#F8FAFC" />
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <TextBlock
                                x:Name="NoCommentaryText"
                                Text="No commentary available yet."
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="Collapsed" />
                        </Grid>
                    </Grid>
                </Grid>
            </Border>

            <!-- ========================================== -->
            <!-- SECTION MIDDLE: Interactive Splitter        -->
            <!-- ========================================== -->
            <Border
                x:Name="TimelineSplitter"
                Grid.Column="1"
                Background="Transparent"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                PointerEntered="OnSplitterPointerEntered"
                PointerExited="OnSplitterPointerExited"
                PointerPressed="OnSplitterPointerPressed"
                PointerMoved="OnSplitterPointerMoved"
                PointerReleased="OnSplitterPointerReleased"
                PointerCanceled="OnSplitterPointerCanceled"
                ToolTipService.ToolTip="Drag to resize panels">
                <!-- Visual Divider Bar and Centered Grip Pill -->
                <Grid HorizontalAlignment="Center" VerticalAlignment="Stretch">
                    <!-- Subtle vertical dividing guide -->
                    <Border
                        x:Name="SplitterLine"
                        Width="2"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Stretch"
                        Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                        CornerRadius="1" />
                    <!-- Drag handle pill indicator -->
                    <Border
                        x:Name="SplitterGrip"
                        Width="4"
                        Height="36"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="{ThemeResource TextFillColorTertiaryBrush}"
                        CornerRadius="2" />
                </Grid>
            </Border>

            <!-- ========================================== -->
            <!-- SECTION RIGHT: Statistics & Lineups Pane   -->
            <!-- ========================================== -->
            <Border
                Grid.Column="2"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <!-- Tab Selector Row -->
                        <RowDefinition Height="Auto" />
                        <!-- Tab Content Row -->
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Sleek Segmented Switcher Pill Container for Right Pane -->
                    <Border
                        Grid.Row="0"
                        Background="#0F172A"
                        BorderBrush="#334155"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="3">
                        <Grid ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Tab 1: 📊 Statistics -->
                            <Button
                                x:Name="StatsTabButton"
                                Grid.Column="0"
                                HorizontalAlignment="Stretch"
                                Height="32"
                                CornerRadius="4"
                                Background="#1E293B"
                                BorderBrush="#334155"
                                BorderThickness="1"
                                Click="OnStatsTabClicked">
                                <TextBlock
                                    x:Name="StatsTabText"
                                    Text="📊 Statistics"
                                    FontWeight="SemiBold"
                                    FontSize="12"
                                    Foreground="#F8FAFC"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Button>

                            <!-- Tab 2: 👕 Lineups -->
                            <Button
                                x:Name="LineupsTabButton"
                                Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                Height="32"
                                CornerRadius="4"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                Click="OnLineupsTabClicked">
                                <TextBlock
                                    x:Name="LineupsTabText"
                                    Text="👕 Lineups"
                                    FontWeight="SemiBold"
                                    FontSize="12"
                                    Foreground="#94A3B8"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Button>

                            <!-- Tab 3: 🏆 League Standings -->
                            <Button
                                x:Name="StandingsTabButton"
                                Grid.Column="2"
                                HorizontalAlignment="Stretch"
                                Height="32"
                                CornerRadius="4"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                Click="OnStandingsTabClicked">
                                <TextBlock
                                    x:Name="StandingsTabText"
                                    Text="🏆 Standings"
                                    FontWeight="SemiBold"
                                    FontSize="12"
                                    Foreground="#94A3B8"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Button>
                        </Grid>
                    </Border>

                    <!-- TAB A: STATISTICS PANEL -->
                    <controls:MatchStatisticsControl
                        x:Name="StatisticsControl"
                        Grid.Row="1"
                        Visibility="Visible" />

                    <!-- TAB B: LINEUPS PANEL -->
                    <controls:MatchLineupPitchControl
                        x:Name="LineupControl"
                        Grid.Row="1"
                        Visibility="Collapsed" />

                    <!-- TAB C: LEAGUE STANDINGS & SEASON LEADERS PANEL -->
                    <ScrollViewer
                        x:Name="StandingsScrollContainer"
                        Grid.Row="1"
                        Visibility="Collapsed"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="12">
                            <!-- Card 1: 🏆 League Standings -->
                            <Border
                                Visibility="{x:Bind ViewModel.StandingsVisibility, Mode=OneWay}"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14">
                                <StackPanel Spacing="10">
                                    <!-- Card Header & Legend -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <TextBlock Text="🏆" FontSize="14" VerticalAlignment="Center" />
                                            <TextBlock Text="League Standings" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" />
                                        </StackPanel>

                                        <!-- Legend: Home & Away Highlighting -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                <Border Width="8" Height="8" Background="#0078D4" CornerRadius="2" />
                                                <TextBlock Text="Home" FontSize="10" Foreground="#94A3B8" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                <Border Width="8" Height="8" Background="#107C41" CornerRadius="2" />
                                                <TextBlock Text="Away" FontSize="10" Foreground="#94A3B8" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Standings Header Row -->
                                    <Border
                                        Background="#0F172A"
                                        BorderBrush="#334155"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="8,5">
                                        <Grid ColumnSpacing="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="26" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="28" />
                                                <ColumnDefinition Width="26" />
                                                <ColumnDefinition Width="26" />
                                                <ColumnDefinition Width="26" />
                                                <ColumnDefinition Width="36" />
                                                <ColumnDefinition Width="36" />
                                                <ColumnDefinition Width="95" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="#" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" HorizontalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="TEAM" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" />
                                            <TextBlock Grid.Column="2" Text="P" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" HorizontalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="W" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" HorizontalAlignment="Center" />
                                            <TextBlock Grid.Column="4" Text="D" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" HorizontalAlignment="Center" />
                                            <TextBlock Grid.Column="5" Text="L" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" HorizontalAlignment="Center" />
                                            <TextBlock Grid.Column="6" Text="GD" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" HorizontalAlignment="Center" />
                                            <TextBlock Grid.Column="7" Text="PTS" FontSize="10" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Center" />
                                            <TextBlock Grid.Column="8" Text="FORM" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" HorizontalAlignment="Center" />
                                        </Grid>
                                    </Border>

                                    <!-- Standings List -->
                                    <ItemsControl ItemsSource="{x:Bind ViewModel.Standings, Mode=OneWay}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:StandingRowItemViewModel">
                                                <Border
                                                    Background="{x:Bind RowBackgroundBrush, Mode=OneTime}"
                                                    BorderBrush="{x:Bind RowBorderBrush, Mode=OneTime}"
                                                    BorderThickness="{x:Bind RowBorderThickness, Mode=OneTime}"
                                                    CornerRadius="6"
                                                    Padding="8,4"
                                                    Margin="0,1">
                                                    <Grid ColumnSpacing="6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="26" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="28" />
                                                            <ColumnDefinition Width="26" />
                                                            <ColumnDefinition Width="26" />
                                                            <ColumnDefinition Width="26" />
                                                            <ColumnDefinition Width="36" />
                                                            <ColumnDefinition Width="36" />
                                                            <ColumnDefinition Width="95" />
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock Grid.Column="0" Text="{x:Bind Rank}" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center" />

                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                            <Border Width="16" Height="16" Visibility="{x:Bind LogoVisibility}" VerticalAlignment="Center">
                                                                <Image Source="{x:Bind TeamLogoSource}" Width="16" Height="16" Stretch="Uniform" />
                                                            </Border>
                                                            <TextBlock
                                                                Text="{x:Bind DisplayName}"
                                                                FontSize="11"
                                                                FontWeight="SemiBold"
                                                                TextTrimming="CharacterEllipsis"
                                                                VerticalAlignment="Center" />
                                                            <!-- Home / Away Badges -->
                                                            <Border
                                                                Visibility="{x:Bind HomeBadgeVisibility}"
                                                                Background="#0078D4"
                                                                CornerRadius="3"
                                                                Padding="4,0"
                                                                VerticalAlignment="Center">
                                                                <TextBlock Text="HOME" FontSize="8" FontWeight="Bold" Foreground="#FFFFFF" />
                                                            </Border>
                                                            <Border
                                                                Visibility="{x:Bind AwayBadgeVisibility}"
                                                                Background="#107C41"
                                                                CornerRadius="3"
                                                                Padding="4,0"
                                                                VerticalAlignment="Center">
                                                                <TextBlock Text="AWAY" FontSize="8" FontWeight="Bold" Foreground="#FFFFFF" />
                                                            </Border>
                                                            <TextBlock
                                                                Text="⭐"
                                                                FontSize="9"
                                                                Visibility="{x:Bind FollowedStarVisibility}"
                                                                VerticalAlignment="Center" />
                                                        </StackPanel>

                                                        <TextBlock Grid.Column="2" Text="{x:Bind Played}" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="3" Text="{x:Bind Wins}" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="4" Text="{x:Bind Draws}" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="5" Text="{x:Bind Losses}" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="6" Text="{x:Bind GoalDiffDisplay}" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="7" Text="{x:Bind Points}" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Center" VerticalAlignment="Center" />

                                                        <ItemsControl Grid.Column="8" ItemsSource="{x:Bind FormBadges}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <StackPanel Orientation="Horizontal" Spacing="2" />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="vm:FormBadgeItemViewModel">
                                                                    <Border
                                                                        Width="15"
                                                                        Height="15"
                                                                        CornerRadius="3"
                                                                        Background="{x:Bind BackgroundBrush}"
                                                                        ToolTipService.ToolTip="{x:Bind TooltipText}">
                                                                        <TextBlock
                                                                            Text="{x:Bind Text}"
                                                                            FontSize="8"
                                                                            FontWeight="Bold"
                                                                            Foreground="{x:Bind ForegroundBrush}"
                                                                            HorizontalAlignment="Center"
                                                                            VerticalAlignment="Center" />
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Card 2: ⚡ Season Leaders -->
                            <Border
                                Visibility="{x:Bind ViewModel.LeadersVisibility, Mode=OneWay}"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14">
                                <StackPanel Spacing="12">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <TextBlock Text="⚡" FontSize="14" VerticalAlignment="Center" />
                                        <TextBlock Text="Season Leaders" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" />
                                    </StackPanel>

                                    <!-- Top Scorers Section -->
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="🥅 TOP SCORERS" FontSize="10" FontWeight="Bold" Foreground="#38BDF8" CharacterSpacing="40" />
                                        <ItemsControl ItemsSource="{x:Bind ViewModel.TopScorers, Mode=OneWay}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:PlayerStatLeaderItemViewModel">
                                                    <Border
                                                        Background="#1E293B"
                                                        BorderBrush="#334155"
                                                        BorderThickness="1"
                                                        CornerRadius="6"
                                                        Padding="10,6"
                                                        Margin="0,0,0,4">
                                                        <Grid ColumnSpacing="8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="28" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <Border
                                                                Grid.Column="0"
                                                                Background="#0F172A"
                                                                CornerRadius="4"
                                                                Padding="4,2"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center">
                                                                <TextBlock
                                                                    Text="{x:Bind RankDisplay}"
                                                                    FontSize="10"
                                                                    FontWeight="Bold"
                                                                    Foreground="#38BDF8"
                                                                    HorizontalAlignment="Center" />
                                                            </Border>

                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                                <TextBlock
                                                                    Text="{x:Bind PlayerName}"
                                                                    FontSize="12"
                                                                    FontWeight="Bold"
                                                                    TextTrimming="CharacterEllipsis" />
                                                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                                    <Border Width="12" Height="12" Visibility="{x:Bind LogoVisibility}" VerticalAlignment="Center">
                                                                        <Image Source="{x:Bind TeamLogoSource}" Width="12" Height="12" Stretch="Uniform" />
                                                                    </Border>
                                                                    <TextBlock
                                                                        Text="{x:Bind TeamName}"
                                                                        FontSize="10"
                                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                        VerticalAlignment="Center" />
                                                                </StackPanel>
                                                            </StackPanel>

                                                            <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="1">
                                                                <StackPanel Orientation="Horizontal" Spacing="3" HorizontalAlignment="Right">
                                                                    <TextBlock
                                                                        Text="{x:Bind MainStatValue}"
                                                                        FontSize="14"
                                                                        FontWeight="Bold"
                                                                        Foreground="{x:Bind StatBrush}" />
                                                                    <TextBlock
                                                                        Text="{x:Bind MainStatLabel}"
                                                                        FontSize="10"
                                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                        VerticalAlignment="Bottom"
                                                                        Margin="0,0,0,1" />
                                                                </StackPanel>
                                                                <TextBlock
                                                                    Text="{x:Bind SubStatDisplay}"
                                                                    FontSize="9"
                                                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                                    HorizontalAlignment="Right"
                                                                    Visibility="{x:Bind SubStatVisibility}" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <!-- Top Assists Section -->
                                    <StackPanel Spacing="6" Margin="0,4,0,0">
                                        <TextBlock Text="🎯 TOP ASSISTS" FontSize="10" FontWeight="Bold" Foreground="#10B981" CharacterSpacing="40" />
                                        <ItemsControl ItemsSource="{x:Bind ViewModel.TopAssists, Mode=OneWay}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:PlayerStatLeaderItemViewModel">
                                                    <Border
                                                        Background="#1E293B"
                                                        BorderBrush="#334155"
                                                        BorderThickness="1"
                                                        CornerRadius="6"
                                                        Padding="10,6"
                                                        Margin="0,0,0,4">
                                                        <Grid ColumnSpacing="8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="28" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <Border
                                                                Grid.Column="0"
                                                                Background="#0F172A"
                                                                CornerRadius="4"
                                                                Padding="4,2"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center">
                                                                <TextBlock
                                                                    Text="{x:Bind RankDisplay}"
                                                                    FontSize="10"
                                                                    FontWeight="Bold"
                                                                    Foreground="#10B981"
                                                                    HorizontalAlignment="Center" />
                                                            </Border>

                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                                <TextBlock
                                                                    Text="{x:Bind PlayerName}"
                                                                    FontSize="12"
                                                                    FontWeight="Bold"
                                                                    TextTrimming="CharacterEllipsis" />
                                                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                                    <Border Width="12" Height="12" Visibility="{x:Bind LogoVisibility}" VerticalAlignment="Center">
                                                                        <Image Source="{x:Bind TeamLogoSource}" Width="12" Height="12" Stretch="Uniform" />
                                                                    </Border>
                                                                    <TextBlock
                                                                        Text="{x:Bind TeamName}"
                                                                        FontSize="10"
                                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                        VerticalAlignment="Center" />
                                                                </StackPanel>
                                                            </StackPanel>

                                                            <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="1">
                                                                <StackPanel Orientation="Horizontal" Spacing="3" HorizontalAlignment="Right">
                                                                    <TextBlock
                                                                        Text="{x:Bind MainStatValue}"
                                                                        FontSize="14"
                                                                        FontWeight="Bold"
                                                                        Foreground="{x:Bind StatBrush}" />
                                                                    <TextBlock
                                                                        Text="{x:Bind MainStatLabel}"
                                                                        FontSize="10"
                                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                        VerticalAlignment="Bottom"
                                                                        Margin="0,0,0,1" />
                                                                </StackPanel>
                                                                <TextBlock
                                                                    Text="{x:Bind SubStatDisplay}"
                                                                    FontSize="9"
                                                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                                    HorizontalAlignment="Right"
                                                                    Visibility="{x:Bind SubStatVisibility}" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Empty State Card if no Standings or Leaders -->
                            <Border
                                Visibility="{x:Bind ViewModel.NoStandingsVisibility, Mode=OneWay}"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="24"
                                HorizontalAlignment="Stretch">
                                <StackPanel Spacing="8" HorizontalAlignment="Center">
                                    <TextBlock Text="🏆" FontSize="28" HorizontalAlignment="Center" />
                                    <TextBlock Text="League Standings Unavailable" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" />
                                    <TextBlock Text="Standings or tournament leaders are not currently available for this match or stage." FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
