<Window
    x:Class="FootballTray.Client.Views.MatchCenterWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:FootballTray.Client.ViewModels"
    xmlns:controls="using:FootballTray.Client.Views.Controls"
    mc:Ignorable="d"
    Title="Match Center">

    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="20">
        <Grid.RowDefinitions>
            <!-- Row 0: Competition & Status Header -->
            <RowDefinition Height="Auto" />
            <!-- Row 1: Scoreboard Card -->
            <RowDefinition Height="Auto" />
            <!-- Row 2: Main Split Content (Timeline & Details) -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: Competition & Status -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock
                    x:Name="CompetitionText"
                    Text="{Binding CompetitionName}"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock
                    x:Name="VenueText"
                    Text="{Binding Venue}"
                    FontSize="11"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Visibility="{Binding Venue, ConverterParameter=NotEmpty, Mode=OneWay}" />
            </StackPanel>

            <Border
                Grid.Column="1"
                x:Name="StatusBadge"
                Background="{ThemeResource AccentFillColorDefaultBrush}"
                CornerRadius="6"
                Padding="10,4,10,4"
                VerticalAlignment="Center">
                <TextBlock
                    x:Name="StatusText"
                    Text="{Binding StatusText}"
                    FontSize="12"
                    FontWeight="Bold"
                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
            </Border>
        </Grid>

        <!-- Score Board Card -->
        <Border
            Grid.Row="1"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="16"
            Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Home Team -->
                <StackPanel Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                    <Image
                        x:Name="HomeTeamLogo"
                        Width="56"
                        Height="56"
                        Stretch="Uniform"
                        HorizontalAlignment="Center"
                        Visibility="Collapsed" />
                    <TextBlock
                        x:Name="HomeTeamName"
                        Text="{Binding HomeTeamName}"
                        FontSize="18"
                        FontWeight="Bold"
                        HorizontalAlignment="Center"
                        TextAlignment="Center" />
                </StackPanel>

                <!-- Score and Halftime -->
                <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24,0,24,0">
                    <TextBlock
                        x:Name="ScoreText"
                        Text="{Binding ScoreText}"
                        FontSize="36"
                        FontWeight="Bold"
                        HorizontalAlignment="Center" />
                    <TextBlock
                        x:Name="HalfTimeText"
                        Text="{Binding HalfTimeText}"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        HorizontalAlignment="Center"
                        Margin="0,2,0,0" />
                    <Border
                        x:Name="AggregateBadge"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="8,2,8,2"
                        Margin="0,4,0,0"
                        HorizontalAlignment="Center"
                        Visibility="Collapsed">
                        <TextBlock
                            x:Name="AggregateText"
                            Text="{Binding AggregateText}"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Border>
                </StackPanel>

                <!-- Away Team -->
                <StackPanel Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                    <Image
                        x:Name="AwayTeamLogo"
                        Width="56"
                        Height="56"
                        Stretch="Uniform"
                        HorizontalAlignment="Center"
                        Visibility="Collapsed" />
                    <TextBlock
                        x:Name="AwayTeamName"
                        Text="{Binding AwayTeamName}"
                        FontSize="18"
                        FontWeight="Bold"
                        HorizontalAlignment="Center"
                        TextAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Area: Timeline (Left) + Details/Lineups/Stats (Right) -->
        <Grid Grid.Row="2" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <!-- Left Pane: Timeline Events -->
                <ColumnDefinition Width="360" MinWidth="300" />
                <!-- Right Pane: Statistics & Lineups (Utilizes empty right-side space) -->
                <ColumnDefinition Width="*" MinWidth="380" />
            </Grid.ColumnDefinitions>

            <!-- ========================================== -->
            <!-- SECTION LEFT: Timeline Events              -->
            <!-- ========================================== -->
            <Border
                Grid.Column="0"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        Text="⏱️ Match Events"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Margin="2,0,0,4" />

                    <ListView
                        Grid.Row="1"
                        x:Name="EventsList"
                        SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:MatchTimelineItem">
                                <Grid Padding="2,6,2,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="42" />
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        Grid.Column="0"
                                        Text="{x:Bind MinuteDisplay}"
                                        FontWeight="Bold"
                                        FontSize="12"
                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                        VerticalAlignment="Center" />

                                    <TextBlock
                                        Grid.Column="1"
                                        Text="{x:Bind IconGlyph}"
                                        FontSize="14"
                                        VerticalAlignment="Center" />

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock
                                            Text="{x:Bind Description}"
                                            FontSize="12"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            Text="{x:Bind PlayerInfo}"
                                            FontSize="11"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- Empty Events Fallback -->
                    <TextBlock
                        Grid.Row="1"
                        x:Name="NoEventsText"
                        Text="No timeline events recorded yet."
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="Collapsed" />
                </Grid>
            </Border>

            <!-- ========================================== -->
            <!-- SECTION RIGHT: Statistics & Lineups Pane   -->
            <!-- ========================================== -->
            <Border
                Grid.Column="1"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <!-- Tab Selector Row -->
                        <RowDefinition Height="Auto" />
                        <!-- Tab Content Row -->
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Native WinUI 3 RadioButtons as Tab Switcher -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="16" Margin="4,0,0,4">
                        <RadioButton
                            x:Name="StatsTabRadio"
                            Content="📊 Statistics"
                            GroupName="MatchDetailTabs"
                            IsChecked="True"
                            FontWeight="SemiBold"
                            Checked="OnTabChecked" />
                        <RadioButton
                            x:Name="LineupsTabRadio"
                            Content="👥 Lineups"
                            GroupName="MatchDetailTabs"
                            FontWeight="SemiBold"
                            Checked="OnTabChecked" />
                    </StackPanel>

                    <!-- TAB A: STATISTICS PANEL -->
                    <controls:MatchStatisticsControl
                        x:Name="StatisticsControl"
                        Grid.Row="1"
                        Visibility="Visible" />

                    <!-- TAB B: LINEUPS PANEL -->
                    <controls:MatchLineupPitchControl
                        x:Name="LineupControl"
                        Grid.Row="1"
                        Visibility="Collapsed" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
