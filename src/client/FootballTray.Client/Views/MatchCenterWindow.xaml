<Window
    x:Class="FootballTray.Client.Views.MatchCenterWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:FootballTray.Client.ViewModels"
    mc:Ignorable="d"
    Title="Match Center">

    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="20">
        <Grid.RowDefinitions>
            <!-- Row 0: Competition & Status Header -->
            <RowDefinition Height="Auto" />
            <!-- Row 1: Scoreboard Card -->
            <RowDefinition Height="Auto" />
            <!-- Row 2: Main Split Content (Timeline & Details) -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: Competition & Status -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock
                    x:Name="CompetitionText"
                    Text="{Binding CompetitionName}"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock
                    x:Name="VenueText"
                    Text="{Binding Venue}"
                    FontSize="11"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Visibility="{Binding Venue, ConverterParameter=NotEmpty, Mode=OneWay}" />
            </StackPanel>

            <Border
                Grid.Column="1"
                x:Name="StatusBadge"
                Background="{ThemeResource AccentFillColorDefaultBrush}"
                CornerRadius="6"
                Padding="10,4,10,4"
                VerticalAlignment="Center">
                <TextBlock
                    x:Name="StatusText"
                    Text="{Binding StatusText}"
                    FontSize="12"
                    FontWeight="Bold"
                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
            </Border>
        </Grid>

        <!-- Score Board Card -->
        <Border
            Grid.Row="1"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="16"
            Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Home Team -->
                <StackPanel Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                    <Image
                        x:Name="HomeTeamLogo"
                        Width="56"
                        Height="56"
                        Stretch="Uniform"
                        HorizontalAlignment="Center"
                        Visibility="Collapsed" />
                    <TextBlock
                        x:Name="HomeTeamName"
                        Text="{Binding HomeTeamName}"
                        FontSize="18"
                        FontWeight="Bold"
                        HorizontalAlignment="Center"
                        TextAlignment="Center" />
                </StackPanel>

                <!-- Score and Halftime -->
                <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24,0,24,0">
                    <TextBlock
                        x:Name="ScoreText"
                        Text="{Binding ScoreText}"
                        FontSize="36"
                        FontWeight="Bold"
                        HorizontalAlignment="Center" />
                    <TextBlock
                        x:Name="HalfTimeText"
                        Text="{Binding HalfTimeText}"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        HorizontalAlignment="Center"
                        Margin="0,2,0,0" />
                    <Border
                        x:Name="AggregateBadge"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="8,2,8,2"
                        Margin="0,4,0,0"
                        HorizontalAlignment="Center"
                        Visibility="Collapsed">
                        <TextBlock
                            x:Name="AggregateText"
                            Text="{Binding AggregateText}"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Border>
                </StackPanel>

                <!-- Away Team -->
                <StackPanel Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                    <Image
                        x:Name="AwayTeamLogo"
                        Width="56"
                        Height="56"
                        Stretch="Uniform"
                        HorizontalAlignment="Center"
                        Visibility="Collapsed" />
                    <TextBlock
                        x:Name="AwayTeamName"
                        Text="{Binding AwayTeamName}"
                        FontSize="18"
                        FontWeight="Bold"
                        HorizontalAlignment="Center"
                        TextAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Area: Timeline (Left) + Details/Lineups/Stats (Right) -->
        <Grid Grid.Row="2" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <!-- Left Pane: Timeline Events -->
                <ColumnDefinition Width="360" MinWidth="300" />
                <!-- Right Pane: Statistics & Lineups (Utilizes empty right-side space) -->
                <ColumnDefinition Width="*" MinWidth="380" />
            </Grid.ColumnDefinitions>

            <!-- ========================================== -->
            <!-- SECTION LEFT: Timeline Events              -->
            <!-- ========================================== -->
            <Border
                Grid.Column="0"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        Text="⏱️ Match Events"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Margin="2,0,0,4" />

                    <ListView
                        Grid.Row="1"
                        x:Name="EventsList"
                        SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:MatchTimelineItem">
                                <Grid Padding="2,6,2,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="42" />
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        Grid.Column="0"
                                        Text="{x:Bind MinuteDisplay}"
                                        FontWeight="Bold"
                                        FontSize="12"
                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                        VerticalAlignment="Center" />

                                    <TextBlock
                                        Grid.Column="1"
                                        Text="{x:Bind IconGlyph}"
                                        FontSize="14"
                                        VerticalAlignment="Center" />

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock
                                            Text="{x:Bind Description}"
                                            FontSize="12"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            Text="{x:Bind PlayerInfo}"
                                            FontSize="11"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- Empty Events Fallback -->
                    <TextBlock
                        Grid.Row="1"
                        x:Name="NoEventsText"
                        Text="No timeline events recorded yet."
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="Collapsed" />
                </Grid>
            </Border>

            <!-- ========================================== -->
            <!-- SECTION RIGHT: Statistics & Lineups Pane   -->
            <!-- ========================================== -->
            <Border
                Grid.Column="1"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <!-- Tab Selector Row -->
                        <RowDefinition Height="Auto" />
                        <!-- Tab Content Row -->
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Native WinUI 3 RadioButtons as Tab Switcher -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="16" Margin="4,0,0,4">
                        <RadioButton
                            x:Name="StatsTabRadio"
                            Content="📊 Statistics"
                            GroupName="MatchDetailTabs"
                            IsChecked="True"
                            FontWeight="SemiBold"
                            Checked="OnTabChecked" />
                        <RadioButton
                            x:Name="LineupsTabRadio"
                            Content="👥 Lineups"
                            GroupName="MatchDetailTabs"
                            FontWeight="SemiBold"
                            Checked="OnTabChecked" />
                    </StackPanel>

                    <!-- TAB A: STATISTICS PANEL -->
                    <Grid Grid.Row="1" x:Name="StatisticsPanel" Visibility="Visible">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Teams Legend -->
                        <Grid Grid.Row="0" Margin="4,0,4,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Grid.Column="0"
                                Text="{Binding HomeTeamName}"
                                FontSize="12"
                                FontWeight="Bold"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                HorizontalAlignment="Left" />

                            <TextBlock
                                Grid.Column="1"
                                Text="Team Comparison"
                                FontSize="11"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                HorizontalAlignment="Center" />

                            <TextBlock
                                Grid.Column="2"
                                Text="{Binding AwayTeamName}"
                                FontSize="12"
                                FontWeight="Bold"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                HorizontalAlignment="Right" />
                        </Grid>

                        <!-- Stats List -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="10">
                                <ItemsControl x:Name="StatsItemsControl" ItemsSource="{Binding MatchStats}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:StatComparisonViewModel">
                                            <Border
                                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="12,8,12,8"
                                                Margin="0,0,0,6">
                                                <StackPanel Spacing="4">
                                                    <!-- Values and Label -->
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock
                                                            Grid.Column="0"
                                                            Text="{x:Bind HomeValue}"
                                                            FontWeight="Bold"
                                                            FontSize="13"
                                                            HorizontalAlignment="Left" />

                                                        <TextBlock
                                                            Grid.Column="1"
                                                            Text="{x:Bind Name}"
                                                            FontSize="12"
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            HorizontalAlignment="Center" />

                                                        <TextBlock
                                                            Grid.Column="2"
                                                            Text="{x:Bind AwayValue}"
                                                            FontWeight="Bold"
                                                            FontSize="13"
                                                            HorizontalAlignment="Right" />
                                                    </Grid>

                                                    <!-- Dual Comparative Progress Bars -->
                                                    <Grid Height="6" Margin="0,2,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="6" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Home Bar (Accent Fill) -->
                                                        <ProgressBar
                                                            Grid.Column="0"
                                                            Value="{x:Bind HomeRatio}"
                                                            Maximum="100"
                                                            FlowDirection="RightToLeft"
                                                            Height="6"
                                                            CornerRadius="3"
                                                            Foreground="{ThemeResource AccentFillColorDefaultBrush}" />

                                                        <!-- Away Bar (Secondary Fill) -->
                                                        <ProgressBar
                                                            Grid.Column="2"
                                                            Value="{x:Bind AwayRatio}"
                                                            Maximum="100"
                                                            FlowDirection="LeftToRight"
                                                            Height="6"
                                                            CornerRadius="3"
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Empty Stats Message -->
                                <Border
                                    x:Name="NoStatsBorder"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="20"
                                    Visibility="Collapsed">
                                    <StackPanel HorizontalAlignment="Center" Spacing="6">
                                        <TextBlock
                                            Text="📊 Statistics Unavailable"
                                            FontWeight="SemiBold"
                                            FontSize="14"
                                            HorizontalAlignment="Center" />
                                        <TextBlock
                                            Text="Detailed match statistics will be published once recorded during live play."
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            HorizontalAlignment="Center"
                                            TextWrapping="Wrap"
                                            TextAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- TAB B: LINEUPS PANEL -->
                    <Grid Grid.Row="1" x:Name="LineupsPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Lineup Content Area -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="12">
                                <StackPanel x:Name="LineupsContentContainer" Spacing="12" Visibility="Visible">
                                    <!-- Away Team Header Card -->
                                    <Border
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="12,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Spacing="2">
                                                <TextBlock
                                                    Text="{Binding AwayTeamName}"
                                                    FontSize="13"
                                                    FontWeight="Bold" />
                                                <TextBlock
                                                    Text="{Binding AwayLineup.CoachName, FallbackValue='Coach: N/A'}"
                                                    FontSize="11"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                            <Border
                                                Grid.Column="1"
                                                Background="#D13438"
                                                CornerRadius="4"
                                                Padding="8,2"
                                                VerticalAlignment="Center">
                                                <TextBlock
                                                    Text="{Binding AwayLineup.Formation, FallbackValue='Away'}"
                                                    FontSize="11"
                                                    FontWeight="Bold"
                                                    Foreground="#FFFFFF" />
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <!-- Visual Football Pitch (Viewbox + Canvas) -->
                                    <Border
                                        Background="#164E24"
                                        BorderBrush="#257A38"
                                        BorderThickness="2"
                                        CornerRadius="8"
                                        Padding="8"
                                        HorizontalAlignment="Center">
                                        <Viewbox MaxWidth="380" MaxHeight="520" Stretch="Uniform">
                                            <Grid Width="340" Height="500">
                                                <!-- Pitch Grass Surface -->
                                                <Border Background="#1A5627" CornerRadius="4" />

                                                <!-- Pitch Markings (White lines with semi-opacity) -->
                                                <!-- Touchline border -->
                                                <Border Margin="14" BorderBrush="#85FFFFFF" BorderThickness="1.5" CornerRadius="2" />
                                                <!-- Halfway Line -->
                                                <Rectangle Margin="14,0,14,0" Height="1.5" Fill="#85FFFFFF" VerticalAlignment="Center" />
                                                <!-- Center Circle -->
                                                <Ellipse Width="70" Height="70" Stroke="#85FFFFFF" StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                <!-- Center Spot -->
                                                <Ellipse Width="4" Height="4" Fill="#85FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />

                                                <!-- Top Penalty Box (Away Defending) -->
                                                <Border Margin="0,14,0,0" Width="130" Height="62" BorderBrush="#85FFFFFF" BorderThickness="1.5,0,1.5,1.5" HorizontalAlignment="Center" VerticalAlignment="Top" />
                                                <!-- Top Goal Box -->
                                                <Border Margin="0,14,0,0" Width="66" Height="24" BorderBrush="#85FFFFFF" BorderThickness="1.5,0,1.5,1.5" HorizontalAlignment="Center" VerticalAlignment="Top" />
                                                <!-- Top Penalty Spot -->
                                                <Ellipse Margin="0,52,0,0" Width="4" Height="4" Fill="#85FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Top" />

                                                <!-- Bottom Penalty Box (Home Defending) -->
                                                <Border Margin="0,0,0,14" Width="130" Height="62" BorderBrush="#85FFFFFF" BorderThickness="1.5,1.5,1.5,0" HorizontalAlignment="Center" VerticalAlignment="Bottom" />
                                                <!-- Bottom Goal Box -->
                                                <Border Margin="0,0,0,14" Width="66" Height="24" BorderBrush="#85FFFFFF" BorderThickness="1.5,1.5,1.5,0" HorizontalAlignment="Center" VerticalAlignment="Bottom" />
                                                <!-- Bottom Penalty Spot -->
                                                <Ellipse Margin="0,0,0,52" Width="4" Height="4" Fill="#85FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Bottom" />

                                                <!-- 22 Starting Players via ItemsControl with ItemContainerStyle -->
                                                <ItemsControl ItemsSource="{Binding PitchPlayers}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <Canvas Width="340" Height="500" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemContainerStyle>
                                                        <Style TargetType="ContentPresenter">
                                                            <Setter Property="Canvas.Left" Value="{Binding CanvasLeft}" />
                                                            <Setter Property="Canvas.Top" Value="{Binding CanvasTop}" />
                                                        </Style>
                                                    </ItemsControl.ItemContainerStyle>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:PitchPlayerNodeViewModel">
                                                            <Grid Width="70" HorizontalAlignment="Center">
                                                                <StackPanel HorizontalAlignment="Center" Spacing="2">
                                                                    <!-- Circular Badge with Jersey Number -->
                                                                    <Grid HorizontalAlignment="Center" Width="26" Height="26">
                                                                        <!-- Goalkeeper Circle (Gold/Amber) -->
                                                                        <Ellipse Width="26" Height="26" Fill="#D97706" Stroke="#FFFFFF" StrokeThickness="1.5"
                                                                                 Visibility="{x:Bind GoalkeeperVisibility, Mode=OneWay}" />
                                                                        <!-- Home Outfield Circle (Accent / Royal Blue) -->
                                                                        <Ellipse Width="26" Height="26" Fill="#0078D4" Stroke="#FFFFFF" StrokeThickness="1.5"
                                                                                 Visibility="{x:Bind HomeOutfieldVisibility, Mode=OneWay}" />
                                                                        <!-- Away Outfield Circle (Coral / Crimson Red) -->
                                                                        <Ellipse Width="26" Height="26" Fill="#D13438" Stroke="#FFFFFF" StrokeThickness="1.5"
                                                                                 Visibility="{x:Bind AwayOutfieldVisibility, Mode=OneWay}" />

                                                                        <TextBlock Text="{x:Bind Number}"
                                                                                   FontSize="11"
                                                                                   FontWeight="Bold"
                                                                                   Foreground="#FFFFFF"
                                                                                   HorizontalAlignment="Center"
                                                                                   VerticalAlignment="Center" />
                                                                    </Grid>

                                                                    <!-- Player Surname Pill -->
                                                                    <Border Background="#CC0F172A" CornerRadius="4" Padding="4,1,4,1" HorizontalAlignment="Center">
                                                                        <TextBlock Text="{x:Bind ShortDisplayName}"
                                                                                   FontSize="10"
                                                                                   FontWeight="SemiBold"
                                                                                   Foreground="#F8FAFC"
                                                                                   TextTrimming="CharacterEllipsis"
                                                                                   MaxLines="1"
                                                                                   HorizontalAlignment="Center" />
                                                                    </Border>
                                                                </StackPanel>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Grid>
                                        </Viewbox>
                                    </Border>

                                    <!-- Home Team Header Card -->
                                    <Border
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="12,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Spacing="2">
                                                <TextBlock
                                                    Text="{Binding HomeTeamName}"
                                                    FontSize="13"
                                                    FontWeight="Bold" />
                                                <TextBlock
                                                    Text="{Binding HomeLineup.CoachName, FallbackValue='Coach: N/A'}"
                                                    FontSize="11"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                            <Border
                                                Grid.Column="1"
                                                Background="#0078D4"
                                                CornerRadius="4"
                                                Padding="8,2"
                                                VerticalAlignment="Center">
                                                <TextBlock
                                                    Text="{Binding HomeLineup.Formation, FallbackValue='Home'}"
                                                    FontSize="11"
                                                    FontWeight="Bold"
                                                    Foreground="#FFFFFF" />
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <!-- Bench / Substitutes Section -->
                                    <Border
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="14">
                                        <StackPanel Spacing="10">
                                            <TextBlock Text="🔄 Substitutes Bench" FontSize="13" FontWeight="Bold" />

                                            <Grid ColumnSpacing="16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Left: Home Substitutes -->
                                                <StackPanel Grid.Column="0" Spacing="6">
                                                    <TextBlock Text="{Binding HomeTeamName}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                    <ItemsControl ItemsSource="{Binding HomeLineup.Substitutes}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:LineupPlayerItemViewModel">
                                                                <Grid Padding="2,3,2,3">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="24" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Grid.Column="0" Text="{x:Bind Number}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                                                    <TextBlock Grid.Column="1" Text="{x:Bind Name}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                                    <Border Grid.Column="2" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="3" Padding="4,1,4,1" VerticalAlignment="Center">
                                                                        <TextBlock Text="{x:Bind PositionBadge}" FontSize="9" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                                    </Border>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>

                                                <!-- Right: Away Substitutes -->
                                                <StackPanel Grid.Column="1" Spacing="6">
                                                    <TextBlock Text="{Binding AwayTeamName}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    <ItemsControl ItemsSource="{Binding AwayLineup.Substitutes}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:LineupPlayerItemViewModel">
                                                                <Grid Padding="2,3,2,3">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="24" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Grid.Column="0" Text="{x:Bind Number}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                                                    <TextBlock Grid.Column="1" Text="{x:Bind Name}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                                    <Border Grid.Column="2" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="3" Padding="4,1,4,1" VerticalAlignment="Center">
                                                                        <TextBlock Text="{x:Bind PositionBadge}" FontSize="9" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                                    </Border>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- Empty Lineups Fallback -->
                                <Border
                                    x:Name="NoLineupsBorder"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="20"
                                    Visibility="Collapsed">
                                    <StackPanel HorizontalAlignment="Center" Spacing="6">
                                        <TextBlock
                                            Text="👥 Lineups Not Announced"
                                            FontWeight="SemiBold"
                                            FontSize="14"
                                            HorizontalAlignment="Center" />
                                        <TextBlock
                                            Text="Confirmed team lineups will be announced approximately 45-60 minutes before kickoff."
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            HorizontalAlignment="Center"
                                            TextWrapping="Wrap"
                                            TextAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
