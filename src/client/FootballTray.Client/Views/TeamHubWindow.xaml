<Window
    x:Class="FootballTray.Client.Views.TeamHubWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:FootballTray.Client.ViewModels"
    mc:Ignorable="d"
    Title="Team Hub">

    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="20">
        <Grid.RowDefinitions>
            <!-- Row 0: Header Card -->
            <RowDefinition Height="Auto" />
            <!-- Row 1: Subtabs Bar -->
            <RowDefinition Height="Auto" />
            <!-- Row 2: Content Area (Fixtures / Table / Squad / Loading / Error) -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ROW 0: TEAM HEADER CARD -->
        <Border
            Grid.Row="0"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="16"
            Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Column 0: Team Crest -->
                <Grid Grid.Column="0" Width="64" Height="64" Margin="0,0,16,0" VerticalAlignment="Center">
                    <Border CornerRadius="8" Background="#1E293B">
                        <Image
                            Source="{Binding TeamLogoSource}"
                            Width="54"
                            Height="54"
                            Stretch="Uniform"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Border>
                </Grid>

                <!-- Column 1: Team Name, League, Country, Stadium & Coach, Form Badges -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="5">
                    <!-- Row A: Team Name + Primary League Pill -->
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <TextBlock
                            Text="{Binding TeamName}"
                            FontSize="22"
                            FontWeight="Bold"
                            VerticalAlignment="Center" />

                        <!-- League Chip -->
                        <Button
                            x:Name="LeagueBadgeButton"
                            Visibility="{Binding HasPrimaryLeagueVisibility}"
                            Click="OnPrimaryLeagueClicked"
                            Style="{ThemeResource SubtleButtonStyle}"
                            Padding="6,2"
                            CornerRadius="6"
                            VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Image
                                    Source="{Binding PrimaryLeagueLogoSource}"
                                    Width="16"
                                    Height="16"
                                    Stretch="Uniform"
                                    Visibility="{Binding HasPrimaryLeagueLogoVisibility}"
                                    VerticalAlignment="Center" />
                                <TextBlock
                                    Text="{Binding PrimaryLeagueName}"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="#38BDF8"
                                    VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Country Pill -->
                        <Border
                            Background="#1E293B"
                            BorderBrush="#334155"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="6,2"
                            VerticalAlignment="Center">
                            <TextBlock
                                Text="{Binding CountryText}"
                                FontSize="10"
                                FontWeight="Bold"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Border>
                    </StackPanel>

                    <!-- Row B: Stadium & Coach -->
                    <TextBlock
                        Text="{Binding SubtitleText}"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Visibility="{Binding HasSubtitleVisibility}" />

                    <!-- Row C: Recent Form Badges -->
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,2,0,0">
                        <TextBlock
                            Text="Recent Form:"
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            VerticalAlignment="Center" />
                        <ItemsControl ItemsSource="{Binding RecentFormBadges}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="4" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Width="18"
                                        Height="18"
                                        CornerRadius="3"
                                        Background="{Binding BackgroundBrush}"
                                        ToolTipService.ToolTip="{Binding TooltipText}">
                                        <TextBlock
                                            Text="{Binding Text}"
                                            Foreground="{Binding ForegroundBrush}"
                                            FontSize="10"
                                            FontWeight="Bold"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>

                <!-- Column 2: Follow Club & Alerts Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                    <Button
                        x:Name="AlertsButton"
                        Click="OnAlertsClicked"
                        Padding="10,6"
                        CornerRadius="6"
                        Style="{ThemeResource DefaultButtonStyle}"
                        ToolTipService.ToolTip="Configure alert profile for this club">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="🔔" FontSize="13" />
                            <TextBlock Text="Alerts" FontSize="12" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="FollowButton"
                        Click="OnToggleFollowClicked"
                        Padding="14,6"
                        CornerRadius="6"
                        Style="{ThemeResource DefaultButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <FontIcon
                                Glyph="{Binding FollowIconGlyph}"
                                FontSize="13"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock
                                Text="{Binding FollowButtonText}"
                                FontSize="12"
                                FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ROW 1: SUB-TABS NAVIGATION BAR -->
        <Border
            Grid.Row="1"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="4"
            Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button
                    x:Name="FixturesTabButton"
                    Grid.Column="0"
                    Content="📅 Fixtures &amp; Results"
                    HorizontalAlignment="Stretch"
                    Click="OnFixturesTabClicked"
                    Padding="10,6"
                    CornerRadius="6"
                    FontSize="12"
                    FontWeight="SemiBold" />

                <Button
                    x:Name="StandingsTabButton"
                    Grid.Column="1"
                    Content="📊 League Table"
                    HorizontalAlignment="Stretch"
                    Click="OnStandingsTabClicked"
                    Padding="10,6"
                    CornerRadius="6"
                    FontSize="12"
                    FontWeight="SemiBold" />

                <Button
                    x:Name="SquadTabButton"
                    Grid.Column="2"
                    Content="👟 Squad &amp; Leaders"
                    HorizontalAlignment="Stretch"
                    Click="OnSquadTabClicked"
                    Padding="10,6"
                    CornerRadius="6"
                    FontSize="12"
                    FontWeight="SemiBold" />
            </Grid>
        </Border>

        <!-- ROW 2: CONTENT AREA -->
        <Grid Grid.Row="2">
            <!-- Loading Indicator -->
            <StackPanel
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Spacing="12"
                Visibility="{Binding LoadingVisibility}">
                <ProgressRing IsActive="True" Width="40" Height="40" />
                <TextBlock
                    Text="Loading Team Hub telemetry..."
                    FontSize="13"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- Error State -->
            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="#EF4444"
                BorderThickness="1"
                CornerRadius="8"
                Padding="24"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                MaxWidth="450"
                Visibility="{Binding ErrorVisibility}">
                <StackPanel Spacing="10" HorizontalAlignment="Center">
                    <TextBlock Text="⚠️" FontSize="32" HorizontalAlignment="Center" />
                    <TextBlock Text="Failed to Load Team Data" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" />
                    <Button Content="Retry" Click="OnRetryClicked" HorizontalAlignment="Center" Margin="0,6,0,0" Style="{ThemeResource AccentButtonStyle}" />
                </StackPanel>
            </Border>

            <!-- SUB-TAB 0: FIXTURES & RESULTS -->
            <ScrollViewer
                x:Name="FixturesContainer"
                VerticalScrollBarVisibility="Auto"
                Visibility="{Binding FixturesSubTabVisibility}">
                <Grid ColumnSpacing="16" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Left Card: Upcoming Fixtures -->
                    <Border
                        Grid.Column="0"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBlock Text="📅" FontSize="14" VerticalAlignment="Center" />
                                <TextBlock Text="Upcoming Fixtures" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" />
                            </StackPanel>

                            <ItemsControl ItemsSource="{Binding UpcomingFixtures}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            HorizontalAlignment="Stretch"
                                            Background="{Binding RowBackgroundBrush}"
                                            BorderBrush="{Binding RowBorderBrush}"
                                            BorderThickness="{Binding RowBorderThickness}"
                                            Padding="8,6"
                                            Margin="0,0,0,4"
                                            CornerRadius="6"
                                            Tag="{Binding}"
                                            Tapped="OnFixtureCardTapped">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="65" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Round/Tournament Badge -->
                                                <Button
                                                    Grid.Column="0"
                                                    Style="{ThemeResource SubtleButtonStyle}"
                                                    Padding="0"
                                                    MinHeight="0"
                                                    MinWidth="0"
                                                    Tag="{Binding}"
                                                    Click="OnFixtureCompetitionClicked"
                                                    ToolTipService.ToolTip="Open Standings &amp; Leaders"
                                                    VerticalAlignment="Center">
                                                    <Border
                                                        Background="#1E293B"
                                                        BorderBrush="#334155"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        Padding="4,2">
                                                        <TextBlock
                                                            Text="{Binding RoundName}"
                                                            FontSize="9"
                                                            FontWeight="SemiBold"
                                                            Foreground="#94A3B8"
                                                            TextTrimming="CharacterEllipsis"
                                                            HorizontalAlignment="Center" />
                                                    </Border>
                                                </Button>

                                                <!-- Home Team -->
                                                <Button
                                                    Grid.Column="1"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Padding="0"
                                                    Tag="{Binding}"
                                                    Click="OnFixtureHomeTeamClicked"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    ToolTipService.ToolTip="Open Team Hub">
                                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                        <TextBlock
                                                            Text="{Binding HomeTeamName}"
                                                            FontSize="11"
                                                            FontWeight="SemiBold"
                                                            Foreground="{Binding HomeTeamForegroundBrush}"
                                                            TextTrimming="CharacterEllipsis"
                                                            VerticalAlignment="Center" />
                                                        <Border Width="16" Height="16" VerticalAlignment="Center">
                                                            <Image Source="{Binding HomeTeamLogo}" Width="16" Height="16" Stretch="Uniform" />
                                                        </Border>
                                                    </StackPanel>
                                                </Button>

                                                <!-- Score / Time Display -->
                                                <Button
                                                    Grid.Column="2"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Padding="0"
                                                    Tag="{Binding}"
                                                    Click="OnFixtureItemClicked"
                                                    VerticalAlignment="Center"
                                                    ToolTipService.ToolTip="Open Match Center">
                                                    <Border
                                                        Background="#0F172A"
                                                        BorderBrush="#1E293B"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        Padding="6,2"
                                                        MinWidth="60"
                                                        VerticalAlignment="Center">
                                                        <TextBlock
                                                            Text="{Binding ScoreOrTimeDisplay}"
                                                            FontSize="10"
                                                            FontWeight="Bold"
                                                            Foreground="#38BDF8"
                                                            HorizontalAlignment="Center" />
                                                    </Border>
                                                </Button>

                                                <!-- Away Team -->
                                                <Button
                                                    Grid.Column="3"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Padding="0"
                                                    Tag="{Binding}"
                                                    Click="OnFixtureAwayTeamClicked"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    ToolTipService.ToolTip="Open Team Hub">
                                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                        <Border Width="16" Height="16" VerticalAlignment="Center">
                                                            <Image Source="{Binding AwayTeamLogo}" Width="16" Height="16" Stretch="Uniform" />
                                                        </Border>
                                                        <TextBlock
                                                            Text="{Binding AwayTeamName}"
                                                            FontSize="11"
                                                            FontWeight="SemiBold"
                                                            Foreground="{Binding AwayTeamForegroundBrush}"
                                                            TextTrimming="CharacterEllipsis"
                                                            VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Right Card: Recent Results -->
                    <Border
                        Grid.Column="1"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBlock Text="⏱️" FontSize="14" VerticalAlignment="Center" />
                                <TextBlock Text="Recent Results" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" />
                            </StackPanel>

                            <ItemsControl ItemsSource="{Binding RecentResults}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            Background="{Binding RowBackgroundBrush}"
                                            BorderBrush="{Binding RowBorderBrush}"
                                            BorderThickness="{Binding RowBorderThickness}"
                                            Padding="8,6"
                                            Margin="0,0,0,4"
                                            CornerRadius="6"
                                            Tag="{Binding}"
                                            Tapped="OnFixtureCardTapped">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="65" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Round/Tournament Badge -->
                                                <Button
                                                    Grid.Column="0"
                                                    Style="{ThemeResource SubtleButtonStyle}"
                                                    Padding="0"
                                                    MinHeight="0"
                                                    MinWidth="0"
                                                    Tag="{Binding}"
                                                    Click="OnFixtureCompetitionClicked"
                                                    ToolTipService.ToolTip="Open Standings &amp; Leaders"
                                                    VerticalAlignment="Center">
                                                    <Border
                                                        Background="#1E293B"
                                                        BorderBrush="#334155"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        Padding="4,2">
                                                        <TextBlock
                                                            Text="{Binding RoundName}"
                                                            FontSize="9"
                                                            FontWeight="SemiBold"
                                                            Foreground="#94A3B8"
                                                            TextTrimming="CharacterEllipsis"
                                                            HorizontalAlignment="Center" />
                                                    </Border>
                                                </Button>

                                                <!-- Home Team -->
                                                <Button
                                                    Grid.Column="1"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Padding="0"
                                                    Tag="{Binding}"
                                                    Click="OnFixtureHomeTeamClicked"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    ToolTipService.ToolTip="Open Team Hub">
                                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                        <TextBlock
                                                            Text="{Binding HomeTeamName}"
                                                            FontSize="11"
                                                            FontWeight="SemiBold"
                                                            Foreground="{Binding HomeTeamForegroundBrush}"
                                                            TextTrimming="CharacterEllipsis"
                                                            VerticalAlignment="Center" />
                                                        <Border Width="16" Height="16" VerticalAlignment="Center">
                                                            <Image Source="{Binding HomeTeamLogo}" Width="16" Height="16" Stretch="Uniform" />
                                                        </Border>
                                                    </StackPanel>
                                                </Button>

                                                <!-- Score Display -->
                                                <Button
                                                    Grid.Column="2"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Padding="0"
                                                    Tag="{Binding}"
                                                    Click="OnFixtureItemClicked"
                                                    VerticalAlignment="Center"
                                                    ToolTipService.ToolTip="Open Match Center">
                                                    <Border
                                                        Background="#0F172A"
                                                        BorderBrush="#1E293B"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        Padding="6,2"
                                                        MinWidth="55"
                                                        VerticalAlignment="Center">
                                                        <TextBlock
                                                            Text="{Binding ScoreOrTimeDisplay}"
                                                            FontSize="10"
                                                            FontWeight="Bold"
                                                            Foreground="#F8FAFC"
                                                            HorizontalAlignment="Center" />
                                                    </Border>
                                                </Button>

                                                <!-- Away Team -->
                                                <Button
                                                    Grid.Column="3"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Padding="0"
                                                    Tag="{Binding}"
                                                    Click="OnFixtureAwayTeamClicked"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    ToolTipService.ToolTip="Open Team Hub">
                                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                        <Border Width="16" Height="16" VerticalAlignment="Center">
                                                            <Image Source="{Binding AwayTeamLogo}" Width="16" Height="16" Stretch="Uniform" />
                                                        </Border>
                                                        <TextBlock
                                                            Text="{Binding AwayTeamName}"
                                                            FontSize="11"
                                                            FontWeight="SemiBold"
                                                            Foreground="{Binding AwayTeamForegroundBrush}"
                                                            TextTrimming="CharacterEllipsis"
                                                            VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>

            <!-- SUB-TAB 1: LEAGUE TABLE -->
            <ScrollViewer
                x:Name="StandingsContainer"
                VerticalScrollBarVisibility="Auto"
                Visibility="{Binding StandingsSubTabVisibility}">
                <Border
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14"
                    Margin="0,0,0,10">
                    <StackPanel Spacing="8">
                        <!-- Header -->
                        <Grid Padding="8,4" Background="#0F172A" CornerRadius="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="32" />
                                <ColumnDefinition Width="30" />
                                <ColumnDefinition Width="30" />
                                <ColumnDefinition Width="30" />
                                <ColumnDefinition Width="38" />
                                <ColumnDefinition Width="38" />
                                <ColumnDefinition Width="105" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="#" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="CLUB" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" Margin="6,0,0,0" />
                            <TextBlock Grid.Column="2" Text="PL" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="W" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="4" Text="D" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="5" Text="L" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="6" Text="GD" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="7" Text="PTS" FontSize="10" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="8" Text="FORM" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" HorizontalAlignment="Center" />
                        </Grid>

                        <!-- Standings List -->
                        <ItemsControl ItemsSource="{Binding Standings}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Background="{Binding RowBackgroundBrush}"
                                        BorderBrush="{Binding RowBorderBrush}"
                                        BorderThickness="{Binding RowBorderThickness}"
                                        CornerRadius="6"
                                        Padding="8,5"
                                        Margin="0,1">
                                        <Grid ColumnSpacing="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="32" />
                                                <ColumnDefinition Width="30" />
                                                <ColumnDefinition Width="30" />
                                                <ColumnDefinition Width="30" />
                                                <ColumnDefinition Width="38" />
                                                <ColumnDefinition Width="38" />
                                                <ColumnDefinition Width="105" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Rank -->
                                            <TextBlock Grid.Column="0" Text="{Binding Rank}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />

                                            <!-- Club Crest + Name (Clickable) -->
                                            <Button
                                                Grid.Column="1"
                                                Click="OnStandingClubClicked"
                                                Tag="{Binding TeamId}"
                                                Style="{ThemeResource SubtleButtonStyle}"
                                                Padding="4,2"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <Border Width="18" Height="18" Visibility="{Binding LogoVisibility}" VerticalAlignment="Center">
                                                        <Image Source="{Binding TeamLogoSource}" Width="18" Height="18" Stretch="Uniform" />
                                                    </Border>
                                                    <TextBlock Text="{Binding DisplayName}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                    <TextBlock Text="⭐" FontSize="10" Visibility="{Binding FollowedStarVisibility}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>

                                            <!-- P, W, D, L -->
                                            <TextBlock Grid.Column="2" Text="{Binding Played}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="{Binding Wins}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="4" Text="{Binding Draws}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="5" Text="{Binding Losses}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />

                                            <!-- GD -->
                                            <TextBlock Grid.Column="6" Text="{Binding GoalDiffDisplay}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />

                                            <!-- PTS -->
                                            <TextBlock Grid.Column="7" Text="{Binding Points}" FontSize="12" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Center" VerticalAlignment="Center" />

                                            <!-- Form Badges -->
                                            <ItemsControl Grid.Column="8" ItemsSource="{Binding FormBadges}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" Spacing="3" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Width="16" Height="16" CornerRadius="3" Background="{Binding BackgroundBrush}" ToolTipService.ToolTip="{Binding TooltipText}">
                                                            <TextBlock Text="{Binding Text}" Foreground="{Binding ForegroundBrush}" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </ScrollViewer>

            <!-- SUB-TAB 2: SQUAD & LEADERS -->
            <ScrollViewer
                x:Name="SquadContainer"
                VerticalScrollBarVisibility="Auto"
                Visibility="{Binding SquadSubTabVisibility}">
                <StackPanel Spacing="16" Margin="0,0,0,10">
                    <!-- Season Leaders Cards Row -->
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Top Scorer -->
                        <Border
                            Grid.Column="0"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12">
                            <StackPanel Spacing="4">
                                <TextBlock Text="🥅 TOP SCORER" FontSize="10" FontWeight="Bold" Foreground="#38BDF8" CharacterSpacing="40" />
                                <TextBlock Text="{Binding TopScorerName}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding TopScorerStat}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Border>

                        <!-- Top Assister -->
                        <Border
                            Grid.Column="1"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12">
                            <StackPanel Spacing="4">
                                <TextBlock Text="🎯 TOP ASSISTS" FontSize="10" FontWeight="Bold" Foreground="#38BDF8" CharacterSpacing="40" />
                                <TextBlock Text="{Binding TopAssisterName}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding TopAssisterStat}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Border>

                        <!-- Highest Rated -->
                        <Border
                            Grid.Column="2"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12">
                            <StackPanel Spacing="4">
                                <TextBlock Text="⭐ HIGHEST RATED" FontSize="10" FontWeight="Bold" Foreground="#38BDF8" CharacterSpacing="40" />
                                <TextBlock Text="{Binding TopRatedName}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding TopRatedStat}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Squad Sections -->
                    <!-- Goalkeepers -->
                    <Border
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14">
                        <StackPanel Spacing="10">
                            <TextBlock Text="🧤 GOALKEEPERS" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" CharacterSpacing="50" />
                            <ItemsControl ItemsSource="{Binding Goalkeepers}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="6,4" Margin="0,1" Background="#0F172A" CornerRadius="4" ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding ShirtNumberDisplay}" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding StatsSummary}" FontSize="11" Foreground="#94A3B8" Visibility="{Binding StatsVisibility}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                            <Border Grid.Column="3" Background="{Binding RatingBackgroundBrush}" CornerRadius="4" Padding="6,1" Visibility="{Binding RatingVisibility}" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding RatingDisplay}" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" />
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Defenders -->
                    <Border
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14">
                        <StackPanel Spacing="10">
                            <TextBlock Text="🛡️ DEFENDERS" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" CharacterSpacing="50" />
                            <ItemsControl ItemsSource="{Binding Defenders}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="6,4" Margin="0,1" Background="#0F172A" CornerRadius="4" ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding ShirtNumberDisplay}" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding StatsSummary}" FontSize="11" Foreground="#94A3B8" Visibility="{Binding StatsVisibility}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                            <Border Grid.Column="3" Background="{Binding RatingBackgroundBrush}" CornerRadius="4" Padding="6,1" Visibility="{Binding RatingVisibility}" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding RatingDisplay}" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" />
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Midfielders -->
                    <Border
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14">
                        <StackPanel Spacing="10">
                            <TextBlock Text="⚙️ MIDFIELDERS" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" CharacterSpacing="50" />
                            <ItemsControl ItemsSource="{Binding Midfielders}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="6,4" Margin="0,1" Background="#0F172A" CornerRadius="4" ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding ShirtNumberDisplay}" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding StatsSummary}" FontSize="11" Foreground="#94A3B8" Visibility="{Binding StatsVisibility}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                            <Border Grid.Column="3" Background="{Binding RatingBackgroundBrush}" CornerRadius="4" Padding="6,1" Visibility="{Binding RatingVisibility}" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding RatingDisplay}" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" />
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Forwards -->
                    <Border
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14">
                        <StackPanel Spacing="10">
                            <TextBlock Text="⚡ FORWARDS" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" CharacterSpacing="50" />
                            <ItemsControl ItemsSource="{Binding Forwards}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="6,4" Margin="0,1" Background="#0F172A" CornerRadius="4" ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding ShirtNumberDisplay}" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding StatsSummary}" FontSize="11" Foreground="#94A3B8" Visibility="{Binding StatsVisibility}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                            <Border Grid.Column="3" Background="{Binding RatingBackgroundBrush}" CornerRadius="4" Padding="6,1" Visibility="{Binding RatingVisibility}" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding RatingDisplay}" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" />
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
