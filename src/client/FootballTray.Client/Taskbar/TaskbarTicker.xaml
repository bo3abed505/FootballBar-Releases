<UserControl
    x:Class="FootballTray.Client.Taskbar.TaskbarTicker"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:FootballTray.Client.Taskbar"
    mc:Ignorable="d">

    <Border
        x:Name="RootBorder"
        Background="{ThemeResource LayerFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="6"
        Padding="6,2,6,2"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        PointerEntered="RootBorder_PointerEntered"
        PointerExited="RootBorder_PointerExited"
        PointerPressed="RootBorder_PointerPressed"
        PointerMoved="RootBorder_PointerMoved"
        PointerReleased="RootBorder_PointerReleased"
        PointerWheelChanged="RootBorder_PointerWheelChanged"
        Tapped="RootBorder_Tapped"
        DoubleTapped="RootBorder_DoubleTapped">

        <Border.ContextFlyout>
            <MenuFlyout x:Name="TickerContextMenu">
                <MenuFlyoutItem
                    x:Name="MenuOpenMatchCenter"
                    Text="Open Match Center"
                    Click="OnOpenMatchCenterClicked" />
                <MenuFlyoutItem
                    x:Name="MenuPinMatch"
                    Text="📌 Pin Match"
                    Click="OnPinMatchClicked" />
                <MenuFlyoutItem
                    x:Name="MenuUnpinMatch"
                    Text="📌 Unpin Match"
                    Click="OnUnpinMatchClicked" />
                <ToggleMenuFlyoutItem x:Name="MenuAutoRotateToggle" Text="🔄 Auto-Rotate Ticker" Click="MenuAutoRotateToggle_Click" />
                <MenuFlyoutSeparator />
                <ToggleMenuFlyoutItem x:Name="MenuModeFollowedLive" Text="⭐ Auto-Rotate Mode: Followed Live" Click="OnAutoRotateModeSelected" Tag="FollowedLive" />
                <ToggleMenuFlyoutItem x:Name="MenuModeAllFollowed" Text="📅 Auto-Rotate Mode: All Followed" Click="OnAutoRotateModeSelected" Tag="AllFollowed" />
                <ToggleMenuFlyoutItem x:Name="MenuModeAllLive" Text="🔴 Auto-Rotate Mode: All Live" Click="OnAutoRotateModeSelected" Tag="AllLive" />
                <ToggleMenuFlyoutItem x:Name="MenuModeCustomQueue" Text="📋 Auto-Rotate Mode: Custom Queue" Click="OnAutoRotateModeSelected" Tag="CustomQueue" />
                <MenuFlyoutItem
                    x:Name="MenuTogglePin"
                    Text="Toggle Pin"
                    Visibility="Collapsed"
                    Click="OnTogglePinClicked" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem
                    x:Name="MenuHideTicker"
                    Text="Hide Ticker"
                    Click="MenuHideTicker_Click" />
                <MenuFlyoutItem
                    x:Name="MenuResetPosition"
                    Text="Reset Position"
                    Click="MenuResetPosition_Click" />
                <MenuFlyoutItem
                    x:Name="MenuManualPosition"
                    Text="Manual Position"
                    Click="MenuManualPosition_Click" />
                <MenuFlyoutSeparator x:Name="MenuDisplaySeparator" />
                <MenuFlyoutSeparator />
                <ToggleMenuFlyoutItem
                    x:Name="MenuMuteToggle"
                    Text="Mute Sounds"
                    Click="MenuMuteToggle_Click" />
                <MenuFlyoutItem
                    x:Name="MenuOpenApp"
                    Text="Open FootballBar"
                    Click="OnOpenAppClicked" />
                <MenuFlyoutItem
                    x:Name="MenuExit"
                    Text="Exit"
                    Click="OnExitClicked" />
            </MenuFlyout>
        </Border.ContextFlyout>

        <ToolTipService.ToolTip>
            <ToolTip
                x:Name="TickerHoverToolTip"
                Placement="Top"
                local:TaskbarTicker.ShowDuration="30000"
                Background="Transparent"
                BorderThickness="0"
                Padding="0">
                <Border
                    Background="#F01E1E1E"
                    BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12,10"
                    MaxWidth="320">
                    <StackPanel Spacing="6">
                        <!-- Header: Competition & Status -->
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock
                                x:Name="FlyoutCompetitionText"
                                Text="FootballBar"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Grid.Column="1"
                                x:Name="FlyoutStatusText"
                                Text=""
                                FontSize="11"
                                FontWeight="Bold"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>

                        <!-- Teams & Score -->
                        <Grid ColumnDefinitions="*,Auto,*" VerticalAlignment="Center">
                            <TextBlock
                                x:Name="FlyoutHomeTeamText"
                                Text="Home"
                                FontSize="13"
                                FontWeight="SemiBold"
                                TextAlignment="Right"
                                TextTrimming="CharacterEllipsis"
                                Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            <TextBlock
                                Grid.Column="1"
                                x:Name="FlyoutScoreText"
                                Text="vs"
                                FontSize="13"
                                FontWeight="Bold"
                                Margin="8,0"
                                Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            <TextBlock
                                Grid.Column="2"
                                x:Name="FlyoutAwayTeamText"
                                Text="Away"
                                FontSize="13"
                                FontWeight="SemiBold"
                                TextAlignment="Left"
                                TextTrimming="CharacterEllipsis"
                                Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        </Grid>

                        <!-- Team-Divided Match Incidents (Multi-column Grid) -->
                        <StackPanel x:Name="FlyoutEventsPanel" Spacing="4" Visibility="Collapsed">
                            <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,2,0,4" />
                            <Grid ColumnDefinitions="*,12,*">
                                <!-- Home Team Incidents (Column 0, right-aligned) -->
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock
                                        x:Name="FlyoutHomeEventsHeader"
                                        Text="Home"
                                        FontSize="10"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        TextAlignment="Right"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        x:Name="FlyoutHomeEventsText"
                                        Text=""
                                        FontSize="11"
                                        TextWrapping="Wrap"
                                        TextAlignment="Right"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>

                                <!-- Divider (Column 1) -->
                                <Border Grid.Column="1" Width="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" VerticalAlignment="Stretch" HorizontalAlignment="Center" />

                                <!-- Away Team Incidents (Column 2, left-aligned) -->
                                <StackPanel Grid.Column="2" Spacing="2">
                                    <TextBlock
                                        x:Name="FlyoutAwayEventsHeader"
                                        Text="Away"
                                        FontSize="10"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        TextAlignment="Left"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        x:Name="FlyoutAwayEventsText"
                                        Text=""
                                        FontSize="11"
                                        TextWrapping="Wrap"
                                        TextAlignment="Left"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Grid>
                            <TextBlock x:Name="FlyoutGoalscorersText" Text="" Visibility="Collapsed" />
                        </StackPanel>

                        <!-- Pin Hint -->
                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,2,0,2" />
                        <TextBlock
                            x:Name="FlyoutPinHintText"
                            Text="Right-click to pin match or open details"
                            FontSize="10"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </Border>
            </ToolTip>
        </ToolTipService.ToolTip>

        <StackPanel
            x:Name="TickerContentPanel"
            Orientation="Horizontal"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="5">

            <!-- Fallback Panel when no active match is available -->
            <StackPanel
                x:Name="FallbackPanel"
                Orientation="Horizontal"
                Spacing="5"
                VerticalAlignment="Center"
                Visibility="Visible">
                <Image
                    x:Name="FallbackLogo"
                    Width="14"
                    Height="14"
                    VerticalAlignment="Center"
                    Stretch="Uniform" />
                <TextBlock
                    x:Name="FallbackText"
                    Text="FootballBar"
                    FontSize="12"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
            </StackPanel>

            <!-- Explicit Ticker Elements: [HomeCrest] [HomeTeamName] [HomeRedCard] [Score] [AwayRedCard] [AwayTeamName] [AwayCrest] [StatusText] -->
            <Image
                x:Name="HomeCrest"
                Width="16"
                Height="16"
                VerticalAlignment="Center"
                Stretch="Uniform"
                Visibility="Collapsed" />

            <TextBlock
                x:Name="HomeTeamName"
                Text=""
                FontSize="12"
                FontWeight="SemiBold"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                Visibility="Collapsed" />

            <Border
                x:Name="HomeRedCard"
                Background="#D32F2F"
                CornerRadius="2"
                MinWidth="8"
                Height="11"
                Padding="1,0"
                VerticalAlignment="Center"
                Visibility="Collapsed">
                <TextBlock
                    x:Name="HomeRedCardText"
                    Text=""
                    FontSize="8"
                    FontWeight="Bold"
                    Foreground="White"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" />
            </Border>

            <TextBlock
                x:Name="Score"
                Text=""
                FontSize="12"
                FontWeight="Bold"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                Visibility="Collapsed" />

            <Border
                x:Name="AwayRedCard"
                Background="#D32F2F"
                CornerRadius="2"
                MinWidth="8"
                Height="11"
                Padding="1,0"
                VerticalAlignment="Center"
                Visibility="Collapsed">
                <TextBlock
                    x:Name="AwayRedCardText"
                    Text=""
                    FontSize="8"
                    FontWeight="Bold"
                    Foreground="White"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" />
            </Border>

            <TextBlock
                x:Name="AwayTeamName"
                Text=""
                FontSize="12"
                FontWeight="SemiBold"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                Visibility="Collapsed" />

            <Image
                x:Name="AwayCrest"
                Width="16"
                Height="16"
                VerticalAlignment="Center"
                Stretch="Uniform"
                Visibility="Collapsed" />

            <TextBlock
                x:Name="StatusText"
                Text=""
                FontSize="11"
                FontWeight="Normal"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Visibility="Collapsed" />
        </StackPanel>
    </Border>
</UserControl>
